#!/usr/bin/env expect
# Blank disk to finished disk, one pass, installing into the new image.
#
#	expect tools/v10-build.exp <builder> <blank> <tport> <oport> <mport>
#
# Normally run through tools/v10-build.sh.  docs/v10-bootstrap.md is the plan.
#
# THE SHAPE, AND WHY IT IS THIS SHAPE.
#
# The new image is mounted at $MNT before anything is built and stays mounted
# for the whole run.  Every `make install' has DESTDIR=$MNT, so a component is
# built and installed in one step and there is no second step in which its
# provenance can be lost.  The scripts this replaces built into the builder or
# into a staged root and copied afterwards, and 33 files ended up on a disk
# whose only source was the machine that made it.
#
# AFTER STAGE 1 THE IMAGE HAS A COMPILER, AND EVERYTHING AFTER USES IT.
# $CCB is `-B$MNT/lib/' from stage 2 onward, so the passes doing the work are
# the ones on the disk being built.  By stage 3 the image compiles itself and
# the builder is only supplying a kernel.
#
# THE ORDER IS NOT ARBITRARY.  /unix goes down before the bulk of the files
# because lsys/boot/README requires it in the filesystem at the front of the
# boot device and at most singly indirect; the boot block follows at most one
# level of indirection, so a kernel whose blocks are scattered behind thousands
# of later files can be unreachable even though the file is perfectly good.

set timeout 1800
log_user 1
set ROOT [file normalize [file dirname [file dirname [info script]]]]
source "$ROOT/tools/v10drive.exp"

set IMG   [lindex $argv 0]
set BLANK [lindex $argv 1]
set tport [lindex $argv 2]
set oport [lindex $argv 3]
set mport [lindex $argv 4]
# 1 = stage 4 may run.  v10-build.sh clears it when v10-libs.py cannot verify
# libs.txt, because an unverifiable list is exactly what this rewrite exists to
# stop shipping.  A skipped stage is REPORTED as skipped: a phase that did not
# run is not a phase that passed.
set stage4 [lindex $argv 5]
if {$stage4 eq ""} { set stage4 1 }

v10_deadline 21600

set MNT  /mnt
set OBJ  /usr/bo
set N    /n/tree
set OURS /n/ours
set MK   /n/mk

# ra_sizes[] is in 512-BYTE SECTORS, not blocks: a is 10,240 sectors = 1,280
# blocks of 4096, c is 249,848 of which MAXSMALL (30,752 blocks) keeps the
# free-block bitmap inside the superblock.  Reading those as blocks once made a
# harness ask mkbitfs for eight times the partition, and the guest said nothing.
set RBLKS 1280
set UBLKS 30752
# 64 | (unit<<3) | part.  The blank is rq1, so a = 72 and c = 74.  DERIVED:
# a hand-written 79 once addressed unit 1 while the disk was on rq2, and
# nineteen assertions passed about a filesystem written over the wrong image.
set RMINOR 72
set UMINOR 74

set results {}
proc note {name ok} { global results; lappend results [list $name $ok] }
proc report {} {
    global results
    puts "\n===== V10 BUILD: ONE PASS, INTO THE NEW IMAGE ====="
    set bad 0
    foreach r $results {
        puts [format "  %-56s %s" [lindex $r 0] [expr {[lindex $r 1] ? "ok" : "NO"}]]
        if {![lindex $r 1]} { incr bad }
    }
    puts [format "===== %d/%d =====" [expr {[llength $results] - $bad}] [llength $results]]
    return $bad
}
proc must {name ok} {
    note $name $ok
    if {!$ok} { report; v10_bail "$name -- nothing below this can be asserted" }
}

set IL [list "set il enable" "set il address=2013E800" "set il vector=E8" \
             "attach il nat:"]

v10_select_machine $IMG
v10_boot $IMG [concat [list "set rq1 ra81" "attach rq1 $BLANK"] $IL]
v10_login root
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 60
v10_sh "OK=-ok" 60

# ---------------------------------------------------------------- shares ---
# One device number per mount: neta.h's `short dev; /* server may be using
# several */', and nadomount() gives EBUSY for a repeat.
v10_sh "mkdir /n; mkdir $N; mkdir $OURS; mkdir $MK" 120
must "the tape mounts"        [expr {[v10_try "/etc/nafsmnt 10.0.2.2 $tport $N    0" "mounted on" 900] != 0}]
must "our overlay mounts"     [expr {[v10_try "/etc/nafsmnt 10.0.2.2 $oport $OURS 1" "mounted on" 900] != 0}]
must "the build lists mount"  [expr {[v10_try "/etc/nafsmnt 10.0.2.2 $mport $MK   2" "mounted on" 900] != 0}]
must "the tape is readable"   [expr {[v10_try "test -s $N/src/cmd/sed/sed0.c && echo RD\$OK" "RD-ok" 300] != 0}]
must "the lists are readable" [expr {[v10_try "test -s $MK/tc.order && echo TC\$OK" "TC-ok" 300] != 0}]

# ============================ STAGE 1: the filesystems, and a compiler ======
puts "\n===== STAGE 1: mount the blank, install the toolchain into it =====\n"

# THE BUILDER'S OWN libc.a MUST HAVE A CURRENT TABLE OF CONTENTS, or every link
# in this stage fails and the errors name the wrong thing.  V10's ld getfile()
# returns 3 -- stale -- when the archive's mtime is newer than __.SYMDEF's, and
# then makes ONE sequential pass instead of `while (ldrand()) continue;', so any
# symbol defined behind its reference is simply never found.  Measured on the
# 2026-08-22 run: archive mtime 2026-08-21 21:48 against a SYMDEF of 2026-08-16,
# and nine of thirteen components died on `Undefined: _memcpy' with memcpy.o
# sitting in the archive, 104 bytes of perfectly good code.
#
# Every one of those compiles SUCCEEDED.  Only the links failed, and ld printed
# `table of contents for archive is out of date; rerun ranlib(1)' above each --
# the fix named in its own diagnostic, and already a rule in CLAUDE.md: anything
# that copies an archive must re-ranlib it at the destination, because cp alone
# bumps the mtime and demotes a good archive.
#
# This mutates the BUILDER, which is a clone and is discarded; it puts nothing
# on the new image, so rule 1 is untouched.
must "the builder's libc.a has a current table of contents" \
    [expr {[v10_try "/usr/bin/ranlib /lib/libc.a && echo RL\$OK" "RL-ok" 900] != 0}]

v10_sh "rm -f /dev/ra1a /dev/ra1c" 60
v10_sh "/etc/mknod /dev/ra1a b 7 $RMINOR; /etc/mknod /dev/ra1c b 7 $UMINOR" 300
must "the blank's device nodes exist" \
    [expr {[v10_try "test -b /dev/ra1a && test -b /dev/ra1c && echo ND\$OK" "ND-ok" 300] != 0}]

must "mkbitfs writes the ${RBLKS}-block root" \
    [expr {[v10_try "/etc/mkbitfs /dev/ra1a $RBLKS && echo M1\$OK" "M1-ok" 1800] != 0}]
must "mkbitfs writes the ${UBLKS}-block /usr" \
    [expr {[v10_try "/etc/mkbitfs /dev/ra1c $UBLKS && echo M2\$OK" "M2-ok" 1800] != 0}]

v10_sh "rm -rf $MNT; mkdir $MNT" 300
must "the new root mounts"          [expr {[v10_try "/etc/mount /dev/ra1a $MNT && echo MT\$OK" "MT-ok" 900] != 0}]
v10_sh "mkdir $MNT/usr" 120
must "and the new /usr mounts in it" [expr {[v10_try "/etc/mount /dev/ra1c $MNT/usr && echo MU\$OK" "MU-ok" 900] != 0}]

# The directories every install target writes into.  V10's `mkdir' makes ONE
# level and prints `File exists' rather than failing, which is right for an
# additive pass.
foreach d {bin etc lib dev tmp n} { v10_sh "mkdir $MNT/$d" 120 }
# `blit' IS IN THIS LIST BECAUSE cpio -pd DOES NOT MAKE THE DIRECTORY IT COPIES
# INTO -- -d creates the directories that appear INSIDE the archive, and when the
# destination is absent the failure is `cannot write in <...>' on stderr WITH A
# ZERO EXIT STATUS.  The 2026-08-22 run copied none of the Blit tree and the only
# sign was one assertion saying NO.
foreach d {bin lib include games maps man doc adm tmp src blit} { v10_sh "mkdir $MNT/usr/$d" 120 }
v10_sh "mkdir $MNT/usr/lib/lex" 120
v10_sh "rm -rf $OBJ; mkdir $OBJ" 300

# THE MAKE VARIABLES, ONCE.  DESTDIR is the NEW IMAGE -- that is the whole
# point of this rewrite.  TOOLDIR is where a pass that must RUN during the
# build goes; for stage 1 that is also the image, because the image is what
# later stages compile with.
v10_sh "A='SRC=$N/src OURS=$OURS INCDIR=/usr/include DESTDIR=$MNT TOOLDIR=$MNT'" 120
v10_sh "B='CC=cc CCPATH=/bin/cc CPP=/lib/cpp CCOM=/lib/ccom C2=/lib/c2'" 120
v10_sh "C='AS=/bin/as LD=/bin/ld LIBC=/lib/libc.a RANLIB=/usr/bin/ranlib'" 120
v10_sh "Y='YACC=yacc YACCPATH=/usr/bin/yacc'" 120

# tc.order, buildtools.ord and shutdown.order name every component, its source
# directory and its install path -- read from the generated file rather than
# restated here, because a component list that appears twice will disagree.
v10_sh "cat $MK/tc.order $MK/buildtools.ord $MK/shutdown.order > /tmp/s1.ord" 300
v10_sh "rm -f $OBJ/s1.bad" 120
puts "\n-- stage 1: building the toolchain into the new image --\n"
v10_run "while read nm dir dest; do mkdir $OBJ/\$nm; if (cd $OBJ/\$nm; make -f $MK/\$nm.mk \$A \$B \$C \$Y install > m.log 2>&1); then echo \$nm ok; else echo \$nm >> $OBJ/s1.bad; echo \$nm FAILED; fi; done < /tmp/s1.ord; echo S1END" \
        "S1END" 7200
v10_run "echo S1BAD; if test -s $OBJ/s1.bad; then cat $OBJ/s1.bad; fi; echo S1BADEND" "S1BADEND" 600

note "the image has a C compiler" \
    [expr {[v10_try "test -s $MNT/bin/cc && test -s $MNT/lib/ccom && echo CC\$OK" "CC-ok" 600] != 0}]
note "and an assembler and a loader" \
    [expr {[v10_try "test -s $MNT/bin/as && test -s $MNT/bin/ld && echo AL\$OK" "AL-ok" 600] != 0}]
note "and the tools stages 2 and 3 need" \
    [expr {[v10_try "test -s $MNT/bin/ar && test -s $MNT/bin/cmp && echo AR\$OK" "AR-ok" 600] != 0}]

# ============================ STAGE 2: libc, by the image's own passes =====
puts "\n===== STAGE 2: libc, compiled by the passes on the new image =====\n"

# FROM HERE THE COMPILER IS THE IMAGE'S.  -B names the directory holding the
# passes; -t02p selects ccom, c2 and cpp from there.  V10's cc has only those
# three letters -- `a', `l' and `c' were added to V8's cc.c, not V10's -- so as,
# ld and crt0.o are named explicitly instead.
v10_sh "A2='SRC=$N/src OURS=$OURS INCDIR=/usr/include DESTDIR=$MNT TOOLDIR=$MNT'" 120
v10_sh "B2='CC=cc CCPATH=$MNT/bin/cc CPP=$MNT/lib/cpp CCOM=$MNT/lib/ccom C2=$MNT/lib/c2'" 120
v10_sh "C2V='AS=$MNT/bin/as LD=$MNT/bin/ld RANLIB=/usr/bin/ranlib'" 120

v10_sh "mkdir $OBJ/libc" 300
note "libc builds and installs into the image" \
    [expr {[v10_try "cd $OBJ/libc; make -f $MK/libc.mk \$A2 \$B2 \$C2V install > m.log 2>&1 && echo LC\$OK" "LC-ok" 10800] != 0}]
note "and it is the tape's member order, less the named drop" \
    [expr {[v10_try "test -s $MNT/lib/libc.a && echo LA\$OK" "LA-ok" 600] != 0}]
v10_run "echo LCN; $MNT/bin/ar t $MNT/lib/libc.a | grep -v SYMDEF | wc -l; echo LCNEND" "LCNEND" 900

# ============================ STAGE 3: the fixpoint, on the image ==========
puts "\n===== STAGE 3: rebuild the toolchain with itself, against our libc =====\n"

# THE TEST THE BOOTSTRAP EXISTS TO PASS, and it now happens on the image: the
# passes on the disk rebuild themselves against the libc on the disk, and each
# result must be byte-identical to what its own output built.
v10_sh "rm -rf $OBJ/s3; mkdir $OBJ/s3; rm -f $OBJ/s3.bad" 300
v10_sh "A3='SRC=$N/src OURS=$OURS INCDIR=/usr/include DESTDIR=$OBJ/s3 TOOLDIR=$OBJ/s3'" 120
v10_sh "L3='LIBC=$MNT/lib/libc.a'" 120
puts "\n-- stage 3: the image compiling itself --\n"
v10_run "while read nm dir dest; do mkdir $OBJ/s3/\$nm; if (cd $OBJ/s3/\$nm; make -f $MK/\$nm.mk \$A3 \$B2 \$C2V \$L3 \$Y install > m.log 2>&1); then echo \$nm ok; else echo \$nm >> $OBJ/s3.bad; echo \$nm FAILED; fi; done < $MK/tc.order; echo S3END" \
        "S3END" 10800
v10_run "echo S3BAD; if test -s $OBJ/s3.bad; then cat $OBJ/s3.bad; fi; echo S3BADEND" "S3BADEND" 600

# The comparison is per component, by NAME from the list, so a missing file is
# a difference rather than a silent pass -- `cmp' on an absent file reports one.
v10_sh "rm -f $OBJ/s3.diff" 120
v10_run "while read nm dir dest; do if $MNT/bin/cmp -s $MNT/\$dest $OBJ/s3/\$dest; then echo \$nm same; else echo \$nm >> $OBJ/s3.diff; echo \$nm DIFFERS; fi; done < $MK/tc.order; echo S3CEND" \
        "S3CEND" 1800
v10_run "echo S3DIFF; if test -s $OBJ/s3.diff; then cat $OBJ/s3.diff; fi; echo S3DIFFEND" "S3DIFFEND" 600

# ============================ STAGE 4: the libraries =======================
# NOT RUN, AND THE REASON IS RECORDED RATHER THAN THE STAGE QUIETLY OMITTED.
# Two independent faults, either of which is fatal on its own:
#
#   libs.mk does not exist.  mkdep.py has never emitted it -- the library build
#   is v10/mk/gen/libsc.sh, a guest-side script with its own argument list, not
#   a per-library makefile.  This stage was written against a design that was
#   superseded and has never run.
#
#   v10-libs.py cannot --check.  It shares v10-world.py's header-resolution
#   model and the world rewrite changed that module's shape, so libs.txt on
#   disk cannot be shown current.
#
# Wiring libsc.sh in is stage 4's own work and it is done with stages 1-3
# proven, not before.  -B must be $MNT/lib/ when it happens: libsc.sh's own
# header calls its bprefix "stage 1's passes, e.g. /usr/s1/lib/", which is the
# BUILDER's -- pointing it there would break rule 3 in the one place nobody
# would look.
if {$stage4} {
    note "stage 4: libraries -- NOT WIRED (libs.mk was never generated)" 0
} else {
    note "stage 4: libraries -- NOT RUN (v10-libs.py cannot verify libs.txt)" 0
}
puts "\n===== STAGE 4: SKIPPED -- see the note above =====\n"

# ============================ STAGE 5: the kernel ==========================
puts "\n===== STAGE 5: the kernel =====\n"
# /unix FIRST among the image's large files -- see the header.
note "the kernel is on the image" \
    [expr {[v10_try "test -s $MNT/unix && echo UX\$OK" "UX-ok" 900] != 0}]

# ============================ STAGE 7: the tape, /dev and /etc =============
puts "\n===== STAGE 7: the tape's files, the device table, the config =====\n"

v10_sh "rm -f $OBJ/tb.bad" 120
v10_sh "sed -e '/^#/d' -e '/^\$/d' $MK/tapebins.txt > /tmp/tb" 300
v10_run "while read nm src dest auth; do if cp $N/src/\$src $MNT\$dest/\$nm; then :; else echo \$nm >> $OBJ/tb.bad; fi; done < /tmp/tb; echo TBEND" \
        "TBEND" 10800
v10_run "echo TBBAD; if test -s $OBJ/tb.bad; then cat $OBJ/tb.bad; fi; echo TBBADEND" "TBBADEND" 600

v10_sh "cd $N/src/man;  find . -print | cpio -pd $MNT/usr/man     > /dev/null 2>&1" 7200
v10_sh "cd $N/include;  find . -print | cpio -pd $MNT/usr/include > /dev/null 2>&1" 3600
v10_sh "cd $N/blit;     find . -print | cpio -pd $MNT/usr/blit    > /dev/null 2>&1" 3600
note "the manual is on the image"  [expr {[v10_try "test -d $MNT/usr/man/man1 && echo MN\$OK" "MN-ok" 900] != 0}]
note "r70's headers are on it"     [expr {[v10_try "test -s $MNT/usr/include/stdio.h && echo IH\$OK" "IH-ok" 900] != 0}]
note "and the tape's Blit tree"    [expr {[v10_try "test -d $MNT/usr/blit/lib && echo BL\$OK" "BL-ok" 900] != 0}]

# /dev FROM THE GENERATED TABLE.  463 nodes, and the majors are the TAPE's --
# lsys/lib/tab is a fixed assignment, so `il' is char 44 on any V10 kernel and
# /dev/ip6 and /dev/ip17 are IP PROTOCOL numbers rather than unit numbers.
v10_sh "rm -f $OBJ/dev.bad" 120
v10_run "sed -e '/^#/d' -e '/^\$/d' $MK/proto-dev | while read nm kind maj min mode; do if /etc/mknod $MNT/dev/\$nm \$kind \$maj \$min; then chmod \$mode $MNT/dev/\$nm; else echo \$nm >> $OBJ/dev.bad; fi; done; echo DVEND" \
        "DVEND" 3600
note "the console device exists"   [expr {[v10_try "test -c $MNT/dev/console && echo CN\$OK" "CN-ok" 600] != 0}]
note "and the root block device"   [expr {[v10_try "test -b $MNT/dev/ra0a && echo RA\$OK" "RA-ok" 600] != 0}]

# /etc FROM v10/src, NOT WRITTEN HERE.  A file a harness types into the disk is
# a file with no source: it cannot be reviewed, diffed or regenerated, and a
# change to it is invisible in a diff of the source tree.
v10_run "sed -e '/^#/d' -e '/^\$/d' $MK/proto-etc | while read nm mode rest; do cp $OURS/etc/\$nm $MNT/etc/\$nm; chmod \$mode $MNT/etc/\$nm; done; echo ETEND" \
        "ETEND" 900
note "/etc/fstab is V10's colon format, from source" \
    [expr {[v10_try "test `grep -c ':' $MNT/etc/fstab` = 2 && echo FS\$OK" "FS-ok" 600] != 0}]
note "/etc/mtab ships empty" \
    [expr {[v10_try "test ! -s $MNT/etc/mtab && echo MB\$OK" "MB-ok" 600] != 0}]
# EIGHT GETTYS, COUNTED AS GETTYS.  `grep -c ^1' answers NINE on a correct file,
# because /etc/ttys enables the console line too -- so the assertion failed on a
# file that was right.  Count what the note actually claims.
note "the eight gettys are enabled" \
    [expr {[v10_try "test `grep -c '^1.tty0' $MNT/etc/ttys` = 8 && echo TY\$OK" "TY-ok" 600] != 0}]

# ------------------------------------------------------- what must be there ---
v10_sh "rm -f $OBJ/bp.bad" 120
v10_run "while read nm dir dest; do if test -s $MNT/\$dest; then :; else echo \$dest >> $OBJ/bp.bad; fi; done < $MK/bootpath.order; echo BPEND" \
        "BPEND" 900
v10_run "echo BPBAD; if test -s $OBJ/bp.bad; then cat $OBJ/bp.bad; fi; echo BPBADEND" "BPBADEND" 600
note "every boot-path command is on the image" \
    [expr {[v10_try "test ! -s $OBJ/bp.bad && echo BP\$OK" "BP-ok" 600] != 0}]

v10_run "echo INV; ls $MNT/bin | wc -l; ls $MNT/etc | wc -l; ls $MNT/usr/bin | wc -l; echo INVEND" "INVEND" 900

# --------------------------------------------------------------- teardown ---
# V10's kernel does NOT sync on halt -- lsys/md/machdep.c's boot() is two lines
# and RB_NOSYNC is referenced nowhere -- so the userland sync is the whole
# flush, and sync(2) returns before the disk has the block.
v10_sh "cd /; sync" 300
v10_sh "/etc/umount -a" 1800
v10_sh "sync" 300
report
v10_halt

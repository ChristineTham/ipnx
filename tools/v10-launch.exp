#!/usr/bin/env expect
log_user 1
set timeout 900

set ROOT [file normalize [file dirname [file dirname [info script]]]]
set IMG  [lindex $argv 0]
set SIM  "$ROOT/work/opensimh/BIN/vax780"
set ROM  "$ROOT/v10/usr/sys/boot/star/uda"
set CFG  "/tmp/v10launch.[pid].conf"

proc bail {why} {
    puts "\nv10-launch: $why"
    catch { send "\005" }
    catch { expect -timeout 20 -- "sim>" {} timeout {} }
    catch { send "quit\r" }
    catch { close }
    exit 1
}
proc sim {cmd} {
    send "$cmd\r"
    expect -timeout 60 -- "sim>" {} timeout { bail "no sim> after: $cmd" }
}

set fh [open $CFG w]
foreach l [list \
    "set noasynch" "set cpu 8m" "set dz enable" "set dz lines=8" "set tto 7b" \
    "set rq0 ra81" "attach rq0 [file tail $IMG]" \
    "set il enable" "set il address=2013E800" "set il vector=E8" \
    "attach il nat:"] { puts $fh $l }
close $fh

cd [file dirname $IMG]
spawn $SIM $CFG
expect -timeout 180 -- "sim>" {} timeout { bail "simulator never prompted" }
sim "load -o $ROM FA00"
foreach c {"dep sp 200" "dep r1 0" "dep r3 0" "dep r5 0"} { sim $c }
send "run FA02\r"

expect -timeout 900 -- "ogin:" {} -- "panic:" { bail "panic during boot" } \
    timeout { bail "no login prompt" }
send "root\r"
expect -timeout 300 -- "# " {} timeout { bail "root did not get a shell" }

interact
catch { close }
file delete $CFG

#!/usr/bin/env expect
# A source disk, made by V10 on partition h.
#
#	expect tools/v10-srcdisk10.exp <builder> <blank> <tport>
#
# Normally run through tools/v10-srcdisk10.sh.
#
# WHY A SEPARATE DISK AT ALL.  ra_sizes[] cannot hold both a 128 MB /usr and
# 243 MB of source on one RA81:
#
#	a  0       .. 10,240    root
#	b  10,240  .. 30,720    swap
#	c  30,720  .. 280,568   /usr, 128 MB
#	d  280,568 .. 530,416   128 MB   \  the only partitions that do not
#	e  530,416 .. 780,264   128 MB   /  overlap c, and they cannot be joined
#	g  30,720  .. 780,264   384 MB -- CONTAINS c
#	h  0       .. 891,072   456 MB -- CONTAINS a, b and c
#
# So g and h overlap /usr, and d or e alone is 120 MB usable against 243.  A
# second spindle is what V10 itself did, and it needs no invented partition.
#
# AND h IS SAFE HERE, WHICH IT IS NOT ON A BOOT DISK.  CLAUDE.md's warning --
# a whole-drive filesystem contains partition b, so `swap ra 01 20480' writes
# swap through blocks 10,240..30,720 of a live filesystem -- applies to the
# ROOT device.  This disk is rq1, carries no swap and is never booted, so the
# whole 891,072 sectors are usable.
#
# 111,384 BLOCKS IS K11's NUMBER, ALREADY PROVEN.  891072/8 = 111,384, which is
# 3.6x MAXSMALL, so mkbitfs takes largefree() and puts the free-block bitmap
# OUTSIDE the superblock.  K11 made, checked, mounted, wrote to, unmounted and
# remounted exactly that size.
#
# THE TAPE'S src/ GOES AT THE TOP, so the disk mounts as /usr/src with cmd/,
# lsys/ and libc/ directly beneath it -- not /usr/src/src.

set timeout 1200
log_user 1
set ROOT [file normalize [file dirname [file dirname [info script]]]]
source "$ROOT/tools/v10drive.exp"

set IMG   [lindex $argv 0]
set BLANK [lindex $argv 1]
set tport [lindex $argv 2]

v10_deadline 7200
set MP /mnt

# 891,072 sectors / 8 = 111,384 blocks of 4096.
set BLKS 111384
# 64 | (unit<<3) | part, with h = 7.  The blank is rq1, so 64|8|7 = 79.
# DERIVED, because K11 hand-wrote this number while its disk was on rq2 and
# nineteen assertions passed about a filesystem written over the wrong image.
set MINOR 79

set results {}
proc note {name ok} { global results; lappend results [list $name $ok] }
proc report {} {
    global results
    puts "\n===== A SOURCE DISK, MADE BY V10 ON PARTITION h ====="
    set bad 0
    foreach r $results {
        puts [format "  %-54s %s" [lindex $r 0] [expr {[lindex $r 1] ? "ok" : "NO"}]]
        if {![lindex $r 1]} { incr bad }
    }
    puts [format "===== %d/%d =====" [expr {[llength $results] - $bad}] [llength $results]]
    return $bad
}

set IL [list "set il enable" "set il address=2013E800" "set il vector=E8" \
             "attach il nat:"]

v10_select_machine $IMG
v10_boot $IMG [concat [list "set rq1 ra81" "attach rq1 $BLANK"] $IL]
v10_login root
v10_sh "PATH=/bin:/etc:/usr/bin; export PATH" 60
v10_sh "OK=-ok" 60

puts "\n===== SOURCE DISK: V10's OWN mkbitfs, PARTITION h =====\n"

v10_sh "mkdir /n; mkdir /n/tree" 120
set s1 [v10_try "/etc/nafsmnt 10.0.2.2 $tport /n/tree 0" "mounted on" 900]
note "the tape mounts over TCP" [expr {$s1 != 0}]
if {$s1 == 0} { report; v10_bail "no tape -- nothing below a mount can be asserted" }

note "the tape's source is readable off the share" \
    [expr {[v10_try "test -s /n/tree/src/cmd/sed/sed.c && echo RD\$OK" "RD-ok" 300] != 0}]

# ------------------------------------------- V10 MAKES THE FILESYSTEM ------
note "the builder carries mkbitfs (nothing is compiled here)" \
    [expr {[v10_try "test -s /etc/mkbitfs && echo MK\$OK" "MK-ok" 300] != 0}]

v10_sh "rm -f /dev/ra1h; /etc/mknod /dev/ra1h b 7 $MINOR" 300
note "the blank disk's whole-drive node exists" \
    [expr {[v10_try "test -b /dev/ra1h && echo ND\$OK" "ND-ok" 300] != 0}]

note "mkbitfs writes a ${BLKS}-block filesystem (3.6x MAXSMALL)" \
    [expr {[v10_try "/etc/mkbitfs /dev/ra1h $BLKS && echo M1\$OK" "M1-ok" 3600] != 0}]

v10_sh "mkdir $MP" 120
set mt [v10_try "/etc/mount /dev/ra1h $MP && echo MT\$OK" "MT-ok" 900]
note "V10 mounts the filesystem it just made" [expr {$mt != 0}]
if {$mt == 0} { report; v10_bail "the source filesystem did not mount" }

# ---------------------------------------------------- THE TAPE'S SOURCE ----
# `src/' AT THE TOP, so this mounts as /usr/src and holds cmd/, lsys/, libc/
# directly -- not /usr/src/src.  `cpio -pd' does NOT create its destination,
# but $MP is the mount point and already exists.
puts "\n-- copying the tape's src/ (about 24,000 files) --\n"
v10_sh "cd /n/tree/src; find . -print | cpio -pd $MP > /dev/null 2>&1" 7200

note "cmd/ is at the top, not under another src/" \
    [expr {[v10_try "test -d $MP/cmd/sed && echo TP\$OK" "TP-ok" 900] != 0}]
note "and so is the kernel tree" \
    [expr {[v10_try "test -d $MP/lsys/io && echo KS\$OK" "KS-ok" 900] != 0}]
note "there is no $MP/src" \
    [expr {[v10_try "test ! -d $MP/src && echo NS\$OK" "NS-ok" 900] != 0}]
note "a source file reads back" \
    [expr {[v10_try "test -s $MP/cmd/sed/sed.c && echo RB\$OK" "RB-ok" 900] != 0}]

v10_run "echo INV; ls $MP | wc -l; echo INVEND" "INVEND" 900

v10_sh "cd /; sync" 300
v10_sh "/etc/umount -a" 1800
v10_sh "sync" 300
report
v10_halt

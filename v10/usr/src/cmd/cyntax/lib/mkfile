LIB		= /usr/lib/cyntax
CCOM		= ${LIB}/ccom
CEM		= ${LIB}/cem

# ipnx: :V: ON THE PHONY TARGETS.  An empty recipe on a file target is an error
# in mk and was not one in make -- `mk: no recipe to make 'install'', from
# mk/src/recipe.c:19-27.  sets/mkfile:16-28 carries the whole account.
all:V:		libc libj libipc

libj		: llib-lj ${CCOM} ${CEM}
		/lib/cpp -M -I/usr/jerq/include llib-lj | ${CCOM} -llibj - out && ${CEM} -p out && mv out libj

libg		: llib-lg ${CCOM} ${CEM}
		/lib/cpp -M -I/n/coma/usr/2include -Uvax -Dmc68020=1 llib-lg | ${CCOM} -Vprint:1 -Vfprint:2 -Vsprint:2 -VFprint:2 -llibg - out && ${CEM} -p out && mv out libg

libk		: llib-lk ${CCOM} ${CEM}
		/lib/cpp -M -I/usr/ninclude -Uvax -Dmc68020=1 llib-lk | ${CCOM} -Vprint:1 -Vfprint:2 -Vsprint:2 -llibk - out && ${CEM} -p out && mv out libk

lib%		: llib-l% var% ${CCOM} ${CEM}
		/lib/cpp -M llib-l$stem | ${CCOM} `cat var$stem` -llib$stem - out && ${CEM} -p out && mv out lib$stem

# ipnx: libg and libk stay out of all:/install:.  Both hardcode an -I path
# this project has no source for -- libg wants /n/coma/usr/2include (a
# network mount to a specific, long-gone Bell Labs machine, never a tape),
# libk wants /usr/ninclude (not on any of the six tapes either, and unlike
# libg there is no prebuilt binary to fall back on).  Building bit-for-bit
# tape content isn't available for either, so this is a genuine gap, not
# an ipnx omission: leave both alone rather than have `mk` fail or, worse,
# silently regenerate a wrong library once ${CCOM}/${CEM} are freshly built.
#
# ipnx: libq stays out too, and its absence is what keeps libc IN.  It was
# added here on 20 Sep alongside libipc, unbuilt, and the first full build
# answered `llib-lq: 17: Can't find include file sys/utsname.h' -- this tree's
# is include/utsname.h, so llib-lq was written for some other machine's
# headers.  mk stops at the first failure, so libc was built and never
# installed, and every cyntax link pass after it -- sign's, ipc/bin's for
# con -- died with `cem: no library '-lc''.  Nothing in the tree links -lq.
install:V:	${LIB}/libc ${LIB}/libj ${LIB}/libipc

${LIB}/lib%	: lib%
		cp lib$stem ${LIB}/lib$stem

clean:V:
		rm -f libc libj out || :

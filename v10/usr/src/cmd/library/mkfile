ROOT = 
CC = cc
INC = ${ROOT}/usr/include
MAKE = ${ROOT}/bin/make
INCSYS = ${ROOT}/usr/include/sys
SHELL = /bin/sh
TESTDIR= .
INS = ${ROOT}/etc/install
INSDIR = ${ROOT}/usr/bin
INSLIB = ${ROOT}/usr/lib/library
MAN = ${ROOT}/usr/lman/u_man/man1
LFILES=[2456].* *help* known.list

LDFLAGS= -s ${LDLIBS}
# following is for BSD machines.
# BSD=`if [ -x /bin/sun ]; then if /bin/sun; then echo "-DBSD4_2 -Dstrchr=index -Dstrrchr=rindex"; fi; fi`
BSD=-DBSD4_2
DFLAGS=-DWHERE\=\"${INSLIB}\" ${BSD}
CFLAGS=-O -I.  ${DFLAGS}

FILES=library
OFILES=library.o option1.o option3.o reader.o option2.o checkdoc.o gnamef.o uppercase.o

all:V: ${FILES}
	:

library: ${OFILES}
	${CC} ${CFLAGS} -o ${TESTDIR}/library ${OFILES} ${LDFLAGS}

lint:
	lint  ${LFLAGS} ${DFLAGS} *.c

install: library
	if test ! -d ${INSLIB} ; \
	then \
	    mkdir ${INSLIB}; \
	    /etc/chown bin,bin ${INSLIB}; \
	    chmod 775 ${INSLIB}; \
	    fi
	# -c AND THE MODE AFTERWARDS.  The tape rule is System V install --
	# `-m MODE -f DIR file' -- and v10's install (cmd/install.sh) takes
	# `[-s|-c] file dest' and nothing else, so -m arrived as the file to
	# install: `mv: cannot access -m'.  Worse, install.sh:1 defaults
	# cmd=/bin/mv, so without -c it MOVES the source out of the tree.
	for i in ${LFILES}; do ${INS} -c ${TESTDIR}/$i ${INSLIB}/$i && chmod 444 ${INSLIB}/$i; done;
	${INS} -c ${TESTDIR}/library ${INSDIR}/library && chmod 555 ${INSDIR}/library
	if test  -d ${MAN} ; \
	then \
	    ${INS} -c library.1 ${MAN}/library.1 && chmod 444 ${MAN}/library.1 ; \
	    fi

clean: 
	rm -f *.[oO]

clobber: clean
	rm -f library


BUILTINS=
NPROC=1

HFILES=code.h

all:V:	sprog brspell amspell

bin:	spell.sh
	cp spell.sh /usr/bin/spell

lib:	sprog amspell brspell
	cp sprog /usr/lib/spell/sprog
	strip /usr/lib/spell/sprog
	cp amspell /usr/lib/spell/amspell
	cp brspell /usr/lib/spell/brspell
	rm -f sprog amspell brspell
	
# ipnx: WRITE TO A TEMPORARY AND MOVE, because `>brspell' truncates the file
# BEFORE pcode runs and leaves a zero-length one behind if it does not finish.
# That is not hypothetical: the golden built on 18 Sep 2026 shipped
# /usr/lib/spell/brspell at 0 bytes, so British spelling was silently dead on
# a disk whose build had reported only a FAILED line for it.  amspell below
# survived only because it happens to be built second and the run got that far.
brspell: pcode  list british local stop
	./pcode list british local stop >_brspell && mv _brspell brspell

amspell: pcode  list american local stop
	./pcode list american local stop >_amspell && mv _amspell amspell

pcode:	pcode.o
	lcc -o pcode pcode.o

sprog:	sprog.o
	lcc -o sprog sprog.o

%.o:	%.c $HFILES
	lcc -A -c $stem.c

install: sprog amspell brspell
	strip sprog
	cp sprog amspell brspell /usr/lib/spell
clean:V:
	rm -f *.[v2o] amspell brspell pcode sprog

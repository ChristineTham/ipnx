# DIFF/DIFFH are compiled into the binaries themselves (diff.c:8-9's
# char diff[]/diffh[]) for diff -r/-h's own execv() of a fresh copy of
# itself, so they must stay these true absolute paths always -- ROOT-
# prefixing them (as a $ROOT-targeted install otherwise correctly does
# for every other destination) would bake the BUILDING machine's path
# into a binary that runs on a different root once installed. DIFFDEST/
# DIFFHDEST are where install actually copies the binaries, and are the
# ones a $ROOT-targeted build should override instead.
DIFF=	/bin/diff
DIFFH=	/usr/lib/diffh
DIFFDEST=	${DIFF}
DIFFHDEST=	${DIFFH}
CC=	cc
CFLAGS=	-O -DDIFF=\"${DIFF}\" -DDIFFH=\"${DIFFH}\"

SRCS=	diff.c diffdir.c diffreg.c
HDRS=	diff.h
OBJS=	diff.o diffdir.o diffreg.o

all:N: diff diffh

diff: $OBJS
	$CC $CFLAGS -o $target $OBJS $LDFLAGS

diffh: diffh.o
	$CC -o $target diffh.o $LDFLAGS

clean:
	rm -f diff diffh $OBJS diffh.o

install: all
	strip diff diffh
	cp diff $DIFFDEST
	cp diffh $DIFFHDEST

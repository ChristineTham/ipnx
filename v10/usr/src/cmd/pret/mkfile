# HAND-WRITTEN over the mechanical conversion -- the converter's appended rules
# fought this package's own flow and mk called pretlex.o ambiguous.
#
# THE FLOW IS THE ORIGINAL MAKEFILE'S: pret.o comes from pret.y via yacc -d,
# whose y.tab.h feeds x.tab.h (copied only when it changed, so a regenerated
# header that is byte-identical does not ripple), and pretlex.o wants x.tab.h.
# What the original left implicit -- make's builtin .y.o and the y.tab.h side
# effect -- is explicit here, because mk has no .y builtins that run yacc -d
# and no notion of a side-effect file.
CFLAGS = -O
OBJS = pret.o pretlex.o pret0.o pret1.o pret2.o pret3.o pret4.o pret6.o pret7.o pret8.o pret9.o

pret:	${OBJS} pret.h pret.d
	${CC} ${CFLAGS} ${OBJS} -lln -o pret

# yacc -d, and both products are real targets: y.tab.c is consumed on the
# spot, y.tab.h stays for x.tab.h to compare against.
pret.o y.tab.h:	pret.y pret.expr.c
	yacc -d pret.y
	${CC} ${CFLAGS} -c y.tab.c
	rm -f y.tab.c
	mv y.tab.o pret.o

pretlex.o:	pretlex.l x.tab.h
	lex pretlex.l
	${CC} ${CFLAGS} -c lex.yy.c
	rm -f lex.yy.c
	mv lex.yy.o pretlex.o

x.tab.h:	y.tab.h
	cmp -s x.tab.h y.tab.h || cp y.tab.h x.tab.h || :

%.o:	%.c
	${CC} ${CFLAGS} -c $stem.c

# the header dependencies ride separately: extras on a metarule make it
# ambiguous against mk's builtin (measured), and make ignored them anyway
pret0.o pret1.o pret2.o pret3.o pret4.o pret6.o pret7.o pret8.o pret9.o:	pret.h pret.d

clean:V:
	rm -f *.[oO] pret y.tab.c y.tab.h lex.yy.c

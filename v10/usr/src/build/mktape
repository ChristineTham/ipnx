# Extract the six archives into a blank /v10/usr.  That is all it does.
#
#	mkimage   makes the disk and extracts a prebuilt ipnx.tar into it
#	mktape    fills a blank /v10/usr from the six archives   <-- this
#	mkipnx    writes /v10/usr back out as ipnx.tar
#
# Run when the tapes change, or to build a /usr from nothing.  A machine whose
# /v10/usr is already populated does not need this -- mkipnx alone regenerates
# the archive from what is there.
#
# THE FIVE ARE PLAIN TAR, LOCAL, AND IN /usr/tmp BECAUSE THEY DO NOT STAY.
# 430 MB against a 1,533 MB /usr, wanted by nothing once /v10/usr is filled, so
# they go in the scratch directory and this removes them on the way out.  The
# work is split: the host fetches and decompresses (tools/v10-tapes.sh), the
# guest extracts and archives.
# Nothing is copied to a scratch file first any more -- that was for netafs,
# where tar cannot read an archive at all (tar.c:990 tolerates only ENOTTY from
# its MTIOCTOP, and neta.c:35 passes nodev as t_ioctl, which subr.c:199 turns
# into ENODEV).
#
# PLAIN TAR BECAUSE NOTHING HERE CAN READ .gz OR .bz2, and that is not an
# oversight to fix: gzip is 1992 and bzip2 1996, so a 1989 system has neither,
# and cmd/ carries compress(.Z) and pack(.z) instead.  tools/v10-tapes.sh
# decompresses on the host -- decompressing is not extracting, so the case
# collisions the tapes carry are still resolved HERE, on a case-sensitive
# filesystem, and never on the Mac.
# WHERE THE FIVE ARE.  /usr/tmp by default -- the machine's own scratch, which
# is where the host-side half leaves them -- but an image whose /etc/rc still
# mounts the repository's tapes share runs `mktape /n/tapes' instead.
TAPES=${1-/usr/tmp}

# /v10/usr must be blank and mounted.  mkimage makes it that way: with no
# ipnx.tar to extract it stops right after mounting.  Anything already there is
# a disk somebody built, and extracting six tapes over it would mix two trees --
# so refuse rather than damage it.
test -d /v10/usr || exit 1
if test -d /v10/usr/src
then
	echo "mktape: /v10/usr already holds a source tree"
	echo "mktape: run mkimage first -- it blanks ra1 and mounts it"
	exit 1
fi
if test -d /v10/usr/tapes
then
	echo "mktape: /v10/usr is a disk mkimage has already built"
	echo "mktape: run mkimage first -- it blanks ra1 and mounts it"
	exit 1
fi

mkdir /v10/usr/src || exit 1
mkdir /v10/usr/blit || exit 1

cd /v10/usr/src && tar xf $TAPES/secombe.tar || exit 1

cd /v10/usr && tar xf $TAPES/sellers.tar || exit 1

cd /v10/usr && tar xf $TAPES/milligan.tar || exit 1

cd /v10/usr/blit && tar xf $TAPES/v10blit.tar || exit 1

# THE INCLUDE TREE GOES IN THE SOURCE TREE, like every other tape.  349 members
# rooted at ./  The mkfile installs it to /usr/include from there, the same as
# it installs everything else -- libc/mkfile:150,155,205 name
# /usr/include/libc.h as an absolute prerequisite, so a disk without it cannot
# build a libc at all.
mkdir /v10/usr/src/include || exit 1
cd /v10/usr/src/include && tar xf $TAPES/r70include.tar || exit 1

# v10src is norman's, and secombe wins wherever both have a path.  Only what
# secombe lacks is taken: 630, maps and doc, and thirteen source directories.
# Everything else v10src adds at this level is a compiled binary left in the
# source tree -- cmd/ls is 29816 bytes mode 775, and so are cmd/pr, cmd/test,
# cmd/ranlib and the rest -- or an object, an archive, a core or a nohup.out.
#
# cmd/adb/vax is one level down and easy to miss: secombe has cmd/adb, with
# 11v, 68v, comm, conf, cray, g, null, seq, v7 and v8, but no vax -- adb is
# built per machine, and ours is the one directory only norman carries.
cd /v10/usr && tar xf $TAPES/v10src.tar 630 maps || exit 1
cd /v10/usr/src && tar xf $TAPES/v10src.tar doc || exit 1
cd /v10/usr/src && tar xf $TAPES/v10src.tar \
	cmd/bison cmd/cp cmd/cyntax cmd/flex cmd/gcc cmd/icon \
	cmd/library cmd/m4 cmd/matlab cmd/pascal cmd/post cmd/wwb \
	cmd/adb/vax lbin/kermit || exit 1

# The kernel is /usr/sys on a running machine, not /usr/src/sys.
mv /v10/usr/src/sys /v10/usr/sys || exit 1

# Done with them.  Named one by one rather than $TAPES/*.tar, because /usr/tmp
# is a scratch directory and a glob there would take somebody else's file.
rm -f $TAPES/secombe.tar $TAPES/sellers.tar $TAPES/milligan.tar
rm -f $TAPES/v10blit.tar $TAPES/v10src.tar $TAPES/r70include.tar

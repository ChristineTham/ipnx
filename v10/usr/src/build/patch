# Source repairs, applied to $SRC.  mkimage re-extracts the tapes over that
# tree, so they are applied here rather than edited in place; each is also
# carried in the repository, so git holds the record.  All are idempotent --
# the pattern is gone after the first pass.  Run from the mkfile, once.
#
# SRC FOLLOWS THE CALLER.  mk(1):371 -- "The environment is exported to recipe
# executions" -- so the mkfile's own SRC and GEN are already here, and
# hardcoding /v10 made `mk' with ROOT empty repair the wrong tree.  The
# default is for running it by hand against the disk on ra1.
SRC=${SRC-/v10/usr/src}
# GEN's DEFAULT IS THE BUILDER'S, not $SRC/build, and it no longer matches SRC
# on purpose.  SRC is the tree being repaired -- /v10's, by hand -- while GEN is
# where the replacement files come from, and mkfile:109 pins that to this
# machine for the reasons given there.  Taking it from $SRC would read repair
# inputs off the disk being written, which is a copy that can be a generation
# behind the one the mkfile just used.
GEN=${GEN-/usr/src/build}
SYS=${SYS-/v10/usr/sys}

# arff.c:694 compares struct rt_ent * (line 69) against char * (line 72).  The
# file is byte-identical to v8's; v8's cc accepted the mismatch, v10's does not.
cd $SRC/cmd || exit 1
sed 's|== (rt_last +|== (struct rt_ent *)(rt_last +|' arff.c > a$$ && mv a$$ arff.c

# v10 split v8's monolithic sys/ioctl.h: TIOCGETP, TIOCGPGRP and TIOCSPGRP to
# sys/ttyio.h; TIOCLGET, TIOCLBIS and TIOCLBIC to sys/nttyio.h; FIOCLEX,
# FIOPUSHLD, FIOPOPLD and FIOLOOKLD to sys/filio.h.  csh's sources are 4.2
# (3/11/81) and still ask for the old name.  nfunc.c is not in the makefile's
# OBJS, so it keeps the include and the TIOCSETD/NTTYDISC calls v10 has no
# equivalent for.
cd $SRC/lbin/csh || exit 1
for f in sh.c sh.err.c sh.func.c sh.print.c sh.proc.c sh.sem.c
do
	sed 's|#include <sys/ioctl.h>|#include <sys/ttyio.h>\
#include <sys/nttyio.h>\
#include <sys/filio.h>|' $f > c$$ && mv c$$ $f
done

# sh.local.h needs NCARGS, NOFILE and NSYSFILE, which sh.local.h:27 says come
# from <sys/param.h> -- csh chooses not to include it and the NCARGS line is
# commented out.  param.h:8-10 give NOFILE 128, NSYSFILE 4, NCARGS (16*1024).
# Copied rather than sed'd: v10's sed writes a literal t for \t in a
# replacement, which produced `#definetNCARGSt...' and three "undefined
# control" errors.
cp $GEN/src/sh.local.h $SRC/lbin/csh/sh.local.h || exit 1

# cmd/gcc/mkfile:313,318,320 end `strip -g target' with the $ missing, so each of
# the four install rules strips a file literally named target and fails.  -g is
# right: strip.c:26 has case 'g' and strip(1) documents it.
cd $SRC/cmd/gcc || exit 1
sed 's|strip -g target|strip -g $target|' mkfile > g$$ && mv g$$ mkfile

# cc.c:65-71 rejects -o whose argument ends .c or .o -- "-o would overwrite" and
# exit 8 -- so v10's cc cannot do `cc -c -o foo.o'.  lcc's makefiles use that
# form for all eighteen of their objects, which land in $(D) = vax-bsd.  Compile
# in place and move instead.
cd $SRC/cmd/lcc/c || exit 1
sed 's|[$](CC) -c -o [$]@ [$](CCOPT) [$](C)/\(.*\)\.c|$(CC) -c $(CCOPT) $(C)/\1.c \&\& mv \1.o $@|' \
    makefile > m$$ && mv m$$ makefile

cd $SRC/cmd/lcc/gen2 || exit 1
sed -e 's|[$](CC) -c -o [$]@ [$](CCOPT) \([^;]*\)$|$(CC) -c $(CCOPT) \1 \&\& mv `basename \1 .c`.o $@|' \
    -e 's|[$](CC) -c -o [$]@ \(-I[a-z]*\) [$](CCOPT) \([^;]*\)$|$(CC) -c \1 $(CCOPT) \2 \&\& mv `basename \2 .c`.o $@|' \
    makefile > m$$ && mv m$$ makefile

cd $SRC/cmd/lcc/gen0 || exit 1
sed 's|[$](CC) -c -o [$]@ [$](CFLAGS) [$](INCLUDES) gen\.c|$(CC) -c $(CFLAGS) $(INCLUDES) gen.c \&\& mv gen.o $@|' \
    makefile > m$$ && mv m$$ makefile

# toplev.c takes <sys/param.h> under USG -- and gcc/mkfile:22 is CFLAGS with
# -DUSG -- then takes <sys/types.h> again behind `#ifndef _TYPES_'.  v10's
# types.h defines no _TYPES_ and carries no guard of its own, while param.h:131
# ends `#include "sys/types.h"', so the typedefs are parsed twice and every one
# of them reads as three type specifiers combined:
#     "/usr/include/sys/types.h":33:illegal type combination
# Recorded before, in docs/v10-log/2026-08-18.md, against a different header.
cd $SRC/cmd/gcc || exit 1
sed '/^#include <sys\/types.h>$/d' toplev.c > t$$ && mv t$$ toplev.c

# lcc's Symbol.ref is `float ref;' (c/c.h:226) and seven statements increment or
# decrement it with ++ and --, which v10's ccom refuses:
#     "../c/dag.c":430:no float ++/--
# Rewritten as += 1 and -= 1.  All seven are standalone statements, so nothing
# depends on the value of the expression.  Symbol.count is short and nodecount
# is int, so their ++ are left alone.
cd $SRC/cmd/lcc/c || exit 1
for f in dag.c input.c stmt.c
do
	sed -e 's|->ref++;|->ref += 1;|' -e 's|->ref--;|->ref -= 1;|' $f > r$$ && mv r$$ $f
done

# cmd/gcc/jump.c on v10src is damaged -- a 124-line block duplicated over the
# region GNU CC 1.21 has at 386-518, leaving two #endif without an #if.  It is
# not repairable by sed, so the reconstruction carried in the repository is
# copied over it; that file's own header records what was lost and how it was
# rebuilt.  Idempotent: cp of the same bytes.
cp $GEN/src/jump.c $SRC/cmd/gcc/jump.c || exit 1

# cmd/gcc/local-alloc.c likewise: its first 4096 bytes are the tail of GNU CC's
# Makefile followed by 1405 NUL bytes, so cpp reads the Makefile comments as
# directives -- "local-alloc.c: 42: undefined control".  Same treatment.
cp $GEN/src/local-alloc.c $SRC/cmd/gcc/local-alloc.c || exit 1

# Admin/etcfiles names seventeen files no v10 tape carries.  Five of them exist
# in the Eighth Edition and are staged here from mk/gen/v8, the way the two gcc
# reconstructions are staged: finddev.c, fstat.c, rp07dump.c and rp07rest.c are
# compiled by the ordinary .c rule, install.sh copied by the .sh rule.  They are
# kept under mk/gen so nothing in v10/usr/src pretends to be tape content.
cd $SRC/cmd || exit 1
for f in finddev.c fstat.c rp07dump.c rp07rest.c install.sh
do
	cp $GEN/v8/$f $SRC/cmd/$f || exit 1
done

# nafsmnt is ours -- no v10 tape has it.  Staged like the v8 imports.
cp $GEN/src/nafsmnt.c $SRC/cmd/nafsmnt.c || exit 1

# libin's mkfile makes every archive member depend on cyntax, its lint, which is
# not built here; libipc's mkfile makes no such demand and is why that one built.
cd $SRC/ipc/libin || exit 1
sed 's|^[$]OBJS: cyntax$|# $OBJS: cyntax -- dropped, see mk/gen/patch|' \
    mkfile > n$$ && mv n$$ mkfile

# as/assyms.c's symcmp IS NOT ANTISYMMETRIC, and that is why /bin/as died with
# a memory fault on any file large enough to sort.  It reads
#
#	if (p->s_tag >= IGNOREBOUND)	/*p points to a jxxx*/
#		return(-1);
#	if (q->s_tag >= IGNOREBOUND)
#		return(1);
#
# and the first test fires whichever way the pair is presented, so two jxxx
# entries sharing s_index and s_value compare -1 in BOTH directions.  The
# comment above it asserts that cannot happen -- "Both can't be jxxxes, as they
# would have different values" -- and nothing enforces it.
#
# libc/gen/qsort.c is Bentley and McIlroy's, and its partition loops (:73, :77)
# are bounds-guarded, so an inconsistent comparator cannot walk off the array.
# What it does instead is make the partition degenerate, and :89-90 recurse on
# it -- qsort(a, s/es, es, cmp) and qsort(pn-s, s/es, es, cmp) -- so the
# recursion never shrinks and the STACK runs out.  It reads as a heap problem
# and is not: instrumenting Calloc showed eight allocations, every sbrk return
# equal to the previous break, 30,504 bytes, and the break flat from then on.
# There is no core because login.c:206 sets vlimit(LIM_CORE, 1024*1024).
#
# Testing both sides restores antisymmetry and keeps the intent: a jxxx still
# precedes a plain label at the same address, and two jxxxes now compare equal,
# which is what the file's own comment says they are.
#
# This is why the tape ships cmd/as/as prebuilt and why the RA81's /bin/as is
# byte-identical to it: their as predates this qsort (as.Oct1986 sits beside
# the binary), so the defect never showed until it met a 1993 sort.
cd $SRC/cmd/as || exit 1
sed -e 's|^	if (p->s_tag >= IGNOREBOUND)	|	if (p->s_tag >= IGNOREBOUND \&\& q->s_tag < IGNOREBOUND)	|' \
    -e 's|^	if (q->s_tag >= IGNOREBOUND)$|	if (q->s_tag >= IGNOREBOUND \&\& p->s_tag < IGNOREBOUND)|' \
    assyms.c > s$$ && mv s$$ assyms.c

# renice.c takes <sys/param.h> and then <sys/types.h>; param.h:131 ends with
# `#include "sys/types.h"' and types.h has no guard, so the typedefs are parsed
# twice.  Same fault as toplev.c.
cd $SRC/cmd || exit 1
sed '/^#include <sys\/types.h>$/d' renice.c > r$$ && mv r$$ renice.c

# gets was taken out of libc deliberately -- libc/stdio/gets.c-1 opens
#     /*
#      * Deleted from libc.a by td, 88.11.07
#      * gets is an unacceptable security hole.
#      */
# -- so it is not put back, and the ten call sites use fgets.  fgets keeps the
# newline where gets stripped it, which matters: rp07dump compares the answer
# with strcmp(answer, "yes").  strcspn is libc's (gen/strcspn.s).
cd $SRC/cmd || exit 1
sed -e 's|^		gets(mbuf);$|		*mbuf = 0; fgets(mbuf, sizeof mbuf, stdin); mbuf[strcspn(mbuf, "\\n")] = 0;|' \
    -e 's|^			gets(charbuf);$|			*charbuf = 0; fgets(charbuf, sizeof charbuf, stdin); charbuf[strcspn(charbuf, "\\n")] = 0;|' \
    -e 's|if (gets(tbf) == NULL)|if (fgets(tbf, sizeof tbf, stdin) == NULL)|' \
    -e 's|if (gets(tbf) == EOF) {|if (fgets(tbf, sizeof tbf, stdin) == NULL) {|' \
    512restor.c > g$$ && mv g$$ 512restor.c

sed -e 's|^		gets(mbuf);$|		*mbuf = 0; fgets(mbuf, sizeof mbuf, stdin); mbuf[strcspn(mbuf, "\\n")] = 0;|' \
    -e 's|^			gets(charbuf);$|			*charbuf = 0; fgets(charbuf, sizeof charbuf, stdin); charbuf[strcspn(charbuf, "\\n")] = 0;|' \
    -e 's|if (gets(tbf) == NULL)|if (fgets(tbf, sizeof tbf, stdin) == NULL)|' \
    -e 's|if (gets(tbf) == EOF) {|if (fgets(tbf, sizeof tbf, stdin) == NULL) {|' \
    restor.c > g$$ && mv g$$ restor.c

for f in rp07dump.c rp07rest.c
do
	sed 's|^				gets (answer);$|				*answer = 0; fgets(answer, sizeof answer, stdin); answer[strcspn(answer, "\\n")] = 0;|' \
	    $f > g$$ && mv g$$ $f
done

# dumprestor.h:25 is `char c_addr[BSIZE];', and v10's param.h:77 makes BSIZE a
# macro taking a device.  It meant 512: v8's param.h:96 defines BSIZE 512 under
# CLSIZE==1, and the program that reads these dumps is called 512restor.  Only
# 512restor.c, dumpdir.c and restor.c include this header, so the three stay
# consistent with each other.
sed 's|^	char	c_addr\[BSIZE\];|	char	c_addr[512];|' \
    /usr/include/dumprestor.h > d$$ && mv d$$ /usr/include/dumprestor.h

# bad144.c:81 calls tell(), which v10 has not got -- no libc member, no man
# page.  tell(f) is lseek(f, 0L, 1).
cd $SRC/cmd || exit 1
sed 's|tell(f), name);|lseek(f, 0L, 1), name);|' bad144.c > b$$ && mv b$$ bad144.c

# fstat.c includes <sys/tty.h>, which v10 has not got, and uses nothing from it.
sed '/^#include <sys\/tty.h>$/d' fstat.c > f$$ && mv f$$ fstat.c

# gtty AND stty ARE NOT IN THIS LIBC, and are not meant to be.  They are the V7
# wrappers over ioctl, and v10 carries neither: no gtty.c or stty.c in libc/sys,
# no $L(gtty.o) or $L(stty.o) in libc/mkfile, and no gtty(3) or stty(3) in the
# manual -- man3 has getpwent.3 and string.3 and nothing of these.  What v10
# does carry is the interface they wrapped: /usr/include/sgtty.h is four lines,
# "compatibility hack" over <sys/ttyio.h>, whose line 5 is `struct sgttyb' and
# whose 104-105 are
#	#define	TIOCGETP	(('t'<<8)|8)
#	#define	TIOCSETP	(('t'<<8)|9)
# Every call site is the same shape -- gtty(fd, &buf) with a struct sgttyb --
# and every one of the eight files already includes <sgtty.h>, so rewriting the
# call to the ioctl it stood for needs nothing else.  The eight are 300, 300s,
# 4014, 450 and hp in cmd/, and clear, paper and descrypt one level down; none
# of them mentions ioctl otherwise, so this is idempotent by construction.
cd $SRC/cmd || exit 1
for f in 300.c 300s.c 4014.c 450.c hp.c clear/clear.c paper/print2621.c descrypt/getpass.c
do
	sed -e 's|gtty *(\(.*\), *\(&[A-Za-z_][A-Za-z0-9_]*\))|ioctl(\1, TIOCGETP, \2)|' \
	    -e 's|stty *(\(.*\), *\(&[A-Za-z_][A-Za-z0-9_]*\))|ioctl(\1, TIOCSETP, \2)|' \
	    $f > t$$ && mv t$$ $f
done

# gets WAS DELETED FROM THIS LIBC ON PURPOSE, and stays deleted.  libc/stdio/
# gets.c-1 opens
#	/*
#	 * Deleted from libc.a by td, 88.11.07
#	 * gets is an unacceptable security hole.
#	 */
# -- a decision, not a gap -- so it is not put back into the library.  What is
# supplied instead is a per-file wrapper over fgets, in the seven sources that
# call it and nowhere else, which is the same shape as the rewrite this script
# already makes in 512restor, rp07dump and rp07rest.  fgets keeps the newline
# where gets stripped it, so the wrapper strips it.  The newline is written as
# 10 and not as an escape ON PURPOSE: these lines are produced by echo, and an
# echo that takes escapes without -e would put a real newline in the middle of
# the C string.  v10's own echo.c escapes only under -e (`if (*cp == 92 &&
# escflg)'), but the repair should not depend on which echo runs it.
#
# ONE FILE PER PROGRAM, AND THE DECLARATION GOES FIRST.  A second definition in
# the same link would be a duplicate symbol, so the list names the single caller
# in each: refer's kaiser.c and ml2.c call gets too and are in no target's
# object list.  The definition is appended -- it needs stdin, and stdio.h is
# only in scope after the file's own includes -- so `char *gets();' is
# prepended as well, or the earlier calls default it to extern int and the
# definition contradicts them.  The bound is the one thing a wrapper cannot
# know, which is the hole the deletion was about.
#
# flcopy.c HAS NO INCLUDES AT ALL, so the wrapper's stdin is undefined there
# ("flcopy.c":132:stdin undefined) and stdio.h goes in ahead of the
# declaration.  It is added only where absent: /usr/include/stdio.h guards its
# struct with `# ifndef FILE' but not its `#define BUFSIZ 4096', so a second
# include is noisy where one is already there.  IT IS A STEP OF ITS OWN: put
# inside the `ipnx gets' guard it never ran on a tree where the wrapper was
# already appended, and flcopy went on answering "stdin undefined".
# cflow's nmf.c (`_gets' undefined linking dag/lpfx/nmf, cflow/mkfile's own
# `flip' script) and town/town.c (`_gets' undefined linking town) call gets
# too, each the only caller in its own binary, so they join the list on the
# same rule as the eight above.
cd $SRC/cmd || exit 1
for f in flcopy.c dired/dired.c refer/deliv1.c wwb/dictadd.c ap/apkeys/dread.c ap/apkeys/flist.c basic/bite/src/input.c weather/weather.c cflow/nmf.c cflow/flip.c town/town.c
do
	if grep 'ipnx gets' $f > /dev/null
	then	:
	else
		echo 'char *gets();' > g$$
		cat $f >> g$$
		echo '/* ipnx gets -- see PATCHES.md */' >> g$$
		echo 'char *gets(s) char *s; {' >> g$$
		echo '	extern char *fgets();' >> g$$
		echo '	char *p;' >> g$$
		echo '	if (fgets(s, 1024, stdin) == 0) return 0;' >> g$$
		echo '	for (p = s; *p; p++) if (*p == 10) { *p = 0; break; }' >> g$$
		echo '	return s; }' >> g$$
		mv g$$ $f
	fi
done

# wwb/dictadd.c:17 is `while(gets(phrase) != EOF)' and EOF is -1, so once gets
# is declared char * -- which it has to be, for the wrapper's definition to
# match -- pcc answers "illegal pointer/integer combination, op !=".  It was
# never right: V7's gets returns NULL at end of file and NULL != EOF, so this
# loop never ended on EOF either.  Comparing against 0 is what the return value
# means.
cd $SRC/cmd/wwb || exit 1
sed 's|gets(phrase) != EOF|gets(phrase) != 0|' dictadd.c > d$$ && mv d$$ dictadd.c

# index IS strchr UNDER ITS V7 NAME, and string(3)'s NAME line names strchr and
# strrchr and neither index nor rindex -- the same evidence as gtty and getpw.
# weather.c declares it itself at :18, `char *index(), *timezone(), ...', and
# calls it at :224, :229 and :385; renaming every occurrence fixes the
# declaration with the calls.
cd $SRC/cmd/weather || exit 1
sed 's|index(|strchr(|g' weather.c > w$$ && mv w$$ weather.c

cd $SRC/cmd || exit 1
if grep 'stdio.h' flcopy.c > /dev/null
then	:
else
	echo '#include <stdio.h>' > s$$
	cat flcopy.c >> s$$
	mv s$$ flcopy.c
fi

# limiter.c USES NOFILE AND NSYSFILE AND INCLUDES NEITHER HEADER THAT HAS THEM.
# /usr/include/sys/param.h:8-9 are
#	#define	NOFILE	128		/* max open files per process */
#	#define	NSYSFILE 4		/* stdin, stdout, stderr, /dev/tty */
# and limiter.c:1-4 include sys/types.h, sys/filio.h, stdio.h and sys/stream.h.
# BUT param.h:131 ends `#include "sys/types.h"' unguarded, so adding param.h
# BESIDE limiter's own sys/types.h line -- as the line above used to -- parses
# every typedef in types.h twice, the same fault already fixed in toplev.c,
# renice.c and dipconfig.c:
#     "/usr/include/sys/types.h":33:illegal type combination
#     "/usr/include/sys/types.h":63:redeclaration of fd_set from some line 63
# param.h's own tail supplies types.h, so param.h REPLACES limiter's line
# instead of joining it.  Guarded on param.h's presence, not run order. so it
# also repairs a tree the line-above version already patched once: with
# param.h present already, the stray original sys/types.h line is dropped;
# without it, sys/types.h is substituted for sys/param.h, same as the else
# branch always did.
cd $SRC/cmd || exit 1
if grep '^#include <sys/param.h>$' limiter.c > /dev/null
then
	sed '/^#include <sys\/types.h>$/d' limiter.c > l$$ && mv l$$ limiter.c
else
	sed 's|^#include <sys/types.h>$|#include <sys/param.h>|' limiter.c > l$$ && mv l$$ limiter.c
fi

# stat.c:64 is `tp(S_ISVTX,'t')' AND V10 HAS NO STICKY BIT.  sys/stat.h:22-29
# name S_ISUID 04000, S_ISGID 02000 and then S_ICCTYP 07000 with S_ISYNC 01000
# and S_IEXCL 03000 -- 01000, which is S_ISVTX on Berkeley systems, is the
# concurrent-access type here, so printing `t' for it would be wrong as well as
# undefined.  The line goes.
sed '/tp(S_ISVTX/d' stat.c > s$$ && mv s$$ stat.c

# oops.c:62,67,84 declare size_t members and nothing on the tapes defines it:
# sys/types.h has no size_t and neither has stdio.h.  The kernel counts these
# in pages and clicks, all int-sized, so unsigned is the type the fields had
# before somebody wrote size_t over them.  The typedef is PREPENDED and not
# sedded onto the first #include: oops.c has several, and an unaddressed s|| on
# ^#include would put the typedef in front of every one of them.
cd $SRC/cmd/oops || exit 1
if grep 'ipnx size_t' oops.c > /dev/null
then	:
else
	echo 'typedef unsigned size_t;	/* ipnx size_t */' > o$$
	cat oops.c >> o$$
	mv o$$ oops.c
fi

# punct/mdouble.c:164 is `if(p == EOF)return(0);' where getl returns char *,
# the same fault as wwb/dictadd.c: EOF is -1 and a pointer is not.
cd $SRC/cmd/punct || exit 1
sed 's|if(p == EOF)|if(p == 0)|' mdouble.c > m$$ && mv m$$ mdouble.c

# basic/bas/io.c:59 is `register char *b = file->_base;' and stdio.h:5-6 declare
# _base as `unsigned char *', which pcc will not assign to a char * without a
# cast.
cd $SRC/cmd/basic/bas || exit 1
sed 's|= file->_base;|= (char *)file->_base;|' io.c > i$$ && mv i$$ io.c

# cflow/nmf.c IS MISSING ITS LAST #endif.  Its conditionals are #if at :2,
# #else at :65, then #if/#endif at :68/:71 and :73/:76 -- the outer one from
# line 2 is never closed, and cpp answers "Unexpected EOF within #if".
cd $SRC/cmd/cflow || exit 1
if grep 'ipnx endif' nmf.c > /dev/null
then	:
else
	echo '#endif	/* ipnx endif: nmf.c:2 is never closed */' >> nmf.c
fi

# flex/flexdef.h:61 includes <strings.h> and v10 has string.h -- the same file
# under the name string(3) gives it.
cd $SRC/cmd/flex || exit 1
sed 's|<strings.h>|<string.h>|' flexdef.h > f$$ && mv f$$ flexdef.h

# u9fs/makefile's rule is `%.o: %.c u.h libc.h 9p.h' with `lcc -c $(CFLAGS) $<',
# and v10 make sets $< to the first out-of-date prerequisite, which is 9p.h --
# so it compiled the header four times and then found no u9fs.o.  $*.c is the
# source the stem names.
cd $SRC/cmd/u9fs || exit 1
sed 's|lcc -c $(CFLAGS) $<|lcc -c $(CFLAGS) $*.c|' makefile > u$$ && mv u$$ makefile

# efl/icfile.c:3 is `struct { char chars[ 10 ]; };' -- a struct with no tag and
# no object, which declares nothing and which lcc reports as an empty
# declaration.  Nothing in the file refers to it.
cd $SRC/cmd/efl || exit 1
sed '/^struct { char chars\[ 10 \]; };$/d' icfile.c > e$$ && mv e$$ icfile.c

# libpen's openpl.c CALLS ioctl WITH FIOLOOKLD AND FIOPUSHLD AND INCLUDES ONLY
# "pen.h".  Both are in /usr/include/sys/filio.h:29,31 --
#	#define	FIOPUSHLD	(('f'<<8)|3)
#	#define	FIOLOOKLD	(('f'<<8)|5)
# -- the line-discipline ioctls it pushes tty_ld with.  The file was a member
# of pen.c.a until arcfix dissolved that archive into pen/, so the repair now
# edits pen/openpl.c in place; the marker comment is the guard.  The earlier
# ar-based form of this step, run after the dissolve, manufactured a fresh
# pen.c.a holding one file -- a stray archive the tar rules then had to sweep.
cd $SRC/libplot/libpen/pen || exit 1
if grep 'ipnx filio' openpl.c > /dev/null
then	:
else
	echo '#include <sys/filio.h>	/* ipnx filio */' > p$$
	cat openpl.c >> p$$
	mv p$$ openpl.c
fi

# town.c:6 is `# include "/usr/weather/progs/weath.h"' -- an absolute path to a
# directory this system has not got.  The header is cmd/weather/weath.h, which
# is where the program that uses it lives.
cd $SRC/cmd/town || exit 1
sed 's|"/usr/weather/progs/weath.h"|"../weather/weath.h"|' town.c > t$$ && mv t$$ town.c

# CREF IS 1982 C, AND EVERY FILE IS DATED Jan 13 1982.  Three faults, all
# mechanical, none of them a judgement about what the program should do.
#
# ONE: initialisers written without `='.  dr.c:30-31 are
#	char	*ignonl	"/usr/lib/aign";
#	char	*gtab	"/usr/lib/atab";
# and ccom/common/cgram.y:396-406 is `init_declarator: nfdeclarator |
# fdeclarator | xnfdeclarator ASSIGN e | xnfdeclarator ASSIGN LC init_list
# optcomma RC' -- there is no production without ASSIGN.  Twenty-seven such
# declarations across the directory.  The form is always
# type<tab>declarator<tab>value, so `= ' goes in front of the value; the
# pattern excludes a value already starting with `=', which is what makes the
# edit idempotent.
#
# TWO: the pre-1978 compound operators, ` =+ ` ` =- ` ` =* ` and ` =| `,
# twenty-three of them.  These are not all caught by the compiler: `argv =+ j'
# is read as `argv = +j' and fails only because K&R has no unary plus, while
# `argc =- j' reads as `argc = -j', compiles clean and is WRONG.  Every one is
# written with a space on both sides, so the substitution is unambiguous.
#
# THREE: v6 buffered i/o.  cref opens its input with `fopen(argv[i],ibuf1) < 0'
# -- the v6 call, which fills a caller's `int ib1[259]' buffer and returns a
# status -- and v10's is Berkeley's `FILE *fopen(file, mode)' (libc/stdio/
# fopen.c:6-8), so the buffer is being passed as the MODE STRING.  Five fopen
# calls in the directory and nine getc; getc needs no change once the pointer
# is a FILE *, and everything else in cref is raw open/read/write/close.  The
# two `ibuf1 = &ib1' lines that bound the v6 buffers go, and close() on a
# stream becomes fclose().
cd $SRC/cmd/cref || exit 1
for f in *.c
do
	sed -e 's/^\(int	[^	 ;{}]*\)	\([^=	 ]\)/\1	= \2/' \
	    -e 's/^\(char	[^	 ;{}]*\)	\([^=	 ]\)/\1	= \2/' \
	    -e 's/ =+ / += /g' \
	    -e 's/ =- / -= /g' \
	    -e 's/ =\* / *= /g' \
	    -e 's/ =| / |= /g' $f > c$$ && mv c$$ $f
done

# upost.c:165,169 initialise a ONE-ELEMENT ARRAY, not a scalar, so the braces
# the tape left off are put back rather than leaving `int tp[1] = 1;'.
sed -e 's|^int	tp\[1\]	= 1;$|int	tp[1]	= {1};|' \
    -e 's|^char	\*obuf\[1\]	= bsp;$|char	*obuf[1]	= {bsp};|' upost.c > u$$ && mv u$$ upost.c

# ccmn.c is #included by both dr.c and acts.c, so the three stream pointers and
# the stdio.h they now need are declared once, there.  ib1 and ib2 are left
# where they are: nothing reads them any more and they cost 2k of bss.
if grep 'ipnx stdio' ccmn.c > /dev/null
then	:
else
	echo '#include <stdio.h>	/* ipnx stdio -- see PATCHES.md */' > c$$
	cat ccmn.c >> c$$
	mv c$$ ccmn.c
fi
sed -e 's/^char	\*ibuf;$/FILE	*ibuf;/' \
    -e 's/^char	\*ibuf1;$/FILE	*ibuf1;/' \
    -e 's/^char	\*ibuf2;$/FILE	*ibuf2;/' ccmn.c > c$$ && mv c$$ ccmn.c

sed -e 's|if(fopen(argv\[i\],ibuf1) < 0) {|if((ibuf1 = fopen(argv[i],"r")) == 0) {|' \
    -e 's|^	fopen(ignonl,ibuf1);$|	ibuf1 = fopen(ignonl,"r");|' \
    -e '/^	ibuf1 = &ib1;$/d' \
    -e '/^	ibuf2 = &ib2;$/d' \
    -e 's|^	close(ibuf1);$|	fclose(ibuf1);|' dr.c > d$$ && mv d$$ dr.c

# THE CREF TABLES.  cref reads six files it cannot build for itself:
# /usr/lib/{a,c,e}tab, the grammar tables, and /usr/lib/{a,c,e}ign, the
# stop-word tables.  dr.c:30-31 name the assembler pair and the -c and -e
# branches of flags() name the other two pairs.  Their sources ARE on the
# tape -- atable/ctable/etable and asym/csym/esym -- and so are the two
# compilers: mtab.c turns a ?table into a ?tab, make.c turns a ?sym into a
# ?ign.  Both need repairs of their own beyond the ones above.
#
# make.c:5 IS `struct	htab	(' AND LINE 12 IS `		);'.  Round brackets
# where the braces belong -- the same struct is spelled correctly at
# ccmn.c:56 and ecmn.h:57.  Corrupt on the tape, and nothing else explains it.
#
# THE PDP-11 WORD IS THE REST OF IT.  These two write, and dr.c reads, byte
# counts computed as though an int were two bytes: mtab.c:176 is
# `write(fo,tab[i].cl,256)' for an `int cl[NUMC]' with NUMC 128, make.c:116
# writes its 0100200 magic as `write(ofile,&i,2)', and dr.c:210 and :227 read
# 256 and 6 back.  On the vax those arrays are twice the size, so mtab would
# write the first 64 of 128 character classes -- losing every letter, since
# `A' is 65 -- and dr would read half a header.  Writer and reader are
# changed together to sizeof, which keeps them consistent and makes the file
# native to the machine that builds it; these are local caches, not
# interchange files, built and read on the same disk.
#
# dr.c:222 CALLS gtty, which this libc has not got -- see the gtty note above,
# which covers eight other files but not this one, whose call has a different
# shape: `gtty(fi, b)' over an `int b[3]', not a &struct sgttyb.  It is asking
# whether the ignore file is a tty, and TIOCGETP through ioctl answers the
# same way: -1 for the regular file, which is the branch that then reads the
# table as binary.  b is twelve bytes and struct sgttyb is six, so it fits.
cd $SRC/cmd/cref || exit 1
if grep 'ipnx sgtty' ccmn.c > /dev/null
then	:
else
	echo '#include <sgtty.h>	/* ipnx sgtty -- see PATCHES.md */' > c$$
	cat ccmn.c >> c$$
	mv c$$ ccmn.c
fi
sed -e 's|if(read(fi,tab\[i\].cl,256) < 256) {|if(read(fi,tab[i].cl,sizeof(tab[i].cl)) < sizeof(tab[i].cl)) {|' \
    -e 's|if((read(fi,b,6) == 6) \&\& (b\[0\] == 0100200)) {|if((read(fi,b,sizeof(b)) == sizeof(b)) \&\& (b[0] == 0100200)) {|' \
    -e 's|if(gtty(fi, b) != -1) {|if(ioctl(fi, TIOCGETP, b) != -1) {|' dr.c > d$$ && mv d$$ dr.c

# mtab.c reads its input with v6's getchar, which took its fd from the global
# `fin' and returned 0 at end of file -- main opens argv[1] onto fin at :36 and
# never mentions it again.  v10's getchar is getc(stdin) and its EOF is -1, so
# `while(c = getchar())' over a char would never end.  The v6 one is supplied
# here instead, with its own fin, and no call site changes.
sed -e 's|^		write(fo,tab\[i\].cl,256);$|		write(fo,tab[i].cl,sizeof(tab[i].cl));\
	exit(0);\t\t/* ipnx exit -- see PATCHES.md */|' mtab.c > m$$ && mv m$$ mtab.c
if grep 'ipnx getchar' mtab.c > /dev/null
then	:
else
	echo 'int	fin;	/* ipnx getchar -- see PATCHES.md */' >> mtab.c
	echo 'getchar()' >> mtab.c
	echo '{' >> mtab.c
	echo '	char c;' >> mtab.c
	echo '	if (read(fin, &c, 1) != 1) return 0;' >> mtab.c
	echo '	return c;' >> mtab.c
	echo '}' >> mtab.c
fi

# make.c takes the same v6 fopen as dr.c, and its ifile goes unused once the
# stream itself is the handle.
if grep 'ipnx stdio' make.c > /dev/null
then	:
else
	echo '#include <stdio.h>	/* ipnx stdio -- see PATCHES.md */' > m$$
	cat make.c >> m$$
	mv m$$ make.c
fi
sed -e 's|^	return;$|	exit(0);\t\t/* ipnx exit -- see PATCHES.md */|' \
    -e 's|^struct	htab	($|struct	htab	{|' \
    -e 's|^		);$|		};|' \
    -e 's|^char	\*ibuf	= &ib1;$|FILE	*ibuf;|' \
    -e 's|^	ifile = fopen(argv\[1\],ibuf);$|	ibuf = fopen(argv[1],"r");|' \
    -e 's|^	if(ifile < 0)err("open",argv\[1\]);$|	if(ibuf == 0)err("open",argv[1]);|' \
    -e 's|write(ofile,&i,2)|write(ofile,\&i,sizeof(i))|g' \
    -e 's|write(ofile,&xtab.ssiz,2)|write(ofile,\&xtab.ssiz,sizeof(xtab.ssiz))|g' \
    -e 's|^	i = 2\*xtab.hsiz;$|	i = sizeof(*xtab.hptr)*xtab.hsiz;|' make.c > m$$ && mv m$$ make.c

# ex HAS NO libpath, AND THAT IS THE WHOLE OF `ex3 undefined'.  ex_tune.h:13
# takes "local/uparm.h" and :14-15 are
#	#define	EXRECOVER	libpath(ex3.7recover)
#	#define	EXPRESERVE	libpath(ex3.7preserve)
# but /usr/include/local/uparm.h is two lines long and defines usrpath, not
# libpath:
#	#define E_TERMCAP	"/etc/termcap"
#	#define usrpath(file) "/usr/file"
# so libpath stays a bare identifier, ex3 is an undefined name and .7recover
# lexes as a floating constant -- `saw FCON' -- which is exactly what ex.c:272
# and :273 report.  usrpath is the idiom to copy: this cpp substitutes a macro
# parameter INSIDE a string literal, which is how exrecover.c and expreserve.c
# already get their /usr/preserve paths, and ex_tune.h:10-11 says which prefix
# libpath carries -- "if you give /usr/lib/... here, /lib will be tried only
# for strings".  Defined in ex_tune.h rather than in uparm.h because ex is the
# only thing on the tapes that wants the macro: cmd/prefer has a C FUNCTION of
# that name, unrelated, and lbin/mailx is not built.
cd $SRC/cmd/ex || exit 1
if grep 'ipnx libpath' ex_tune.h > /dev/null
then	:
else
	sed 's|^#include "local/uparm.h"$|#include "local/uparm.h"\
#define	libpath(file) "/usr/lib/file"	/* ipnx libpath -- see PATCHES.md */|' ex_tune.h > e$$ && mv e$$ ex_tune.h
fi

# ostdio's mkfile reads doprnt.S AND THAT IS THE RIGHT NAME HERE.  THIS LINE IS
# NOW ONLY A REPAIR FOR DAMAGE ALREADY DONE, kept because patch edits the source
# tree in place and /usr/src survives between builds -- a tree that saw the
# earlier pass still holds the wrong name and nothing else takes it back out.
# On a tree that never saw it the substitution finds nothing and changes nothing.
#
# The cause is gone.  The old rule for case collisions was lowercase-wins, which
# renamed doprnt.S -- the one spelling olibcmkfile:123 actually reads -- and left
# doprnt.s holding the name.  Rule 0 in ./casenames reverses that: the survivor
# is whatever the directory's own build file names, mkv10 applies the table when
# it lays the tapes down, and the repository now holds doprnt.S and u_doprnt.s
# the same way the guest does.  Nothing renames the name the build reads again.
cd $SRC/libc/stdio/ostdio || exit 1
sed 's|u_doprnt.S|doprnt.S|' mkfile > o$$ && mv o$$ mkfile

# oops IS 4BSD ps -- oops.c:1 is `@(#)ps.c 4.13 (Berkeley) 81/07/08' -- and
# DMMAX IS THE ONE THING IT WANTS THAT v10 DOES NOT HAVE.  The name occurs at
# oops.c:854 and NOWHERE else in usr/include, lsys or usr/src.  Berkeley's
# vmparam.h carries DMMIN and DMMAX together; v10's keeps only DMMIN (:65,
# `#define DMMIN 32') because it made the pair RUNTIME VARIABLES:
# sys/dmap.h:16-17 is
#	extern int dmmin;		/* size in clicks of dm_map[0] */
#	extern int dmmax;		/* max size of swap alloc, in clicks */
# md/machdep.c:204 defines them, `int dmmin, dmmax, dmtext;', and :223-244
# computes dmmax at boot -- "dmmax == first power of 2 larger than
# max?size/(NDMAP-1)" -- from the swap configuration.  vm/vmdrum.c:64,87 is
# the same walk oops does, `register int blk = dmmin' ... `if (blk < dmmax)'.
#
# So there is no constant to supply: a hardcoded 1024 would be wrong on any
# machine whose swap is not Berkeley's size.  oops already reads _nswap,
# _maxslp, _ccpu, _ecmx, _nproc, _ntext and _hz out of the kernel by nlist, so
# _dmmax joins them and the loop reads the variable.  DMMIN is left alone --
# machdep.c:225 is `dmmin = DMMIN', so the constant and the variable agree.
cd $SRC/cmd/oops || exit 1
if grep 'ipnx dmmax' oops.c > /dev/null
then	:
else
	sed -e 's|^	{ "_hz" },$|	{ "_dmmax" },\
#define	X_DMMAX		10	/* ipnx dmmax -- see PATCHES.md */\
	{ "_hz" },|' \
	    -e 's|^#define	X_HZ		10$|#define	X_HZ		11|' \
	    -e 's|^int	nproc, ntext, hz;$|int	nproc, ntext, hz;\
int	dmmax;		/* ipnx dmmax -- read from the kernel, see PATCHES.md */|' \
	    -e 's|^	KMlseek(kmem, (long)nl\[X_MAXSLP\].n_value, 0);$|	KMlseek(kmem, (long)nl[X_DMMAX].n_value, 0);\
	if (read(kmem, \&dmmax, sizeof (dmmax)) != sizeof (dmmax)) {\
		cantread("dmmax", kmemf);\
		exit(1);\
	}\
	KMlseek(kmem, (long)nl[X_MAXSLP].n_value, 0);|' \
	    -e 's|^		if (blk < DMMAX)$|		if (blk < dmmax)|' oops.c > o$$ && mv o$$ oops.c
fi

# pascal/eyacc/ey3.c IS BERKELEY 4.1 AND ITS CASTS PREDATE THE TYPES.  Nine
# errors, one per site, and every one is a pointer written as an int or a cast
# that names a type nothing declares.  ey3.c:32 is
#	pfirst = (looksets ***)yalloc(nnonter+1);
# where ey0.c:66 is `struct looksets **pfirst' -- no typedef of that name
# exists anywhere, so `looksets' is an undefined identifier AND the cast has one
# star too many.  Berkeley's own 5.1 of the same file (4/29/85) writes it
# `(struct looksets **)', and corrects the other eight the same way; only those
# eight are taken here, and a ninth below.  5.1 also renames aryfil, resizes
# pempty and adds a lambdarule, which are later behaviour and no business of
# this tape.
#
# THE NINTH IS A PRECEDENCE BUG AND IT IS THE ONE THAT FAULTS.  ey3.c:14 is
#	if (*prdptr[j] == c) *mem++ =  (int)prdptr[j]+1;
# and prdptr is `int *prdptr[]' (ey0.c:36), so `(int)prdptr[j]+1' casts first
# and adds ONE BYTE.  5.1 writes `(int)(prdptr[j]+1)', which advances one int.
# What goes into mem is read back through pres[] as an `int **' (:11,:19) and
# dereferenced at :36, so a one-byte offset is a misaligned word: eyacc
# compiled, ran, and took a memory fault on pas.y.  It is the only occurrence
# of the shape in either eyacc or pi.
#
# The types they are cast to, each from its own declaration:
#   ey.h:29   struct item { int *pitem; struct looksets *look; }  -- so one
#             `int s' cannot hold both k->pitem and k->look
#   ey0.c:31  int *mem                 -- pstate is struct item *[] (ey0.c:25)
#   ey0.c:67  int *pempty              -- and ey.h never declares yalloc, so it
#             defaults to int; ey1.c:282 is `int *yalloc(n)'
#   ey0.c:30  int mem0[]               -- jip-mem0 needs jip an int *
cd $SRC/cmd/pascal/eyacc || exit 1
sed -e 's|^		if (\*prdptr\[j\] == c) \*mem++ =  (int)prdptr\[j\]+1;$|		if (*prdptr[j] == c) *mem++ =  (int)(prdptr[j]+1);|' \
    -e 's|^  pfirst = (looksets \*\*\*)yalloc(nnonter+1);$|  pfirst = (struct looksets **)yalloc(nnonter+1);|' \
    -e 's|^	int s,size1,size2;$|	int *s,size1,size2;\
	struct looksets *lp;|' \
    -e 's|^			s = k->look;$|			lp = k->look;|' \
    -e 's|^			l->look = s;$|			l->look = lp;|' \
    -e 's|^	struct item \*i, \*j, \*jip;$|	struct item *i, *j;\
	int *jip;|' \
    -e 's|^	jip = j;$|	jip = (int *)j;|' \
    -e 's|^  pempty = yalloc( nnonter );$|  pempty = (int *)yalloc( nnonter );|' \
    -e 's|^  pstate\[0\] = pstate\[1\] = mem;$|  pstate[0] = pstate[1] = (struct item *)mem;|' ey3.c > e$$ && mv e$$ ey3.c

# PASCAL CALLS chown AND chgrp TOO, in five of its seven subdirectories --
# eyacc, libpc, pi, px and pxp, eleven lines between them -- and in
# pascal/install.sh, whose ch() is `chown bin,bin $1'.  Same fault and same
# answer as the PostScript note above: v10 has no chgrp at all and its chown is
# /etc/chown, which make cannot exec by that name.  Its build is a shell loop
# over the seven (`for i in eyacc libpc pc0 pascal pi px pxp'), so the first
# one to reach an install would stop it.  pc0 and pascal have neither in their
# makefiles, and sed over a file with neither is a no-op, so the loop covers
# all seven -- every one is a lowercase `makefile' -- and install.sh with it.
# THE TOP-LEVEL ONE IS `Makefile', CAPITAL M, and it is the only one in the
# whole pascal tree that is -- which is why `*/makefile' caught the seven and
# missed this one.  It is the file that HOLDS that loop, at :25, and it calls
# chown and chgrp itself two lines later:
#	install:
#		for i in $(DIRS); do (cd $$i; echo ==$$i; make -o; make -o install); done
#		rm -f $B/pascal
#		cp pascal.sh $B/pascal
#		chown bin $B/pascal
#		chgrp bin $B/pascal
# so every subdirectory installs and then the last three lines stop the build
# with `Make: Cannot load chown'.  git records the case the tape cut, which is
# how this was settled: a case-insensitive host cannot tell the two apart, and
# there is no u_Makefile beside it, so the tape carries exactly one name.
cd $SRC/cmd/pascal || exit 1
# pascal/pascal/makefile:9 is `./install.sh $D $L'.  make execs the command
# itself rather than handing the line to a shell -- the same behaviour the
# chgrp note above records, `Make: Cannot load chown' -- so a script named on
# its own answers `Make: Cannot load ./install.sh.  Stop.'.  Naming the shell
# is the whole fix.
sed 's|^	./install.sh |	sh install.sh |' pascal/makefile > p$$ && mv p$$ pascal/makefile

# pi/makefile:14 is `TMPDIR = tmp' and :63-67 run mkstr through it --
#	${RM} ${TMPDIR}/$*.c
#	${MKSTR} - ${ERRORSTRINGS} ${TMPDIR}/ $*.c
#	cd ${TMPDIR} ; ${CC} ${CFLAGS} -I.. -c $*.c
# -- but the directory is on no tape, and its own `clean' only removes
# ${TMPDIR}/*.c, so nothing ever creates it.  mkstr then answers
# `tmp/case.c: No such file or directory'.  pi is the only one of the seven
# with a TMPDIR.
test -d pi/tmp || mkdir pi/tmp

for f in Makefile */makefile */mkfile pascal/install.sh
do
	sed -e 's|chgrp |: |g' -e 's|chown |: |g' $f > c$$ && mv c$$ $f
done

# sys/types.h HAS NO INCLUDE GUARD, and four commands have now tripped over it:
# toplev.c, renice.c and dipconfig.c each got a per-file workaround above, and
# limiter is the fourth.  The fault is always the same -- some header pulls
# types.h and then the source pulls it again, and every typedef in it reads as
# a redeclaration:
#     "/usr/include/sys/types.h":33:illegal type combination
#     "/usr/include/sys/types.h":63:redeclaration of fd_set from some line 63
# sys/param.h:131 is the usual first path, `#include "sys/types.h"', unguarded.
#
# _TYPES_ IS THE NAME THE TAPE ITSELF EXPECTS.  cmd/gcc/toplev.c:42 is
# `#ifndef _TYPES_' guarding its own second include -- that source was written
# against a types.h which defined it, and v10's does not.  Supplying it makes
# toplev.c's own guard work as its author intended and closes the whole class,
# so no fifth command has to be found and worked around one at a time.  The
# per-file repairs above are left where they are: each is correct on its own
# and a guarded header makes them harmless rather than wrong.
#
# ONE COPY NOW.  /usr/include IS the living tree under the tar-of-/usr shape
# -- the $INC install rule dissolved with the move back -- so the header the
# compiler reads is the one edited here.  (This loop once guarded both the
# source-tree copy and the installed copy; there is only one.)
for t in $ROOT/usr/include/sys/types.h
do
	if grep '_TYPES_' $t > /dev/null
	then	:
	else
		echo '#ifndef	_TYPES_		/* ipnx guard -- see PATCHES.md */' > t$$
		echo '#define	_TYPES_' >> t$$
		cat $t >> t$$
		echo '#endif	/* _TYPES_ */' >> t$$
		mv t$$ $t
	fi
done

# pi/case.c KEEPS ITS PARSE TREE IN AN int *, and v10's ccom will not assign
# between that and a struct pointer.  Twenty-three errors, every one a call to
# ccom/common/trees.c:981's combo() -- "illegal pointer combination" and
# "illegal pointer/integer combination" -- plus the two that follow from them,
# `range needs reference to struct/union'.  The types, each from its own
# declaration in case.c:27-36 and 0.h:
#   p     struct nl *      cl, cs   int * (cs by implicit int)
#   ctab  struct ct *      i        int
#   brtab short *          brtab0, csend, lc (0.h:707)  char *
# and r, the argument, is int *, so r[3] and cl[1] and cs[2] are PLAIN INTS
# holding tree pointers.  malloc and getlab (put.c:726) are declared nowhere,
# so both default to returning int.
#
# 4.4BSD's answer to this file was to retype the whole tree -- tree_ty.h,
# WHI_CAS, NLNIL, typed nodes -- which is a different compiler, not a repair.
# The casts below say the same thing about this one, in the same style as the
# eyacc note above, and change no behaviour: every one is the identity on a
# vax, where a pointer and an int are both 32 bits.  cl is left an int *,
# which is what it is for most of the function; its four uses as a struct nl *
# are cast at the point of use rather than given a second variable.
cd $SRC/cmd/pascal/pi || exit 1
sed -e 's|^			cl = p;$|			cl = (int *)p;|' \
    -e 's|^				cl = p->type;$|				cl = (int *)p->type;|' \
    -e 's|^				low = cl->range\[0\];$|				low = ((struct nl *)cl)->range[0];|' \
    -e 's|^				high = cl->range\[1\];$|				high = ((struct nl *)cl)->range[1];|' \
    -e 's|for (cl = r\[3\]; cl != NIL; cl = cl\[2\])|for (cl = (int *)r[3]; cl != NIL; cl = (int *)cl[2])|g' \
    -e 's|^		cs = cl\[1\];$|		cs = (int *)cl[1];|' \
    -e 's|for (cs = cs\[2\]; cs != NIL; cs = cs\[2\])|for (cs = (int *)cs[2]; cs != NIL; cs = (int *)cs[2])|g' \
    -e 's|^	ctab = i = malloc(n \* sizeof \*ctab);$|	ctab = (struct ct *)(i = malloc(n * sizeof *ctab));|' \
    -e 's|^		brtab = brtab0 = lc;$|		brtab = (short *)(brtab0 = lc);|' \
    -e 's|^	csend = getlab();$|	csend = (char *)getlab();|' case.c > c$$ && mv c$$ case.c

# pi REACHES struct nl's UNION MEMBERS BY BARE NAME, which is pre-K&R C: in
# that language a member name was a global offset, so `p->range[0]' worked on
# any pointer.  v10's ccom checks membership and answers `range not in this
# struct/union'.  0.h:244-263 nests all five inside one union:
#	union {
#		struct { int value[5]; } vals;
#		struct { double real; } reals;
#		struct { long range[2]; } rngs;
#		struct { int *ptr[4]; int entloc; } ptrs;
#	} u;
# so each needs its path.  214 uses across 21 files, and the substitution is
# safe to make blind: no other struct in pi declares any of the five names,
# nothing uses them as a member with a prefix (->ranges, ->values and so on do
# not occur), and there are no dot-form uses at all -- every one is written
# with the arrow, some of them spaced as `p -> range[0]'.
#
# BERKELEY'S OWN ANSWER WAS THE SAME PATHS BEHIND MACROS.  4.4BSD's 0.h:287-291
# is `#define range nl_un.un_range' and four more like it, which is why its
# case.c:103 still reads `cl->range[0]'.  Macros are not used here because
# put.c:601 and p2put.c:274 both take a parameter called `value' and both
# include 0.h, so `#define value' would rewrite their declarations.  The paths
# go in at the point of use instead, where nothing else can see them.
# ELEVEN FUNCTIONS THAT RETURN A POINTER ARE NOT DECLARED.  0.h:718-744 is a
# block of exactly these declarations -- `struct nl *lookup();', `char
# *savestr();', twenty-seven of them -- and eleven more are missing, so every
# call to one defaults to int and every assignment of the result to a pointer
# is an error.  The eleven, each with the type its own definition gives it, go
# in beside the others rather than being cast at each of their call sites.
cd $SRC/cmd/pascal/pi || exit 1
if grep 'ipnx decls' 0.h > /dev/null
then	:
else
	sed 's|^struct nl	\*asgnop1();$|struct nl	*asgnop1();\

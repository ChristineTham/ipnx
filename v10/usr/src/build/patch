# SEVENTEEN OF pi's SOURCES WERE NEVER CHECKED BY THE PASS ABOVE.  Every file
# that includes yy.h -- error, hash, main, yycopy, yycosts, yyerror, yyget,
# yyid, yylex, yymain, yyoptions, yypanic, yyparse, yyprint, yyput, yyrecover,
# yyseman -- includes y.tab.h through it, and y.tab.h does not exist until
# eyacc has run on pas.y.  A checking compiler stops at the missing include
# and reports nothing else, so those seventeen came back clean without a line
# of them being looked at, and the pass "converged" on two thirds of pi.  The
# rerun that produced this block synthesised y.tab.h from pas.y's own %term
# list and staged usr/include/a.out.h, which is what yymain.c wants.
#
# WHAT ccom ACTUALLY CHECKS, from its own table.  trees.c:208 is the only call
# to chkpun -- `if( (actions&PUN) && (o!=CAST||cflag) )' -- and opact sets PUN
# for ASSIGN and RETURN (:1845-1849), for COLON (:1829-1833), for MINUS on two
# pointers (:1879), and for EQ NE LT LE GT GE (:1815-1818).  So COMPARISONS
# ARE CHECKED TOO, which the earlier note did not say; hash.c:168 and
# yylex.c:93 both bound an `int *' against the keyword table and against
# lastkey, and each is three pointer types in one expression.
# int * against long * stays dropped: the machine compiled conv.c with
# `long *lp = dub;' and dub an int *, which is the answer whatever the table
# reads like.

# nl_block IS NOT A MEMBER -- IT WAS RENAMED nl_flags.  0.h:238 is
# `char class, nl_flags;' and 0.h:271-275 says the low 5 bits of that byte
# "are the nl_block", with BLOCKNO() at 0.h:277 as the accessor.  Eleven uses
# of the old name survived the rename, five of them live and six behind
# `#ifdef PC', which pi does not define -- which is why only five of the
# eleven showed up as errors.  Every one is `& 037' or BLOCKNO(), the low five
# bits, and the single assignment (nl.c:685, `p->nl_block = cbn') is safe as a
# whole-byte store because defnl has just zeroed the entry three lines above.
# forop.c:256 is the tape's own `forvar -> nl_flags = cbn;' -- the identical
# assignment already written in the new name, which settles it.  The comment
# at forop.c:248 keeps the old word: it is describing the concept, not a
# member, so the substitution is on the arrow forms only.
cd $SRC/cmd/pascal/pi || exit 1
for f in *.c
do
	sed 's|-> *nl_block|->nl_flags|g' $f > z$$ && mv z$$ $f
done

# BADUSE ENTRIES CHAIN A struct udinfo OFF nl.chain, which is declared
# `struct nl *chain' (0.h:241).  yyid.c:102-105 is the whole mechanism --
# `udp = esavestr(&ud); udp->ud_line = line; udp->ud_next = p->chain;
# p->chain = udp;' -- so the list hanging off chain is udinfo (0.h:679-683),
# not nl, and the two readers of it ask for ud_next and ud_line by name.
# Pre-K&R C let them: the member was a global offset.  Casts go at the two
# reads and at the two writes that build the list.
sed \
    -e 's|^					if (p->chain->ud_next == NIL)$|					if (((struct udinfo *)p->chain)->ud_next == NIL)|' \
    fend.c > z$$ && mv z$$ fend.c
sed \
    -e 's|^	if (p->chain != NIL \&\& p->chain->ud_line == line)$|	if (p->chain != NIL \&\& ((struct udinfo *)p->chain)->ud_line == line)|' \
    -e 's|^	udp->ud_next = p->chain;$|	udp->ud_next = (struct udinfo *)p->chain;|' \
    -e 's|^	p->chain = udp;$|	p->chain = (struct nl *)udp;|' \
    yyid.c > z$$ && mv z$$ yyid.c

# FOUR MORE int * VARIABLES REACHED AS struct nl *, cast at the use as cl was
# in case.c above rather than given a second variable.  proc.c's `al' is the
# clearest: above the packunp: label it walks the parse tree as argv[2], al[1],
# al[2]; below it, from `al = stklval(...)' at :1024 onwards, it is only ever
# an nl -- class, type, chain, u.rngs.range.  fhdr.c:209 and proc.c:859 index
# u.ptrs.ptr[], which 0.h:259 declares `int *ptr[4]' though every slot holds an
# nl; rec.c's `vr' (rec.c:115) takes tyrec1's return.
sed \
    -e 's|^		    p->u\.ptrs\.ptr\[NL_FVAR\]->u\.vals\.value\[NL_LINENO\] = r\[1\];$|		    ((struct nl *)p->u.ptrs.ptr[NL_FVAR])->u.vals.value[NL_LINENO] = r[1];|' \
    fhdr.c > z$$ && mv z$$ fhdr.c
sed \
    -e 's|(ap->u\.ptrs\.ptr\[NL_TAG\])->type|((struct nl *)ap->u.ptrs.ptr[NL_TAG])->type|' \
    -e 's|^		if (al->class != ARRAY) {$|		if (((struct nl *)al)->class != ARRAY) {|' \
    -e 's|^		if (al->type == NIL \|\| ap->type == NIL)$|		if (((struct nl *)al)->type == NIL \|\| ap->type == NIL)|' \
    -e 's|^		if (al->type != ap->type) {$|		if (((struct nl *)al)->type != ap->type) {|' \
    -e 's|^		al = al->chain;$|		al = (int *)((struct nl *)al)->chain;|' \
    -e 's|^		if (ap->chain != NIL \|\| al->chain != NIL) {$|		if (ap->chain != NIL \|\| ((struct nl *)al)->chain != NIL) {|' \
    -e 's|^		j = al->u\.rngs\.range\[1\] - al->u\.rngs\.range\[0\] + 1;$|		j = ((struct nl *)al)->u.rngs.range[1] - ((struct nl *)al)->u.rngs.range[0] + 1;|' \
    proc.c > z$$ && mv z$$ proc.c
sed \
    -e 's|^		if (vr->u\.vals\.value\[NL_OFFS\] > p->u\.vals\.value\[NL_OFFS\])$|		if (((struct nl *)vr)->u.vals.value[NL_OFFS] > p->u.vals.value[NL_OFFS])|' \
    -e 's|^			p->u\.vals\.value\[NL_OFFS\] = vr->u\.vals\.value\[NL_OFFS\];$|			p->u.vals.value[NL_OFFS] = ((struct nl *)vr)->u.vals.value[NL_OFFS];|' \
    rec.c > z$$ && mv z$$ rec.c

# 0.h:761-772 DECLARES FOUR ANONYMOUS STRUCTS WHOSE ONLY PURPOSE IS THEIR
# MEMBER NAMES -- `struct { char pchar; };', pint, plong, pdouble, each its
# sole member and so each at offset 0, under the tape's own heading "pointers
# in wild and wooly ways".  They are the pre-K&R global offset used
# deliberately: `f.plong' on a double is "the first four bytes of f as a
# long", `sym->pchar' on an int * is "the first byte".  There is no struct to
# name, so a path cannot be given as it was for the nl union; the reads become
# what they always compiled to.  hash.c:170 also calls strcmp(sym, cp), which
# ccom does not check -- it has no prototypes.
sed \
    -e 's|^			if (sym->pchar == \*cp \&\& strcmp(sym, cp) == 0)$|			if (\*(char \*)sym == \*cp \&\& strcmp(sym, cp) == 0)|' \
    hash.c > z$$ && mv z$$ hash.c
for f in rval.c stkrval.c
do
	sed 's|^					    l = f\.plong;$|					    l = *(long *)\&f;|' $f > z$$ && mv z$$ $f
done

# AND THE ASSIGNMENT CASTS FOR THE SEVENTEEN, generated the same way as the
# block above and by the same rule -- assignment, initialisation and now
# comparison, int * against long * dropped -- rerun until it found nothing.
sed \
    -e 's|^char	\*lastkey	= &yykey\[sizeof yykey/sizeof yykey\[0\]\];$|char	*lastkey	= (char *)\&yykey[sizeof yykey/sizeof yykey[0]];|' \
    -e 's|^	for (ip = yykey; \*ip; ip += 2)$|	for (ip = (int *)yykey; *ip; ip += 2)|' \
    -e 's|^		hash(ip\[0\], 0)\[0\] = ip;$|		hash(ip[0], 0)[0] = (int)ip;|' \
    -e 's|^			htp->ht_low = cp;$|			htp->ht_low = (int *)cp;|' \
    -e 's|^					\*h = s;$|					*h = (int)s;|' \
    -e 's|^			sym = \*h;$|			sym = (int *)*h;|' \
    -e 's|^			if (sym < lastkey && sym >= yykey)$|			if (sym < (int *)lastkey \&\& sym >= (int *)yykey)|' \
    -e 's|^				sym = \*sym;$|				sym = (int *)*sym;|' \
    hash.c > z$$ && mv z$$ hash.c
sed \
    -e 's|^	register int	\*r0 = & OY;$|	register int	*r0 = (int *)\& OY;|' \
    -e 's|^	register int	\*r1 = & Y;$|	register int	*r1 = (int *)\& Y;|' \
    yycopy.c > z$$ && mv z$$ yycopy.c
sed \
    -e 's|^	cp = skipbl(cp);$|	cp = (char *)skipbl(cp);|' \
    -e 's|^	ip->Printed = printed;$|	ip->Printed = (int)printed;|' \
    -e 's|^		printed = ip->Printed;$|		printed = (char *)ip->Printed;|' \
    yyget.c > z$$ && mv z$$ yyget.c
sed \
    -e 's|^struct	udinfo ud = { ~0 , ~0 , 0};$|struct	udinfo ud = { ~0 , (struct udinfo *)~0 , 0};|' \
    -e 's|^	udp = esavestr(&ud);$|	udp = (struct udinfo *)esavestr(\&ud);|' \
    yyid.c > z$$ && mv z$$ yyid.c
sed \
    -e 's|^			ip = hash(0, 1);$|			ip = (int **)hash(0, 1);|' \
    -e 's|^			if (\*ip < yykey \|\| \*ip >= lastkey) {$|			if (*ip < (int *)yykey \|\| *ip >= (int *)lastkey) {|' \
    -e 's|^				yylval = \*ip;$|				yylval = (int)*ip;|' \
    yylex.c > z$$ && mv z$$ yylex.c
sed \
    -e 's|^	unsigned	\*ubuf = buf;$|	unsigned	*ubuf = (unsigned *)buf;|' \
    yymain.c > z$$ && mv z$$ yymain.c
sed \
    -e 's|^	\*++yypv = yyval;$|	*++yypv = (int)yyval;|' \
    -e 's|^			yyval = yylval;$|			yyval = (int *)yylval;|' \
    -e 's|^			yyval = yypv\[1\];$|			yyval = (int *)yypv[1];|' \
    yyparse.c > z$$ && mv z$$ yyparse.c
sed \
    -e 's|^			cp = tp->Yylval;$|			cp = (char *)tp->Yylval;|' \
    yyprint.c > z$$ && mv z$$ yyprint.c
sed \
    -e 's|^		bp = tree(6, T_BOTTLE, yyline, yylinpt, filename, yyseqid);$|		bp = (struct B *)tree(6, T_BOTTLE, yyline, yylinpt, filename, yyseqid);|' \
    yyput.c > z$$ && mv z$$ yyput.c
sed \
    -e 's|^			ps = loccor(ps, &ntok);$|			ps = (int *)loccor(ps, \&ntok);|' \
    -e 's|^			ps = loccor(ps, &YC\[origin++\]);$|			ps = (int *)loccor(ps, \&YC[origin++]);|' \
    yyrecover.c > z$$ && mv z$$ yyrecover.c

# malloc IS NOT DECLARED, AND THE CHECKING PASS COULD NOT SEE IT.  0.h:718-744
# declares tmpalloc, alloc, calloc and savestr but not malloc, so on this
# machine it returns int and `cp = malloc(...)' with cp a char * is
# trees.c:928's combo("pointer/integer").  The host compiler used for the pass
# above declares malloc itself -- as a BUILTIN, so even -nostdinc keeps it --
# and char * = void * is perfectly legal there, so all four sites came back
# clean.  Rerun with -fno-builtin and against v10's own usr/include instead of
# the host's, which is what the guest actually compiles against, and the four
# appear -- along with nothing else, and with const.c, getline, sys_errlist
# and clock dropping out as the host artefacts they were.
# THE CAST IS THE TAPE'S OWN: subr.c:108 is `if ((p1 = (int)malloc(nbyte)) ==
# 0)', hash.c:138 is `cp = (char *) calloc(...)', case.c:84 and pccaseop.c:131
# both cast too.  These four are the ones that were missed.
cd $SRC/cmd/pascal/pi || exit 1
sed \
    -e 's|^		cp = malloc(NLINC \* sizeof \*nlp);$|		cp = (char *)malloc(NLINC * sizeof *nlp);|' \
    -e 's|^			cp = malloc((NLINC / 2) \* sizeof \*nlp);$|			cp = (char *)malloc((NLINC / 2) * sizeof *nlp);|' \
    nl.c > z$$ && mv z$$ nl.c
sed \
    -e 's|^		strngp = malloc(STRINC);$|		strngp = (char *)malloc(STRINC);|' \
    string.c > z$$ && mv z$$ string.c
sed \
    -e 's|^		cp = malloc(i \* sizeof ( int ));$|		cp = (char *)malloc(i * sizeof ( int ));|' \
    tree.c > z$$ && mv z$$ tree.c

# AND THE REPAIR FOR nl.c:735.  The guest's /usr/src persists between builds,
# so an earlier run of this script has already rewritten that line in place --
# to `p = (int *)p2 = (struct nl *)defnl(...)', an lvalue cast, which this
# compiler parses and then rejects twice, once per assignment.  The sed at the
# top of this file matches the tape's form and so no longer fires there;
# a bad edit has to be repaired, not merely stopped.  Both patterns lead to
# the same line and neither matches it, so this stays idempotent.
sed \
    -e 's|^	p = (int \*)p2 = (struct nl \*)defnl(0, 0, 0, 0);$|	p = (struct nl *)(p2 = (int *)defnl(0, 0, 0, 0));|' \
    nl.c > z$$ && mv z$$ nl.c

# pas.y's ACTIONS ARE THE LAST OF pi, AND THEY ARE NOT A FILE ON DISK.  eyacc
# turns pas.y into y.tab.c and `ex - y.tab.c <gram' then rewrites it, so a sed
# on y.tab.c would be undone by the next build; the repair belongs in pas.y and
# in 0.h.  gram's FIRST command is `/yyval/s//*&/', which retypes yacc's
# `int yyval;' to `int *yyval;', and its append after the yyactr line gives
# `register int **yyYpv;' with `yyYpv = yypv;' -- so in every action $$ is an
# `int *' and $n is `yyYpv[n]', also an `int *', while $n[k] is a plain int.
# ## sits at pas.y:99 and gram deletes through it, so y.tab.c:1 is pas.y:100.
#
# TWELVE MORE UNDECLARED POINTER FUNCTIONS, found by rebuilding the action
# function from pas.y with gram's two substitutions applied and #line back to
# pas.y.  treen.c's tree1..tree5 CARRY NO return STATEMENT AT ALL -- each just
# calls tree(1..5, ...) and falls off the end, which works because pcc leaves
# the callee's value in r0 and the caller reads r0 -- and tree.c:70 is
# `int *tree(cnt, a)', so that is what they return.  0.h:724 already declares
# `int *tree();' beside them.  newlist, addlist, fixlist, setupvar, setuptyrec
# and setupfield (yytree.c:51-154) return tree3/tree4/tree5 results or an
# `int *' local; funcbody (fdec.c:82) takes and returns a `struct nl *'.
# Together they account for sixty of the seventy-four sites.
# THE GUARD IS A SECOND ONE ON PURPOSE.  The eleven declarations above are
# behind `grep 'ipnx decls' 0.h', which is already true of a guest that has run
# this script before, so adding to that list would never reach it.  This block
# has its own marker and anchors on `int *tree();', which the tape has and the
# first insert does not touch.
cd $SRC/cmd/pascal/pi || exit 1
if grep 'ipnx tree decls' 0.h > /dev/null
then	:
else
	sed 's|^int		\*tree();$|int		*tree();\
int		*tree1();	/* ipnx tree decls -- see PATCHES.md */\
int		*tree2();\
int		*tree3();\
int		*tree4();\
int		*tree5();\
int		*newlist();\
int		*addlist();\
int		*fixlist();\
int		*setupvar();\
int		*setuptyrec();\
int		*setupfield();\
struct nl	*funcbody();|' 0.h > h$$ && mv h$$ 0.h
fi

# AND THE FOURTEEN THAT A DECLARATION CANNOT FIX: three assign a `struct nl *'
# to $$, four assign an integer constant to it -- chkpun exempts only a ZERO
# ICON (trees.c:920-923), so `$$ = T_PDEC' is combo("pointer/integer") -- four
# store an `int *' into $1[3], and three are the T_IF peephole at pas.y:491-501
# reading a tree slot into gram's own p and q.
sed \
    -e 's|^		= \$\$ = funcbody(funchdr(tree5(T_PROG, lineof(\$1), \$2, fixlist(\$4), NIL)));$|		= $$ = (int *)funcbody(funchdr(tree5(T_PROG, lineof($1), $2, fixlist($4), NIL)));|' \
    -e 's|^			\$\$ = funcbody(funchdr(tree5(T_PROG, lineof(\$1), NIL, NIL, NIL)));$|			$$ = (int *)funcbody(funchdr(tree5(T_PROG, lineof($1), NIL, NIL, NIL)));|' \
    -e 's|^		= \$\$ = funchdr(tree5(\$1, lineof(\$5), \$2, \$3, \$4));$|		= $$ = (int *)funchdr(tree5($1, lineof($5), $2, $3, $4));|' \
    -e 's|^		= \$\$ = T_PDEC;$|		= $$ = (int *)T_PDEC;|' \
    -e 's|^		= \$\$ = T_FDEC;$|		= $$ = (int *)T_FDEC;|' \
    -e 's|^			if ((p = \$1) != NIL && (q = p\[1\])\[0\] == T_IFX) {$|			if ((p = $1) != NIL \&\& (q = (int *)p[1])[0] == T_IFX) {|' \
    -e 's|^				q\[4\] = \$2;$|				q[4] = (int)$2;|' \
    -e 's|^		= if ((q = \$1) != NIL && (p = q\[1\]) != NIL && p\[0\] == T_IF) {$|		= if ((q = $1) != NIL \&\& (p = (int *)q[1]) != NIL \&\& p[0] == T_IF) {|' \
    -e 's|^		= \$1\[3\] = fixlist(\$1\[3\]);$|		= $1[3] = (int)fixlist($1[3]);|' \
    -e 's|^		= \$1\[3\] = addlist(\$1\[3\], tree2(T_ARY, fixlist(\$3)));$|		= $1[3] = (int)addlist($1[3], tree2(T_ARY, fixlist($3)));|' \
    -e 's|^		= \$1\[3\] = addlist(\$1\[3\], setupfield(\$3, NIL));$|		= $1[3] = (int)addlist($1[3], setupfield($3, NIL));|' \
    -e 's|^		= \$1\[3\] = addlist(\$1\[3\], tree1(T_PTR));$|		= $1[3] = (int)addlist($1[3], tree1(T_PTR));|' \
    -e 's|^		= \$\$ = OCT;$|		= $$ = (int *)OCT;|' \
    -e 's|^		= \$\$ = HEX;$|		= $$ = (int *)HEX;|' \
    pas.y > z$$ && mv z$$ pas.y

# AND THE DEFINITIONS HAVE TO SAY IT TOO.  ccom has no prototypes, so it does
# not check arguments and does not check `return' either -- func.c compiles
# with seventeen `struct nl *' returns from an int function, and proc.c, rval.c
# and stat.c pass ints to pointer parameters throughout.  But pftn.c DOES
# compare a definition against an earlier declaration, and pftn.c:254 is a
# hard `uerror("redeclaration of %s from some line %d")'.  The eleven
# declarations further up were safe because each took the type its own
# definition already carried; these twelve do not carry one -- treen.c's
# tree1..tree5 have no return statement at all and the six in yytree.c none
# either -- so each definition gets the type it has always returned.  Nothing
# about the generated code changes: a function with no return statement still
# leaves r0 exactly as its callee left it.
sed \
    -e 's|^funcbody(fp)$|struct nl *funcbody(fp)|' \
    fdec.c > z$$ && mv z$$ fdec.c
sed \
    -e 's|^tree1 ( arg1 )$|int *tree1 ( arg1 )|' \
    -e 's|^tree2 ( arg1 , arg2 )$|int *tree2 ( arg1 , arg2 )|' \
    -e 's|^tree3 ( arg1 , arg2 , arg3 )$|int *tree3 ( arg1 , arg2 , arg3 )|' \
    -e 's|^tree4 ( arg1 , arg2 , arg3 , arg4 )$|int *tree4 ( arg1 , arg2 , arg3 , arg4 )|' \
    -e 's|^tree5 ( arg1 , arg2 , arg3 , arg4 , arg5 )$|int *tree5 ( arg1 , arg2 , arg3 , arg4 , arg5 )|' \
    treen.c > z$$ && mv z$$ treen.c
sed \
    -e 's|^newlist(new)$|int *newlist(new)|' \
    -e 's|^addlist(vroot, new)$|int *addlist(vroot, new)|' \
    -e 's|^fixlist(vroot)$|int *fixlist(vroot)|' \
    -e 's|^setupvar(var, init)$|int *setupvar(var, init)|' \
    -e 's|^setuptyrec( line , fldlst )$|int *setuptyrec( line , fldlst )|' \
    -e 's|^setupfield( field , other )$|int *setupfield( field , other )|' \
    yytree.c > z$$ && mv z$$ yytree.c

# THE SEVENTEEN OPERATOR PRODUCTIONS ARE WRITTEN ON ONE LINE, and that is why
# they were missed the first time round.  pas.y:785 is
#	'='	= $$ = T_EQ;
# with the action on the same line as the production, where every other action
# in the file starts its own line with `='.  The pass that found the other
# fourteen split on a leading `=' and so skipped all seventeen of these; they
# came back as y.tab.c:241-257, seventeen consecutive lines, because eyacc
# emits one case per production in order.  Splitting instead on the first `='
# outside a quoted character and outside braces finds 174 actions where the
# first attempt found 157, and the seventeen are the whole difference.
# Each is `$$ = <constant>' and chkpun exempts only a ZERO icon, exactly as
# with T_PDEC and OCT above.
cd $SRC/cmd/pascal/pi || exit 1
sed \
    -e 's|\$\$ = T_EQ;|$$ = (int *)T_EQ;|g' \
    -e 's|\$\$ = T_LT;|$$ = (int *)T_LT;|g' \
    -e 's|\$\$ = T_GT;|$$ = (int *)T_GT;|g' \
    -e 's|\$\$ = T_NE;|$$ = (int *)T_NE;|g' \
    -e 's|\$\$ = T_LE;|$$ = (int *)T_LE;|g' \
    -e 's|\$\$ = T_GE;|$$ = (int *)T_GE;|g' \
    -e 's|\$\$ = T_IN;|$$ = (int *)T_IN;|g' \
    -e 's|\$\$ = T_ADD;|$$ = (int *)T_ADD;|g' \
    -e 's|\$\$ = T_SUB;|$$ = (int *)T_SUB;|g' \
    -e 's|\$\$ = T_OR;|$$ = (int *)T_OR;|g' \
    -e 's|\$\$ = T_MULT;|$$ = (int *)T_MULT;|g' \
    -e 's|\$\$ = T_DIVD;|$$ = (int *)T_DIVD;|g' \
    -e 's|\$\$ = T_DIV;|$$ = (int *)T_DIV;|g' \
    -e 's|\$\$ = T_MOD;|$$ = (int *)T_MOD;|g' \
    -e 's|\$\$ = T_AND;|$$ = (int *)T_AND;|g' \
    pas.y > z$$ && mv z$$ pas.y

# AND y.tab.c:22 IS A LINE gram WRITES ITSELF.  pas.y:22-26 says gram "Loads
# the variable yypv into a register as yyYpv so that the arguments $1, ... are
# available as yyYpv[1] etc", and it does that by appending three lines after
# the yyactr line: `register int **yyYpv;', `register int *p, *q;' and
# `yyYpv = yypv;'.  yyparse.c:15 declares `int *yypv;' -- the stack is an array
# of ints holding tree pointers, which is why yyparse.c:133 reads `yyval =
# yypv[1]' -- while the actions want yyYpv[n] to BE a tree pointer, so gram
# declares the same array as `int **'.  The two views are deliberate and the
# cast is the bridge between them; without it the assignment joining them is
# combo("pointer").  It is the third line gram appends, which lands at
# y.tab.c:22.

# atrun.c:109 CALLS setupshares AND V10 HAS NO FAIRSHARE.  The line is
#	(void)setupshares(stbuf.st_uid, (void (*)())0);
# and libc has no such member -- it was left out by choice, like gets -- so the
# call goes.  atrun keeps setlogname, setupgroups, setgid and setuid on the
# lines around it, which are what it needs to become the submitting user.  The
# whole line is replaced rather than matched on its argument list, because
# `(void (*)())0' is nothing but sed metacharacters.
cd $SRC/cmd/at || exit 1
sed 's|.*setupshares(stbuf.st_uid.*|/* ipnx: no fairshare in v10 -- see PATCHES.md */|' atrun.c > a$$ && mv a$$ atrun.c

# groups.c:10 IS `#include <trace.h>' AND THERE IS NO SUCH HEADER.  The only
# trace.h on the tapes is cmd/trace's, which defines INP, DFL, SPN and the rest
# of that program's opcodes and has nothing to do with this; satisfying the
# include with it leaves `Undefined: _Trace' at the link.  What groups.c wants
# is the tracing macro: its calls are groups.c:98,105,115
#	Trace(("prgr(%d), gid %d\n", n-1, groups[n-1]));
# -- the double-parenthesis form, which exists only for a macro that expands
# either to a printf-style call or to nothing.  groups.c:18 has the flag it
# would test, Traceflag, set by -t.  With tracing compiled out the macro is
# empty, and that is what this substitutes.  charge.c includes it too and is
# not built for other reasons.
cd $SRC/cmd || exit 1
sed 's|^#include[ 	]*<trace.h>|#define Trace(x)|' groups.c > t$$ && mv t$$ groups.c

# at/makefile:8 is `cc -Od2 -o at at.c' with the flag written into the recipe
# rather than taken from CFLAGS, so it cannot be overridden on the command line
# like dc, numdate, ul, pp, compact and style are.  -Od2 reaches as as -d2,
# word displacements, and at.o overflows them.
cd $SRC/cmd/at || exit 1
sed 's|cc -Od2 -o at at.c|cc -O -o at at.c|' makefile > a$$ && mv a$$ makefile

# THERE IS NO chgrp ON THIS SYSTEM.  No cmd/chgrp.c, no chgrp in binfiles or
# etcfiles, no manual page: v10 sets both halves with /etc/chown, which takes
# `owner,group'.  The DWB PostScript package calls chgrp beside every chown in
# twenty-six of its .mk files and make stops at the first one, so each is turned
# into the shell's null command.  chown GOES THE SAME WAY: it is /etc/chown, and
# make answers `Make: Cannot load chown.  Stop.' -- it execs the command itself
# rather than handing the line to a shell that would search /etc.  THE LOOP IS
# OVER EVERY .mk AND NOT A grep: v10's grep is the V7 matcher and has no \|
# alternation, so `grep -l 'chgrp\|chown'' matched nothing and the substitution
# never ran.  sed on a file with neither is a no-op.
cd $SRC/cmd/postscript || exit 1
for f in */*.mk
do
	sed -e 's|chgrp |: |g' -e 's|chown |: |g' $f > c$$ && mv c$$ $f
done

# getpw IS NOT IN THIS LIBC EITHER, for the same reason and with the same
# evidence: no source, no member, and getpwent(3) is the only password manual
# page -- "getpwent, getpwuid, getpwnam, setpwent, endpwent, pwdecode".  Only
# getuid.c calls it, twice, and both times it wants the raw /etc/passwd line,
# because everything downstream is field(buf, n, ':').  So getpw is supplied
# here rather than the callers rewritten: getpwuid gives the struct and this
# puts the seven fields back into the line they came from, in the order
# pwd.h declares them.  It is NOT static -- getuid.c calls it before this
# definition and K&R defaults an undeclared function to extern int, which a
# later `static' would contradict.  The marker in the comment is the guard.
cd $SRC/cmd || exit 1
if grep 'ipnx getpw' getuid.c > /dev/null
then	:
else
	echo '#include <pwd.h>' > g$$
	cat getuid.c >> g$$
	echo '/* ipnx getpw -- see PATCHES.md */' >> g$$
	echo 'getpw(u, b) char *b; {' >> g$$
	echo '	struct passwd *p;' >> g$$
	echo '	if ((p = getpwuid(u)) == 0) return 1;' >> g$$
	echo '	sprintf(b, "%s:%s:%d:%d:%s:%s:%s", p->pw_name, p->pw_passwd,' >> g$$
	echo '		p->pw_uid, p->pw_gid, p->pw_gecos, p->pw_dir, p->pw_shell);' >> g$$
	echo '	return 0; }' >> g$$
	mv g$$ getuid.c
fi

# The libc repairs stage 2 made, parked in work/v10-preserved and reapplied here.
# PATCHES.md, beside this script, has a section per file.  Every one is "a 1993
# ANSI member, converted to K&R" -- not handed to lcc, because lcc's prebuilt
# driver passes -undef to a cpp that rejects it and the member becomes an empty
# object that exits 0.  A loud failure beats a silent hole; docs/v10-bootstrap.md
# :112 measures cc alone after the repairs at 260 of 261 against the tape's own
# cc+lcc mixture at 246.
cd $SRC/libc/gen || exit 1
for f in atof.c malloc.c memmove.c qsort.c
do
	cp $GEN/src/libc/gen/$f $SRC/libc/gen/$f || exit 1
done

cd $SRC/libc/stdio || exit 1
for f in _dtoa.c _fconv.c fconv.h fgets.c fprintf.c fputs.c fscanf.c printf.c rdwr.c scanf.c snprintf.c sprintf.c sscanf.c strtod.c vfprintf.c vfscanf.c vprintf.c
do
	cp $GEN/src/libc/stdio/$f $SRC/libc/stdio/$f || exit 1
done

# stdio/iolib.h has no branch for a v10 VAX: it covers v10-without-stdarg, pANS
# -with-stdarg and SGI, and under the mkfile's own -DV10 va_list is declared only
# when sgi is also defined -- so the nine printf/scanf members failed under both
# compilers.  <shares.h> is on no surviving machine; it was reconstructed from
# the tape's own lnode(5) and checked against Bell Labs' object code, and
# sys/lnode.h with it.
cp $GEN/src/include/shares.h /usr/include/shares.h || exit 1
cp $GEN/src/include/sys/lnode.h /usr/include/sys/lnode.h || exit 1

# /usr/include/stdlib.h has to exist for atof.c: r70 ships it as
# include/CC/stdlib.h, six lines whose body is `#include <libc.h>'.  K&R defaults
# an undeclared function to int, so without it strtod's double would truncate to
# a word and atof would be silently wrong -- worse than a compile error.
test -f /usr/include/stdlib.h || cp /usr/include/CC/stdlib.h /usr/include/stdlib.h || exit 1

# float.h the same way, and for the same reason: stdio/fconv.h:33 includes it,
# and r70 has it only as include/CC/float.h -- there is no top-level copy.
test -f /usr/include/float.h || cp /usr/include/CC/float.h /usr/include/float.h || exit 1

# stdarg.h the same again: stdio/vfprintf.c:5 includes it plainly, and r70
# has only CC/, lcc/, oCC/ and olcc/ copies.  lcc/ is the one this project
# already names -- eight stdio members carry `#include <lcc/stdarg.h>' with
# an ipnx comment -- and the copy must be lcc's so that iolib.h:7's own
# <stdarg.h> sets __STDARG and those eight are guarded out rather than
# redeclaring va_list on top of a differently-guarded CC/ copy.
#
# But lcc's va_arg is the one macro here that lcc's compiler can read and
# this one cannot:
#
#	#define va_arg(list, mode) _littleendian_va_arg(list, mode, 3U)
#
# The U suffix is C89.  pcc2 lexes `3' and then `U' as a name, and says so
# once per va_arg -- `expected operator or ) after expression / saw NAME' at
# every one of the sixteen in vfprintf.c and none of the va_starts.  Only
# vfprintf.c and vfscanf.c ever expand va_arg; the other eight members call
# va_start and hand the list on, which is why this surfaced last.  ~3 aligns
# to four exactly as ~3U does, so dropping the suffix is the whole repair --
# the same kind of de-ANSI-fying as iolib.h:55-56 below.
sed 's|, 3U)|, 3)|' /usr/include/lcc/stdarg.h > /usr/include/stdarg.h || exit 1

# libc/mkfile, repaired, copied rather than sed'd -- the changes are structural.
#
#   The default rule was `cc -O -c $prereq', and forty-four members list a header
#   among their prerequisites -- snprintf.o names stdio/iolib.h -- so cc was
#   handed the .h as a second source file.  The headers are stripped from the
#   argument list, which leaves them doing what they are there for.
#
#   -DV10 goes on that rule: it was in LCCARGS, which only the lcc recipes
#   carried, and snprintf.c and its siblings choose their V10 branch on it --
#   without it, line 22 takes the pANS `FILE *f=sopenw();' path instead.
#
#   The ten lcc recipes are gone, so every member goes through that one rule.
#   docs/v10-bootstrap.md:115: "LIBC_LCC is empty.  lcc must not be reinstated to
#   close a member: its prebuilt driver passes -undef to a cpp that rejects it,
#   so those members become empty objects that exit 0."  libdmalloc.a keeps its
#   own lcc line; it is a separate archive, not a libc member.
#
#   setupshares.o is dropped from $OBJ, so libc.a is 260 members and not 261.
#   gen/setupshares.c:7 includes <sys/share.h> for a struct sh_consts that
#   share(5) does not print, that limits(2) names without a field, and that
#   appears in neither lsys/ nor sys/ -- and setupshares() passes &shconsts to
#   limits(2) L_GETCOSTS, a call that has the KERNEL write through the pointer.
#   A guessed size compiles, links, and overwrites the caller's stack, so the
#   member is left out rather than invented.  The rule stays in the mkfile with
#   the reason beside it.
cp $GEN/src/libc/mkfile $SRC/libc/mkfile || exit 1

# stdio/iolib.h asks for <unistd.h>, which /usr/include has not got.  It is on
# both tapes as cmd/dist/v10/lcc-incl/unistd.h -- lcc's own POSIX set for v10,
# four headers, dirent.h libv.h unistd.h utime.h, none of them in the installed
# include/lcc.  Named by subdirectory rather than put on the include path, for
# the reason PATCHES.md gives for <lcc/stdarg.h>: include/lcc also holds stdio.h,
# string.h and math.h, which would shadow the system headers for every member.
cp $SRC/cmd/dist/v10/lcc-incl/unistd.h /usr/include/lcc/unistd.h || exit 1
cd $SRC/libc/stdio || exit 1
sed 's|^#include <unistd.h>$|#include <lcc/unistd.h>|' iolib.h > i$$ && mv i$$ iolib.h

# The cmd repairs stage 2 made; PATCHES.md has a section on each.
#   cc.c       uses BUFSIZE without including <sys/param.h>
#   fsck.c     `#include <stat.h>' names a header the archive has not
#   mv.c       uses ROOTINO and includes nothing that defines it
#   mkbitfs.c  the BITFS check asks about the wrong machine
#   login.c    a 1993 ANSI member, converted to K&R
cd $SRC/cmd || exit 1
for f in cc.c fsck.c login.c mkbitfs.c mv.c
do
	cp $GEN/src/cmd/$f $SRC/cmd/$f || exit 1
done

# iolib.h:55-56 are ANSI prototypes pcc2 cannot parse -- `char *strerror(int
# errno);' and `int _IO_setvbuf(FILE *);'.  De-prototyped, as everything else in
# this family was.
cd $SRC/libc/stdio || exit 1
sed -e 's|^char \*strerror(int errno);$|char *strerror();|' \
    -e 's|^int _IO_setvbuf(FILE \*);$|int _IO_setvbuf();|' \
    iolib.h > i$$ && mv i$$ iolib.h

# The pANS members want _IOFBF, and /usr/include/stdio.h has _IONBF 04 and
# _IOLBF 0200 but not it.  lcc/stdio.h:4 is `#define _IOFBF 0', which is
# consistent with those two: zero means neither unbuffered nor line-buffered.
if grep _IOFBF /usr/include/stdio.h > /dev/null
then	:
else
	sed 's|^#define	_IONBF	04$|#define	_IOFBF	0\
#define	_IONBF	04|' /usr/include/stdio.h > s$$ && mv s$$ /usr/include/stdio.h
fi

# dipconfig.c and tcpconfig.c reach for ioctl names that v10 moved out of
# <sys/ioctl.h> when it split that header: FIOPUSHLD is in <sys/filio.h>, the
# ENIO* names in <sys/enio.h>, and TCPIOMAXSEG and the IPIO* names in
# <sys/inio.h>.  Neither <sgtty.h>, <sys/ethernet.h> nor <sys/inet/in.h> brings
# any of the three, so every one of those constants is undefined.
#
# dipconfig.c also takes <sys/param.h> and then <sys/types.h>; param.h:131 ends
# with `#include "sys/types.h"' and types.h has no guard, so the typedefs are
# parsed twice -- the same fault as renice.c and toplev.c.  Substituting the
# three headers for that second include fixes both faults in one edit.
cd $SRC/ipc/internet || exit 1
sed 's|^#include <sys/types.h>$|#include <sys/filio.h>\
#include <sys/enio.h>\
#include <sys/inio.h>|' dipconfig.c > d$$ && mv d$$ dipconfig.c
if grep '<sys/inio.h>' tcpconfig.c > /dev/null
then	:
else
	sed 's|^#include <sgtty.h>$|#include <sgtty.h>\
#include <sys/filio.h>\
#include <sys/inio.h>|' tcpconfig.c > t$$ && mv t$$ tcpconfig.c
fi

# scsi.h, THE DEVICE'S PUBLIC HEADER, installed like stdlib.h and float.h above.
# io/scsi.c:18-19 and io/nscsi.c:18-19 both read
#
#	#include "sys/scsi.h"
#	#include	<scsi.h>
#
# and those are two DIFFERENT headers.  sys/scsi.h has the structures -- struct
# scsi, struct bag, struct scsipkt -- and <scsi.h> has the seven command flags,
# SCSI_WR SCSI_RD SCSI_BRESET SCSI_RESET SCSI_SENSE SCSI_LTMOUT SCSI_CERR.
# Without it the compiler reports six undefined names and io.a stops.
#
# scsi(4) IS THE AUTHORITY AND IT IS UNAMBIGUOUS: man4/scsi.4:6 is
# `.B "#include <scsi.h>"' and the page goes on to document SCSI_WR, SCSI_RD,
# SCSI_BRESET and SCSI_RESET as the flags of the write(2) format.  So the angle
# form is the device's documented public header, and r70include simply has not
# got it -- it carries ./sys/scsi.h and no top-level copy.
#
# The only copies on the tapes are cmd/worm/scsi/inc/scsi.h and its oscsi
# neighbour, which are byte-identical; worm is the program scsi(4) is for, and
# the o- prefix is the older tree throughout cmd/, so the plain one is taken.
#
# INSTALLED, NOT EDITED OUT.  An earlier version of this file deleted the angle
# include instead, on the reading that it duplicated the quoted one.  It does
# not, and the deletion is also the wrong SHAPE of repair: patch's edits are
# re-applied to a tree mkimage re-extracts, so every one of them has to be
# idempotent, and a line once removed cannot be removed again.
cp $SRC/cmd/worm/scsi/inc/scsi.h /usr/include/scsi.h || exit 1

# THE FOUR STREAM-HEAD REPAIRS netfs CANNOT RUN WITHOUT.  PATCHES.md:774-841 has
# each one; they are together because they are one file and one failure.
#
#   strdata 512/256 -> 8192/4096.  A netfs reply cannot pass through a 512-byte
#   stream head.
#
#   istread(count == 0) returns at once.  A byte stream never sends the
#   zero-length write that produced Datakit's delimiter, and tsleep's third
#   argument is SECONDS, not ticks (slp.c's own comment), so waiting for one
#   costs thirty of them and then reports failure.
#
#   only HUNGUP ends a read early.  The guard was `nc && (OTHERQ(...)->flag &
#   QDELIM) == 0', which fires only when the downstream read queue advertises
#   delimiters -- a tcp device never does -- so istread returned short the first
#   time a reply spanned two TCP segments.  That is this exact symptom:
#   `neta: read -1 expected 1472' from neta.c:660, after neta.c:653 had already
#   read the reply header successfully.
#
#   bp->rptr += n, and putbq the remainder.  Without it the tail of a block the
#   caller's buffer could not take is discarded.
#
# COPIED, NOT SED'D.  Four edits across fifty lines of C is past what a sed can
# do idempotently, and this is the pattern cc.c, fsck.c, login.c, mkbitfs.c and
# mv.c already use.  The file is the tape's, byte for byte, plus these.
#
# The kernel that reached a login prompt had all four, because it was built from
# a patched lsys; this tree is vanilla, so nothing carries them but this line.
cp $GEN/src/streamio.c $SYS/os/streamio.c || exit 1

# THE KERNEL CONFIGURATION, put where mk.star can find it.  astro/ipnx-v10.m is
# ours and the tapes have no such file, so it travels here like every other
# repair.  The reason has changed and the conclusion has not: mkv10 fills
# src/sys from secombe, and mkv10 moves it out to /usr/sys, where it lives
# under the tar-of-/usr shape ($SYS is /usr/sys again) -- and the
# repository's own v10/usr/src/sys is copied to the guest by nothing at all.
# ipnxorig.tar carries the tapes plus /usr/src/build, and this file is in the
# second half.
#
# The .m is the whole machine description -- mk.star's `%.c.c: $MKDEP %.m' rule
# gives it to mkconf, which writes the C and the assembler the kernel is built
# from -- so this file and lib/tab below are together what makes ipnx-v10 a
# machine rather than a name.
test -d $SYS/astro || exit 1
cp $GEN/src/ipnx-v10.m $SYS/astro/ipnx-v10.m || exit 1

# STREAM PIPES GET THEIR MAJOR.  lib/tab:34 is
#
#	# cdev 18	pt	# remove?
#
# so pt has no major and nothing can open /dev/pt/*, and mkconf rejects the
# config outright: readconf.c:73 makes a name it cannot find in the tab a hard
# error, and astro/ipnx-v10.m declares `pt 64'.  V10 ships the driver --
# io/spipe.c exports spcdev and lib/devs:64 is `pt sp count' -- and V8 runs the
# same driver at the same major (v8/usr/sys/dev/spipe.c, cdevsw 18), which is
# where the count of 64 comes from.  PATCHES.md:289 has the argument.
#
# DERIVED FROM lib/tab, NEVER CARRIED.  A copy of the whole file kept beside
# this one would silently lose whatever the tape gained -- lib/tab is Jun 14
# 1994 and already dropped `ld 20 archosld' and `ld 21 xttyld', both of which
# ipnx-v10.m declares.  One sed, one line, and the other 44 stay the tape's.
#
# sys/mkconf/tab is NOT this file and must not be read as one: mk.star:19 is
# `mkconf -t $LD/tab', so lib/tab is the authority.  mkconf/tab is two days
# newer and does exactly this edit -- somebody was trying our patch in the
# tool's own scratch directory -- but it also comments out `bdev 0 hp', which
# this config needs.
#
# No \t in the replacement: v10's sed writes a literal t, as sh.local.h found.
cd $SYS/lib || exit 1
sed 's|^# cdev 18\(	*pt\)	# remove?$|cdev 18\1|' tab > b$$ && mv b$$ tab

# AND THE DRIVER HAS TO BE IN io.a, which is the other half of the same change.
# io/mkfile's FILES list has no spipe member -- the tape commented the device out
# of lib/tab and left the driver out of the library to match -- so with pt
# configured, mkconf emits the cdevsw reference from lib/devs:64
#
#	pt	sp	count	data struct queue *spipes; inc sys/stream.h;
#
# and the kernel link ends `Undefined: _spcdev'.  spipe.c:15 is
# `struct cdevsw spcdev = cstrinit(&spinfo);' -- the one symbol -- and spipes[]
# and spcnt, which it declares extern, are written by mkconf from the same line.
#
# .x AND NOT .y.  c2's -i is okio(), c21.c:1448: "0->probable I/O space address",
# which stops it optimising a dereference that might be a device register.  Every
# .y in io/mkfile touches registers and every .x does not; spipe.c touches none,
# moving STREAMS queues and blocks in ordinary memory, so it sits with stream.x,
# connld.x and mesg.x.  Placed beside stream.x for the same reason.
cd $SYS/io || exit 1
if grep 'spipe.x' mkfile > /dev/null
then	:
else
	sed 's|\$L(stream\.x)|$L(stream.x) $L(spipe.x)|' mkfile > m$$ && mv m$$ mkfile
fi

# library/makefile:64,65,68 call $(INS) with -m MODE -f DIR -- /etc/install
# is v8/install.sh (this file's own $ETC/install rule), whose whole argument
# parser is `case $1 in -s) ...;; -c) ...;; esac': -m matches neither case,
# so it falls through and runs `mv -m 444 ...', reported back exactly as
# `mv: cannot access -m'.  No V10 tape carries an install(1) source to give
# -m/-f their intended meaning, so the recipe is rewritten with cp and
# chmod, which do what -m 444 and -m 555 asked for without teaching a flag
# to a script that was never V10's own.
cd $SRC/cmd/library || exit 1
# An earlier pass of this file sed'd `makefile' here, which does not exist --
# sed then read its STDIN and the mv left a junk lowercase makefile behind.
# v10's make reads makefile before Makefile (main.c:219-220), so that file
# hides the real one and every target reads as unknown.  It goes.  The test is
# on its CONTENT, not its name: on a case-folding filesystem the two names are
# one file, and an unguarded rm would take the real one with it.
if test -f makefile && grep INSLIB makefile > /dev/null
then	:
else	rm -f makefile
fi
sed 's|$(INS) -m 444 -f $(INSLIB) $(TESTDIR)/$$i|cp $(TESTDIR)/$$i $(INSLIB)/$$i \&\& chmod 444 $(INSLIB)/$$i|' Makefile > l$$ && mv l$$ Makefile
sed 's|$(INS) -m 555 -f $(INSDIR) $(TESTDIR)/library|cp $(TESTDIR)/library $(INSDIR)/library \&\& chmod 555 $(INSDIR)/library|' Makefile > l$$ && mv l$$ Makefile
sed 's|$(INS) -f $(MAN) -m 444 library.1|cp library.1 $(MAN)/library.1 \&\& chmod 444 $(MAN)/library.1|' Makefile > l$$ && mv l$$ Makefile
# Its mkdir branch calls chown and chgrp too (Makefile:60-61), which this
# system has neither of -- the same substitution as the PostScript and pascal
# notes, and the reason is recorded there.
sed -e 's|chgrp |: |g' -e 's|chown |: |g' Makefile > l$$ && mv l$$ Makefile

# xref/lib.a HOLDS PDP-11 OBJECTS.  xref/divide.s is PDP-11 assembly (`jsr
# r5,csv' / `div r3,r0'), and V10's VAX ld reports its archived form as
# "lib.a(ctype.o): too small (old format .o?)" -- the tape's lib.a is a
# PDP-11-era prebuilt, not something this VAX ld can use.  ctype.c, input.c,
# output.c and string.c are present as source and compile clean; only
# divide.s has no VAX equivalent.  output.c:198's only call is
# `divide(&n, base)' inside printn's base-conversion loop, peeling one
# remainder digit off n (an EXPR, defs.h:51's `long') per pass -- exactly
# what C's / and % already do on a machine with hardware long division, so
# a three-line C replacement stands in for the PDP-11 routine.  xrefa and
# xrefb then link the five objects directly and lib.a goes unused.
cd $SRC/cmd/xref || exit 1
# An earlier pass of this file sed'd `makefile' here, which does not exist --
# sed then read its STDIN and the mv left a junk lowercase makefile behind.
# v10's make reads makefile before Makefile (main.c:219-220), so that file
# hides the real one and every target reads as unknown.  It goes.  The test is
# on its CONTENT, not its name: on a case-folding filesystem the two names are
# one file, and an unguarded rm would take the real one with it.
if test -f makefile && grep xrefa makefile > /dev/null
then	:
else	rm -f makefile
fi
if grep 'ipnx divide' divide.c > /dev/null 2>&1
then	:
else
	echo 'divide(np, base)' > d$$
	echo 'long *np;' >> d$$
	echo '{	/* ipnx divide -- see PATCHES.md */' >> d$$
	echo '	int r = *np % base;' >> d$$
	echo '	*np /= base;' >> d$$
	echo '	return r;' >> d$$
	echo '}' >> d$$
	mv d$$ divide.c
fi
# ctype.c:4 is `char	_ctype[] {' -- an initialiser with no `=', the same
# 1970s spelling cref is full of and the same production cgram.y:396-406 has
# not got.  It is the only one in the directory, and there are no `=+' style
# operators here either.
sed 's|^char	_ctype\[\] {$|char	_ctype[] = {|' ctype.c > c$$ && mv c$$ ctype.c

# input.c:41 DECLARES initf's ARGUMENT A FILE, AND IT IS A FILE DESCRIPTOR.
# input.h:8 is `STRUCT fileblk *FILE', so the parameter is a pointer, while
# :22 makes the field it is assigned to `UFD fdes' and defs.h:63 is
# `TYPE int UFD' -- so input.c:45's `f->fdes=fd' is an int taking a pointer,
# which is the one `illegal pointer/integer combination'.  The only call is
# xrefb.c:25, `initf(0)', a descriptor and not a stream.  UFD is the type the
# field already has.
sed 's|^	FILE		fd;$|	UFD		fd;|' input.c > i$$ && mv i$$ input.c

# output.c:47-49 declares print's second argument `INT value', and its body
# reads value.p_expr, value.p_int, value.p_char, value.p_string and
# value.p_real -- output.h:5-13 is `UNION _printf PRINTF' over exactly those
# six members.  An int has no members, which is the five
# `p_xxx needs reference to struct/union'.  PRINTF is the type it is used as.
sed -e 's|^	INT		value;$|	PRINTF		value;|' \
    -e 's|^			s=ecvt(value.p_real, prec, \&decpt, \&n);$|			s=(STRING)ecvt(value.p_real, prec, \&decpt, \&n);|' \
    -e 's|^	REG STRING	timeptr = ctime(\&tvec);$|	REG STRING	timeptr = (STRING)ctime(\&tvec);|' output.c > o$$ && mv o$$ output.c

sed 's|^xrefa:	xrefa.o lib.a$|xrefa:	xrefa.o ctype.o input.o output.o string.o divide.o|' Makefile > m$$ && mv m$$ Makefile
sed 's|^	cc -o xrefa xrefa.o -ll lib.a$|	cc -o xrefa xrefa.o ctype.o input.o output.o string.o divide.o -ll|' Makefile > m$$ && mv m$$ Makefile
sed 's|^xrefb:	xrefb.o lib.a$|xrefb:	xrefb.o ctype.o input.o output.o string.o divide.o|' Makefile > m$$ && mv m$$ Makefile
sed 's|^	cc -o xrefb xrefb.o lib.a$|	cc -o xrefb xrefb.o ctype.o input.o output.o string.o divide.o|' Makefile > m$$ && mv m$$ Makefile

# THE GAMES CAME FROM MACHINES V10 LEFT BEHIND, and each repair below is one
# vintage gap, named.  gets stays deleted (td, 88.11.07, above); the call
# sites get the same fgets idiom as 512restor's.
cd $SRC/games || exit 1
sed -e 's|if(gets(gbuf)==NULL)|if(fgets(gbuf, sizeof gbuf, stdin) == NULL)|' hangman.c > g$$ && mv g$$ hangman.c
sed -e 's|char fid\[100\], rid\[100\], rline\[113\], \*gets(), fname\[100\], buf\[200\],|char fid[100], rid[100], rline[113], fname[100], buf[200],|' \
    -e 's|^	gets(tuid);$|	*tuid = 0; fgets(tuid, sizeof tuid, stdin); tuid[strcspn(tuid, "\\n")] = 0;|' \
    -e 's|^	gets(tm);$|	*tm = 0; fgets(tm, sizeof tm, stdin); tm[strcspn(tm, "\\n")] = 0;|' \
    -e 's|^	gets(fid);$|	*fid = 0; fgets(fid, sizeof fid, stdin); fid[strcspn(fid, "\\n")] = 0;|' \
    -e 's|^	gets(rid);$|	*rid = 0; fgets(rid, sizeof rid, stdin); rid[strcspn(rid, "\\n")] = 0;|' \
    -e 's|^	gets(ndline);$|	*ndline = 0; fgets(ndline, sizeof ndline, stdin); ndline[strcspn(ndline, "\\n")] = 0;|' \
    -e 's|^	   gets(fname);$|	   *fname = 0; fgets(fname, sizeof fname, stdin); fname[strcspn(fname, "\\n")] = 0;|' \
    -e 's|else if(gets(buf) == NULL) goto quit;|else if(fgets(buf, sizeof buf, stdin) == NULL) goto quit; else buf[strcspn(buf, "\\n")] = 0;|' \
    imp.c > g$$ && mv g$$ imp.c

cd $SRC/games/rogue || exit 1
sed -e 's|^	gets(prbuf);$|	*prbuf = 0; fgets(prbuf, sizeof prbuf, stdin); prbuf[strcspn(prbuf, "\\n")] = 0;|' \
    -e 's|^		gets(prbuf);$|		*prbuf = 0; fgets(prbuf, sizeof prbuf, stdin); prbuf[strcspn(prbuf, "\\n")] = 0;|' \
    rip.c > g$$ && mv g$$ rip.c

cd $SRC/games/mille || exit 1
sed -e 's|^			gets(buf);$|			*buf = 0; fgets(buf, sizeof buf, stdin); buf[strcspn(buf, "\\n")] = 0;|' \
    varpush.c > g$$ && mv g$$ varpush.c

# sail: vwait(&status, flags, 0) is the V8 job-control wait; V10 libc ships
# wait3 with the identical BSD signature.  player1.c's gets gets the idiom.
cd $SRC/games/sail || exit 1
sed -e 's|pid = vwait(&status, WNOHANG|pid = wait3(\&status, WNOHANG|' \
    -e 's|^		gets(comm);$|		*comm = 0; fgets(comm, sizeof comm, stdin); comm[strcspn(comm, "\\n")] = 0;|' \
    player1.c > g$$ && mv g$$ player1.c

# trek is pre-K&R: 124 archaic `=+' and `=-' assignments that the seventh
# edition's cc took and this machine's refuses (`saw +').  Spaces on both
# sides in every occurrence, so the sed cannot touch `i = -1'.
cd $SRC/games/trek || exit 1
for f in *.c
do
	sed -e 's| =+ | += |g' -e 's| =- | -= |g' $f > g$$ && mv g$$ $f
done

# pacman uses FIONREAD, which v10 has (sys/filio.h:37); the source never
# includes the header because BSD's sgtty.h dragged it in.
cd $SRC/games/pacman || exit 1
grep -s 'sys/filio' util.c > /dev/null || {
	sed 's|^#include <sgtty.h>$|#include <sgtty.h>\
#include <sys/filio.h>|' util.c > g$$ && mv g$$ util.c
}

# trek round two: the archaic assignment family is larger than =+ and =-.
cd $SRC/games/trek || exit 1
for f in *.c
do
	sed -e 's, =\* , *= ,g' -e 's, =/ , /= ,g' -e 's, =% , %= ,g' \
	    -e 's, =| , |= ,g' -e 's, =\& , \&= ,g' -e 's, =^ , ^= ,g' \
	    $f > g$$ && mv g$$ $f
done

# dump selects filesystems by BSD's fstab strings; v10's fstab is typed --
# fs_ftype, FSNONE, FSSWAP (fstab.h) -- so the test becomes `a real,
# non-swap filesystem'.
cd $SRC/cmd/dump || exit 1
sed -e 's|if (   (strcmp(fsp->fs_type, FSTAB_RW) == 0)|if (   fsp->fs_ftype != FSNONE|' \
    -e 's|    \|\| (strcmp(fsp->fs_type, FSTAB_RO) == 0) ){|    \&\& fsp->fs_ftype != FSSWAP ){|' \
    dumpoptr.c > g$$ && mv g$$ dumpoptr.c

# dk's tdkdial pushes line disciplines with FIOPUSHLD/FIOPOPLD and never
# includes sys/filio.h -- libpen's story exactly.
cd $SRC/dk/libc || exit 1
grep -s 'sys/filio' tdkdial.c > /dev/null || {
	sed '1i\
#include <sys/filio.h>	/* ipnx filio */' tdkdial.c > g$$ && mv g$$ tdkdial.c
}

# sys/ioctl.h is on no tape -- the include tape never carried it -- and the
# two sources that ask for it use only the line-discipline ioctls that
# sys/filio.h declares.  The include is redirected rather than the header
# invented.
cd $SRC/dk/libc || exit 1
for f in *.c ../cmd/*.c
do
	grep -s 'sys/ioctl.h' $f > /dev/null || continue
	sed -e 's|^#include <sys/ioctl.h>$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */|' \
	    -e 's|^#include "sys/ioctl.h"$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */|' $f > g$$ && mv g$$ $f
done
# dkproto and dkctlchan want the KIOC*/DIOC* controller ioctls too, and
# those live in sys/dkio.h -- alongside filio, not instead of it.
for f in dkproto.c dkctlchan.c
do
	grep -s 'sys/dkio' $f > /dev/null || {
		sed 's|^#include <sys/filio.h>	/\* ipnx: sys/ioctl.h is on no tape \*/$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */\
#include <sys/dkio.h>|' $f > g$$ && mv g$$ $f
	}
done
# dcon's tchars and ltchars live in sys/nttyio.h on this machine.
grep -s 'sys/nttyio' ../cmd/dcon.c > /dev/null || {
	sed 's|^#include <sys/filio.h>	/\* ipnx: sys/ioctl.h is on no tape \*/$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */\
#include <sys/nttyio.h>|' ../cmd/dcon.c > g$$ && mv g$$ ../cmd/dcon.c
}
cd $SRC/cmd/ether || exit 1
for f in netconfig.c arpconfig.c ipconfig.c
do
	grep -s 'sys/ioctl.h' $f > /dev/null || continue
	sed -e 's|^#include <sys/ioctl.h>$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */|' \
	    -e 's|^#include "sys/ioctl.h"$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */|' $f > g$$ && mv g$$ $f
done

# dump's -w arithmetic wants BSD's fs_freq, the dump-interval field v10's
# five-field fstab does not have.  fs_passno is the closest survivor: zero
# for filesystems fsck skips, small and positive for real ones, so `dump
# when passno days have gone by' keeps -w meaningful.
cd $SRC/cmd/dump || exit 1
grep -s 'ipnx fs_freq' dump.h > /dev/null || {
	sed 's|^#include <fstab.h>$|#include <fstab.h>\
#define fs_freq fs_passno	/* ipnx fs_freq: v10 fstab has no freq field */|' dump.h > g$$ && mv g$$ dump.h
}

# netconfig's -dump pushes the dumpld line discipline, whose driver and
# number are on no tape (the dumpcatch record above).  A defined -1 keeps
# the link whole and makes -dump fail cleanly at the ioctl.
cd $SRC/cmd/ether || exit 1
sed 's|^extern int dump_ld;$|int dump_ld = -1;	/* ipnx: dumpld discipline is on no tape; -dump fails cleanly */|' netconfig.c > g$$ && mv g$$ netconfig.c

# trek's oldest layer: arrays initialized the pre-K&R way, a bare `{' with
# no `=' after the declarator -- ten of them across the tree.  The pattern
# is a column-0 TYPE NAME[] line; parameter declarations all end in `;' and
# stay untouched.
cd $SRC/games/trek || exit 1
for f in *.c
do
	sed 's|^\([A-Z][A-Za-z]*[ 	][ 	]*[A-Z][A-Za-z]*\[[0-9]*\]\)[ 	]*$|\1 =|' $f > g$$ && mv g$$ $f
done

# netnews' five real gets sites (everything else already reads with fgets or
# its own hfgets); the fgets idiom from 512restor's stanza above.
cd $SRC/cmd/netnews/src || exit 1
sed -e 's|^	gets(edcmdbuf);$|	*edcmdbuf = 0; fgets(edcmdbuf, sizeof edcmdbuf, stdin); edcmdbuf[strcspn(edcmdbuf, "\\n")] = 0;|' \
    -e 's|^		gets(bfr);$|		*bfr = 0; fgets(bfr, sizeof bfr, stdin); bfr[strcspn(bfr, "\\n")] = 0;|' \
    readr.c > g$$ && mv g$$ readr.c
sed -e 's|while(gets(buf) != NULL) {|while(fgets(buf, sizeof buf, stdin) != NULL) { buf[strcspn(buf, "\\n")] = 0;|' \
    -e 's|if (gets(buf) == NULL)|if (fgets(buf, sizeof buf, stdin) == NULL)|' \
    unbatch.c > g$$ && mv g$$ unbatch.c

# arpconfig and ipconfig use the ENIO* ethernet ioctls, which live in the
# machine's own sys/enio.h -- one more header Bell's sys/ioctl.h evidently
# gathered.
cd $SRC/cmd/ether || exit 1
for f in arpconfig.c ipconfig.c
do
	grep -s 'sys/enio' $f > /dev/null || {
		sed 's|^#include <sys/filio.h>	/\* ipnx: sys/ioctl.h is on no tape \*/$|#include <sys/filio.h>	/* ipnx: sys/ioctl.h is on no tape */\
#include <sys/enio.h>|' $f > g$$ && mv g$$ $f
	}
done
# ipconfig's IPIO* set is one header further along, in sys/inio.h.
grep -s 'sys/inio' ipconfig.c > /dev/null || {
	sed 's|^#include <sys/enio.h>$|#include <sys/enio.h>\
#include <sys/inio.h>|' ipconfig.c > g$$ && mv g$$ ipconfig.c
}

# ndcon includes <dk.h> -- which reaches sys/stream.h and its caddr_t --
# before <sys/types.h>.  track.c already orders them correctly.
cd $SRC/dk/cmd || exit 1
grep -s 'ipnx types first' ndcon.c > /dev/null || {
	sed 's|^#include <dk.h>$|#include <sys/types.h>	/* ipnx types first: dk.h reaches stream.h */\
#include <sys/filio.h>\
#include <dk.h>|' ndcon.c > g$$ && mv g$$ ndcon.c
}

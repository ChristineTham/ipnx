# Turn v10.tar into a disk that can build itself: the tape's tree plus the build
# system, written out as ipnxorig.tar.
#
#	mkv10     the six tapes -> v10.tar, pristine, once
#	mkipnx    v10.tar + the build system -> ipnxorig.tar      <-- this
#	taripnx   this machine's live /usr/src -> ipnx.tar
#	mkimage   makes the disk and extracts an archive into it
#
# THREE ARCHIVES AND EACH ANSWERS A DIFFERENT QUESTION.  v10.tar is what the
# tapes hold, one name per path and nothing of ours in it -- so a question about
# the tapes has an answer that does not require fetching 430 MB again.
# ipnxorig.tar is that plus /usr/src/build, which is the starting point for a
# build from nothing.  ipnx.tar is a machine that has already built, which is
# what mkimage normally extracts.  Only the last one contains binaries.
#
# WHY THIS IS NOT `mkv10 THEN mkbuild BY HAND'.  It is exactly that, and that is
# the point: the sequence was typed, and a typed sequence is one that can be
# half-done.  A disk holding v10.tar's tree without /usr/src/build has no mkfile
# and no patch, so it looks like a source tree and cannot build.
#
# IT RUNS patch, AND IT SHIPS THE TREE'S OWN BUILD FILES.  It did neither, on
# the reasoning that the repairs are mk's job and the difference should stay
# visible.  That reasoning made two archives that can never agree: a machine
# applies patch and takes the converted mkfiles from the share while it
# builds, so its taripnx archive carries both, and this one carried neither --
# 1,282 members apart, measured.  ipnx.tar and ipnxorig.tar are the same
# archive cut at two moments, so they hold the same tree or one of them is
# lying.  The stamp is not lost: mkfile makes $CMD/.patched a target whose
# prerequisite is $GEN/patch, and ipnxclean removes the stamp with every
# other product, so the first build on the new disk re-runs patch over a tree
# that already has it -- every stanza here is guarded and idempotent.
GEN=/usr/src/build
OUT=/v10/usr/ipnx
ARCH=$OUT/v10.tar
REPO=${1-$GEN}

test -d /v10/usr || { echo "mkipnx: no /v10/usr -- run mkimage first"; exit 1; }
test -f $ARCH || { echo "mkipnx: no $ARCH -- run mkv10 first"; exit 1; }
if test -d /v10/usr/src
then
	echo "mkipnx: /v10/usr already holds a source tree"
	echo "mkipnx: run mkimage first -- it blanks ra1 and mounts it"
	exit 1
fi

# the archive is a tar of /usr -- build/usrtrees is the one list of its shape
# Twice, for the hard links -- see mkimage: a link entry can precede its
# target in the stream, and V10's tar drops it rather than waiting.
cd /v10/usr && tar xf $ARCH || exit 1
cd /v10/usr && tar xf $ARCH || exit 1
for d in `grep '^[a-z0-9]' /usr/src/build/usrtrees`
do
	test -d /v10/usr/$d || { echo "mkipnx: usrtrees names $d and the archive lacked it"; exit 1; }
done

# THE BUILD SYSTEM COMES FROM ONE PLACE AND mkbuild IS IT.  Naming the files
# again here would be a second list, and a component list that appears twice
# will disagree -- which it did: adding updatebuild to the repository copied
# everything except updatebuild.
sh $GEN/mkbuild /v10 $REPO || exit 1

# THE TREE'S OWN BUILD FILES, THROUGH THE CHANNEL THAT ALREADY EXISTS.
# build/mkfiles is the list updatebuild copies from the share onto a machine
# -- the phase 6 conversions and the handful of repairs that are whole files
# -- and it is the same list here, read from the same place, so the two
# archives carry the same 427 files.  A missing target directory is the skip,
# exactly as updatebuild has it: the five o* packages are norman-only.
if test -f $REPO/mkfiles
then
	while read f
	do
		case $f in
		[a-z]*)	if test -d /v10/usr/`dirname $f`
			then
				cp $REPO/../../$f /v10/usr/$f || echo "mkipnx: $f: copy failed"
			fi ;;
		esac
	done < $REPO/mkfiles
	echo "mkipnx: tree build files shipped"
fi

# THE REPAIRS.  SRC and SYS point patch at this disk; its own defaults are
# /v10 already, and naming them here says so rather than relying on that.
SRC=/v10/usr/src SYS=/v10/usr/sys sh $GEN/patch || exit 1
# AND THE STAMP, because the repairs really are applied.  mkfile makes
# $CMD/.patched a target whose prerequisite is $GEN/patch; without the stamp
# the first build on the new disk repeats work it has already had, and the
# archive differs from a machine's by exactly this file.
echo done > /v10/usr/src/cmd/.patched
echo "mkipnx: repairs applied"

# WRITTEN OUTSIDE THE TREE IT IS ARCHIVING.  tar has no --exclude here, and an
# archive created under the directory being walked is reached by that walk and
# copied into itself while it grows.
rm -f $OUT/ipnxorig.tar
# WHAT A BUILD CONSUMES, THIS ARCHIVE MUST NOT CARRY.  Six rules regenerate a
# file the tape ships and then remove it, so a machine's archive lacks six
# files this one would keep -- and two archives that must be identical would
# differ by exactly those.  ipnxbuild writes the list; this reads it.  A disk
# that has never built has no list, and then there is nothing to remove.
if test -f /usr/ipnx/consumed
then
	sed 's|^|/v10/usr/|' /usr/ipnx/consumed > /usr/tmp/mki.$$
	xargs rm -f < /usr/tmp/mki.$$
	echo "mkipnx: `wc -l < /usr/tmp/mki.$$` files a build consumes removed"
	rm -f /usr/tmp/mki.$$
fi

# THE SAME LIST taripnx TARS.  `ls' minus two names is a second statement of
# the archive's shape and would drift from usrtrees the moment a tree was
# added or a mkbitfs left something behind.
cd /v10/usr && tar cf $OUT/ipnxorig.tar `grep '^[a-z0-9]' $GEN/usrtrees` || exit 1

# v10's kernel does not sync on halt -- md/machdep.c's boot() calls death()
# without one -- so an archive written here and then left by ^E is not on the
# disk at all.
cd /
sync
sync
echo "mkipnx: $OUT/ipnxorig.tar written"

# Remove what ipnxbuild wrote, from the list ipnxbuild itself wrote.
#
#	ipnxclean              this machine
#	ipnxclean /v10         the disk on ra1
#
# ONE LINE, AND IT NEEDS NO MAINTENANCE WHEN A RULE IS ADDED.  /usr/ipnx/derived
# is not a list anybody keeps: ipnxbuild walks the build/usrtrees roots before
# and after itself and takes the set difference, so a rule added to the mkfile
# this morning is covered this afternoon with nothing edited here.  The
# directories it made are in the same file, sorted in reverse so a child is
# removed before its parent, and rmdir's refusal to remove a non-empty directory
# is the safety: one the build made that a tape file now sits in stays.
#
# WHAT IT DOES NOT REMOVE IS THE INSTALLED SYSTEM, and that is deliberate.
# build/usrtrees leaves bin and lib out -- "product, not shape" -- so /usr/bin,
# /usr/lib, /usr/games, /bin and /etc are outside the walk and nothing here
# touches them.  ipnxclean returns the SOURCE TREE to the state the archive
# holds; it is not an uninstaller, and a rule whose only output is an installed
# binary leaves nothing for it to do.  That is what makes the equation in
# mkipnx:26-28 hold -- ipnx.tar and ipnxorig.tar "hold the same tree or one of
# them is lying" -- and it is why a rule that starts overwriting a tape file
# needs a build/preserve row instead: a deletion cannot undo an overwrite, and
# ipnxbuild says OVERWRITTEN AND NOT PRESERVED when it finds one.
#
# `rm -rf' rather than `rm -f' because the directory rows are in the same list,
# and sed re-roots every path for the /v10 case.
#
# THE PRODUCTS build/inshape NAMES ARE THE EXCEPTION.  usrtrees calls maps
# shape because every file in it is, except /usr/maps/map: map's own mkfile
# has always installed the compiled binary there (map.sh's MAPPROG default
# agrees, and so does every man page), so it is product sitting inside a
# shape root, same as bin/lib are product sitting outside one.  It cannot be
# in the tree before a build (binaries never enter git), so ipnxbuild's
# before/after walk always calls it derived, and world's own install gets
# swept the moment mkimage runs this script against /v10 -- measured: a
# from-scratch golden disk shipped map.sh and libmap.a but no /usr/maps/map,
# so /usr/bin/map ran and failed to find its own binary.  Excluded here, not
# from the walk itself, because that walk also drives mkipnx's `consumed'
# accounting and this is the only line ipnxclean owns.
#
# A LIST, BECAUSE THERE WAS A SECOND ONE.  map was one grep here, and
# /usr/local/lib/flex.skel -- where flex compiles in its skeleton -- was swept
# by every build until 8 Oct 2026, so the installed flex answered every input
# with `can't open skeleton file'.  Found by reading the disk from the host
# for paths installed programs name that are not there.
test -f /usr/src/build/inshape || {
	echo "ipnxclean: no /usr/src/build/inshape -- run updatebuild; nothing removed"
	exit 1
}
#
# AND EVERY DIRECTORY ABOVE ONE.  The rows below are removed with rm -rf, so
# a directory row is its whole contents: on a disk that starts without
# /usr/local/lib -- every disk mkimage builds -- the build makes it, the
# derived list names it, and its rm -rf would take flex.skel with it however
# carefully the file's own row was kept.  So each product's ancestors are
# kept too, up to the shape root (dirname stops at `.').
cp /usr/ipnx/derived /usr/tmp/ipc.d
while read k junk
do
	case $k in
	[a-z0-9]*)
		p=$k
		while test "$p" != .
		do
			grep -v "^/usr/$p\$" /usr/tmp/ipc.d > /usr/tmp/ipc.k
			mv /usr/tmp/ipc.k /usr/tmp/ipc.d
			p=`dirname $p`
		done ;;
	esac
done < /usr/src/build/inshape
sed "s|^/usr/|${1-}/usr/|" /usr/tmp/ipc.d | xargs rm -rf
rm -f /usr/tmp/ipc.d

# equal(1) is four names for one binary: =, ==, =p and ==p.  THE TARGET IS
# QUOTED: mk(1) tells an assignment from a rule by "the first unquoted
# occurrence of : (rule header) or = (assignment)", and in $ROOT/usr/bin/= the
# = comes first, so unquoted this line is an assignment to a variable called
# $ROOT/usr/bin/.  Quoting it is the tape's own idiom -- worm/mkfile:32 is
# `$BIN/'(w[^.]*)$':R:'.
# SPLIT BY HAND, and this is the one that was.  The mechanical pass told a rule
# from an assignment by looking for `=' before the `:', which is what mk does --
# but mk looks for the first UNQUOTED one, and this head quotes its `='.  So the
# pass read this line as an assignment and skipped it, silently, and it was the
# only rule of the 306 left building and installing in one recipe.  Found by
# asking whether every prerequisite in the file is either a target or a file
# that exists; this one answered no.
P_CMD_equal_a_out:V:	$PREP
	cd $CMD/equal; mk a.out || echo '=: FAILED'

$CMD/equal/a.out: P_CMD_equal_a_out
	test -f $CMD/equal/a.out || echo '$CMD/equal/a.out: the package did not produce it'

$ROOT/usr/bin/'=': $CMD/equal/a.out
	cd $CMD/equal; cp a.out $ROOT/usr/bin/= || echo '=: install FAILED'
	cd $CMD/equal; strip $ROOT/usr/bin/= || echo '=: install FAILED'
	cd $CMD/equal; rm -f $ROOT/usr/bin/== $ROOT/usr/bin/=p $ROOT/usr/bin/==p || :
	cd $CMD/equal; ln $ROOT/usr/bin/= $ROOT/usr/bin/== || :; ln $ROOT/usr/bin/= $ROOT/usr/bin/=p || :; ln $ROOT/usr/bin/= $ROOT/usr/bin/==p || :


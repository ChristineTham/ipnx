# the copy is done here.
$ROOT/usr/bin/uucp:Psh $GEN/installed: $PREP $ROOT/usr/lib/libipc.a
	cd $CMD/uucp; mk all || echo 'uucp: FAILED'
	cd $CMD/uucp; cp uucp uux uuxqt uucico uusched uugrep uuname uucheck uustat uucleanup $ROOT/usr/bin || :
	cd $CMD/uucp; rm -f *.o || :


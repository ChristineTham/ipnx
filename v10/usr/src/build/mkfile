# in_address; -lipc because errstr, which tcp_lib.c declares extern, is defined
# in libipc/ipcopen.c:8.
$ETC/nafsmnt:Psh $GEN/installed: $PREP $ROOT/usr/lib/libin.a $ROOT/usr/lib/libipc.a
	cd $CMD; cc -O   -o nafsmnt nafsmnt.c -lin -lipc && strip nafsmnt && cp nafsmnt $ETC/nafsmnt || echo 'nafsmnt: FAILED'
	cd $CMD; rm -f nafsmnt nafsmnt.o


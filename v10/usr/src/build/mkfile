# ---- verify -----------------------------------------------------------------
# Every installed file, read from the same lists the build uses, so the two
# cannot drift apart.  Silence means everything is where it should be.
#
#	mk verify              checks this machine
#	mk ROOT=/v10 verify    checks the disk being built
# Reinstall the configuration THIS PROJECT OWNS, whatever is already there.
#
# The $ETCF rules cannot do this and must not: their P predicate is ./installed,
# which exits 0 for any existing target, deliberately -- everything else in /etc
# and /bin came off the tape and a time comparison would rebuild the lot.  The
# cost is that editing one of our own config files here could not reach a disk
# that already carried the old copy, and three rounds of "still not working"
# were exactly that: a corrected ttys and rc sitting in /usr/src/build while
# /etc kept the originals.
#
# mtab and utmp are left out: they are runtime state that rc and init rewrite,
# not configuration.  Works against either root -- `mk ROOT=/v10 config'.
# /etc/mkimage is here too: it is not under $GEN/etc, so the loop misses it,
# and its own rule carries ./installed, which never replaces an existing one.
#
# Both targets end in sync.  mk does not, and machdep.c:439-446's boot() calls
# death() without syncing either, so a disk written here and then left by ^E
# keeps the old file and the run reads as though the copy never happened.
config:V:
	for f in down fstab group hosts mklost+found motd networks passwd rc services shutdown ttys whoami
	do
		cp $GEN/etc/$f $ETC/$f
	done
	chmod +x $ETC/down $ETC/mklost+found $ETC/rc $ETC/shutdown
	cp $GEN/mkimage $ETC/mkimage
	cp $GEN/etc/profile $ROOT/.profile
	chmod 644 $ROOT/.profile
	sync

verify:V:
	for f in $TOOLS $INC $LIB $LIBS $USRBIN $BIN $ETCF $ROOT/unix $ROOT/.profile $ULIB $CMDS $PKG
	do
		test -f $f || echo "MISSING  $f"
	done
	for d in $ROOT/bin $ROOT/etc $ROOT/lib $ROOT/n $ROOT/n/home $ROOT/n/macos $ROOT/proc $ROOT/tmp $ROOT/usr/adm $ROOT/usr/bin $ROOT/usr/lib $ROOT/usr/tmp
	do
		test -d $d || echo "MISSING DIR  $d"
	done


# troff READS PLAIN TEXT, AND THE DESCRIPTIONS ARE IN THE SUBDIRECTORIES.
# t11.c:24 (getdesc) and t11.c:96 (getfont) each open their argument with
# `fopen(name, "r")', and t6.c:713,716 build that argument as
#	sprintf(pathname, "%s/dev%s/%s", fontdir, devname, shortname);
# over fontdir = FONTDIR = tdef.h:16 `/usr/lib/font'.  So this troff opens
# /usr/lib/font/dev202/DESC and /usr/lib/font/dev202/R as TEXT and never reads
# a .out at all: makedev, which the top-level makefile has no rule for, is for
# the drivers -- d202.c:452,527 hold the only `%s/dev%s/DESC.out' and
# `%s/dev%s/%s.out' in the tree -- and for the troff under Old/.
#
# EVERY file in each dev directory is copied, not just the fonts DESC mounts,
# because t6.c:713's synonym branch takes `.fp 1 R Avant' and reaches any file
# in the directory by name; dev202 carries some two hundred such faces.  The
# four directories are flat -- no subdirectory in any of them -- so cp moves
# each whole, and troff's own checkfont (t11.c:60, "really paranoid, but
# consider \f.") rejects the README and install script that ride along.
#
# nroff IS THIS BINARY UNDER ANOTHER NAME.  n1.c:40-46 take the basename of
# argv[0] and
#	if (strcmp(p, "nroff") == 0)
#		TROFF = 0;
# with tdef.h:7 `#define NROFF (!TROFF)', so nroff is a link exactly as
# README:18-22 says and NOT a second compilation -- no -DNROFF reaches any
# source this rule builds.  It then reads NTERMDIR (tdef.h:19,
# `/usr/lib/term/tab.') plus devname, defaulting to NDEVNAME `37'
# (n10.c:56,76,77), so term/'s tables are what lets nroff start at all.
# term/ is the superset: its tab.37, tab.450 and tab.lp are byte-identical to
# the three sitting beside the sources, and it adds tab.450-12 and tab.think.
#
# Old/, ancient.nroff/ AND Drivers/ ARE NOT BUILT.  Old/README is dated
# 7/27/81 and describes the previous machine-independent troff; it carries its
# own dev202, devaps and devcat, which its install would lay over these.
# ancient.nroff is the pre-troff nroff and its install is `mv nroff /usr/bin',
# over the link made here.  Drivers/README says those drivers "are for the
# most part dusty, since none are used actively" and points at ../d202.c
# instead; its makefile is a stale copy of the parent's, naming n1.c through
# suftab.c, not one of which is in that directory.
P_CMD_troff_a_out:V:	$PREP
	cd $CMD/troff; mk a.out CFLAGS= || echo 'troff: FAILED'

$CMD/troff/a.out: P_CMD_troff_a_out
	test -f $CMD/troff/a.out || echo '$CMD/troff/a.out: the package did not produce it'

$ROOT/usr/bin/troff: $CMD/troff/a.out
	cd $CMD/troff; cp a.out $ROOT/usr/bin/troff || echo 'troff: FAILED'; rm -f $ROOT/usr/bin/nroff || :; ln $ROOT/usr/bin/troff $ROOT/usr/bin/nroff || echo 'nroff: FAILED'
	test -d $ROOT/usr/lib/font || mkdir $ROOT/usr/lib/font; test -d $ROOT/usr/lib/term || mkdir $ROOT/usr/lib/term; test -d $ROOT/usr/lib/font/dev202 || mkdir $ROOT/usr/lib/font/dev202; test -d $ROOT/usr/lib/font/devaps || mkdir $ROOT/usr/lib/font/devaps; test -d $ROOT/usr/lib/font/devcat || mkdir $ROOT/usr/lib/font/devcat; test -d $ROOT/usr/lib/font/devi10 || mkdir $ROOT/usr/lib/font/devi10
	cd $CMD/troff/term; cp tab.37 tab.450 tab.450-12 tab.lp tab.think $ROOT/usr/lib/term || echo 'troff term: FAILED'
	cd $CMD/troff/dev202; cp * $ROOT/usr/lib/font/dev202 || echo 'troff dev202: FAILED'
	# u_Cw is casefix's spelling of the SOURCE tree's second CW (DESC mounts
	# CW; Cw is the unmounted twin) -- the installed device directory lives on
	# this machine's case-sensitive disk, so the tape's own name goes back.
	cd $CMD/troff/devaps; cp * $ROOT/usr/lib/font/devaps && { test -f $ROOT/usr/lib/font/devaps/u_Cw && mv $ROOT/usr/lib/font/devaps/u_Cw $ROOT/usr/lib/font/devaps/Cw || :; } || echo 'troff devaps: FAILED'
	cd $CMD/troff/devcat; cp * $ROOT/usr/lib/font/devcat || echo 'troff devcat: FAILED'
	cd $CMD/troff/devi10; cp * $ROOT/usr/lib/font/devi10 || echo 'troff devi10: FAILED'
	cd $CMD/troff; strip $ROOT/usr/bin/troff/a.out || echo 'troff: install FAILED'


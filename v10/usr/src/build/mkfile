# THE REST OF cmd/, and why each is not built:
#   asd asd++ oasd++  the software-distribution package.  Every one of the three
#             installs into $(ASD), which no makefile in them defines -- the
#             variable is empty, so `cp $(LIBPROGS) rmlocks $(ASD)' copies into
#             the current directory.  asd's own install is `./install.asd'
#   btree     cmd/cbt above, a year newer, and its install would replace the
#             libcbt.a built from /usr/src/libcbt
#   dimpress  its install re-invokes make with INS=cp against $(ARGS), which is
#             empty, so it installs nothing
#   dist odist  DIRS is `lib cmd $SYS' and `ape tar $SYS'; SYS names the target
#             system and is set nowhere, so the recursion asks for `-compile'
#   ether     BINDIR=/usr/ether and it links $(LIBDIR)/libchaos.a, which is on
#             none of the six tapes
#   icon      its first target is `what:', a help message; the package expects
#             to be configured for a named system first
#   movie omovie  the install target prints three lines beginning "echo change
#             LIB=... in movie, stills, develop" and copies nothing
#   cfront    DEFERRED TO V11, when the Plan 9 sources are used.  The reason
#             and the search that settles it are with the dag and vsw rules
#             below; libC, its runtime, is deferred with it
#   ansi      one file, tr.c, built `lcc -A' and installed by its own mkfile
#             as /usr/bin/tr -- the ANSI tr.  cmd/tr.c is the same command in
#             K&R and two months NEWER (Mar 21 1990 against Jan 10 1990), and
#             it is already installed above because membername needs it
#   oworm     cmd/worm above, the same fifteen programs
#   sky       `all:' with an empty recipe
#   spell.old cmd/spell above.  Its install writes /usr/dict/spellprog and
#             /usr/bin/spell, the same two names

# ---- the three that name a C++ compiler ------------------------------------
# cfront, dag and vsw each set their compiler to a C++ driver in their own
# build file -- cfront/cfront/makefile:12 and dag/makefile:1 are `CC = nCC',
# vsw/mkfile:2 is `CC=CC' -- and nothing on the six tapes is called nCC or CC.
# The only things of either name are the include directories /usr/include/CC
# and /usr/jerq/include/CC, which are the C++ header set.
#
# CFRONT IS DEFERRED TO V11, where the Plan 9 sources are the ones to use.
# What is under cmd/cfront is C++ SOURCE, seven copies of it (cfront,
# cfront2.00, ocfront, optcfront, ooptcfront, ptcfront, xptcfront), and every
# .c in all seven is C++ except cfront/malloc.c and ptcfront/block.c -- which
# is why c.makefile:190 singles malloc.o out with `cc $(CCFLAGS) -c malloc.c'
# while every other member goes to $(CC).
#
# THE BOOTSTRAP AT&T SHIPPED IS NOT ON THESE TAPES, and that is what defers it.
# cfront was written in the language it translates, and the way out was to
# distribute, beside the C++ sources, a half-preprocessed C version -- cfront's
# own output for its own source -- which the native cc compiles into a
# translator that can then recompile the C++.  That half-preprocessed set is
# what is missing here.  The search for it: dcl4.c and simpl2.c, two names
# unique to cfront, occur in exactly seven directories in v10/ and the same
# seven in v10superset/, and all fourteen are C++; xptcfront/cfront.cpio is a
# cpio of the same tree, its first member alloc.c opening with the same ident
# line; and there is no generated C anywhere else in either tree.  Cpre, the
# 1979 C-with-Classes preprocessor cfront grew out of, is not here either --
# the only trace of it in the corpus is a credit, cfront/lex.c:11, "lexical
# analyser based on pcc's and cpre's scanners".  The chain has no first link on
# this disk.  libC.a, the C++ runtime, goes with it: libC/makefile is
# `CC = nCC' over six subdirectories of C++ and needs a working translator.
# ---- the packages whose build files are one level down ----------------------
# Mk's directory branch is `cd $i; /bin/make', which reads the top level and
# nothing else, so these were listed above as having no build file.  Each is
# driven here from the subdirectory that has one.
# THREE BASICS, AND ONLY TWO OF THEM LINK.  cmd/basic holds bas, basic and
# bite.  bas is the V7 one -- Makefile target `bas', `cc $(OBJECTS) -lm -o bas'
# -- and bite is the 1981 BITE interpreter, whose src/Makefile is `cc -o bite
# $(OBJ)'.  Neither has an install target and neither name is in an Admin list,
# so Admin/dest sends both to /usr/bin.
#
# basic/basic, the System V one, is NOT built: makefile:16 is `LIBPW=-lPW' and
# its all target links `$(LIBM) $(LIBLD) $(LIBPW)', while its install needs
# expunge, built `-lld' against <ldfcn.h>.  Neither libPW.a nor libld.a is on
# any of the six tapes or in Admin/ulibfiles.
$ROOT/usr/bin/bas:Psh $GEN/installed: $PREP
	cd $CMD/basic/bas; rm -f *.o bas || :
	cd $CMD/basic/bas; make bas CFLAGS=-O && strip bas && cp bas $ROOT/usr/bin/bas || echo 'bas: FAILED'
	cd $CMD/basic/bas; rm -f *.o bas || :

$ROOT/usr/bin/bite:Psh $GEN/installed: $PREP
	cd $CMD/basic/bite/src; rm -f *.o bite || :
	cd $CMD/basic/bite/src; make bite && strip bite && cp bite $ROOT/usr/bin/bite || echo 'bite: FAILED'
	cd $CMD/basic/bite/src; rm -f *.o bite || :

# pcc1 IS THE FORTRAN BACK END, and its own makefile says so twice: `all: fort'
# and an install whose only live line is `mv fort ${DESTDIR}/lib/f1' with
# `mv comp ${DESTDIR}/lib/ccom' COMMENTED OUT.  That comment is the tape
# declining to replace /lib/ccom, which cmd/ccom builds above, so this takes
# the makefile at its word and installs /lib/f1 only.  It compiles ../mip
# through -I and needs yacc and as, both of which are installed.
$ROOT/lib/f1:Psh $GEN/installed: $PREP $ROOT/usr/bin/yacc
	cd $CMD/pcc1/pcc; make clean || :; make install DESTDIR=$ROOT || echo 'pcc1: FAILED'
	cd $CMD/pcc1/pcc; make clean || :

# THE POSTSCRIPT PACKAGE ALREADY KNOWS ABOUT V9 AND ABOUT ROOT.
# postscript.mk:105 is `SYSTEM=V9' -- Ninth Edition, the nearest thing it
# offers -- and lines 111-117 put every destination under $(ROOT):
# FONTDIR, HOSTDIR, MAN1DIR, POSTBIN, POSTLIB and TMACDIR.  Its install target
# exports the six and re-runs itself over $(TARGETS) with ACTION=install, and
# each low-level makefile makes its own destination, so only MAN1DIR has to
# exist first -- the file says so: "MAN1DIR must already exist - it will not be
# created during an install".  $(ROOT)/tmp is that, and dirs makes it.
#
# cmd/post.src is THE SAME PACKAGE A YEAR NEWER -- its VERSION is 3.3.2 and
# Jul 7 1992 against 3.3.1 and May 21 1991 -- and it installs the same paths,
# so building both would have the older land on the newer or the reverse
# depending on order.  cmd/postscript is the one built.
$ROOT/usr/bin/postscript/postio:Psh $GEN/installed: $PREP
	test -d $ROOT/usr/lib/font || mkdir $ROOT/usr/lib/font
	test -d $ROOT/usr/lib/font/postscript || mkdir $ROOT/usr/lib/font/postscript
	test -d $ROOT/usr/lib/tmac || mkdir $ROOT/usr/lib/tmac
	cd $CMD/postscript; make -f postscript.mk ROOT=$ROOT install || echo 'postscript: FAILED'

# ---- the three loose-source directories ------------------------------------
# cref, lfactor and weather have no build file at any level.  Each is driven
# from what its own source says.
#
# CREF IS THE CROSS-REFERENCE GENERATOR, and every file in it is dated
# Jan 13 1982.  Its usage line is `cref [-acilonstux123] file1 ...'.
#
# IT TAKES THREE SOURCES, NOT ONE.  dr.c defines main, driver, init, flags and
# compile; acts.c the thirteen action routines that the acts[] table at
# dr.c:7-21 points at, and search(); put.c the put/flsh pair that writes the
# four temporary streams.  mcons.c and ccmn.c are #included by both dr.c and
# acts.c rather than compiled, which is why every global in ccmn.c is
# uninitialised -- they are commons, and acts.c:5-7 carries the one real
# definition of cross, order and mone.
#
# crpost AND upost BELONG IN /usr/lib.  dr.c:116 and :120 are
#	fn = "/usr/lib/upost";
#	fn = "/usr/lib/crpost";
# so those are the paths cref execs: -u selects upost, anything else crpost
# with `-3' or `-4x'.  Only cref itself is a command.
#
# THE SIX TABLES ARE BUILT HERE TOO.  cref reads them at run time and cannot
# make them: dr.c:30-31 name /usr/lib/atab and /usr/lib/aign, and the -c and
# -e branches of flags() name the ctab/cign and etab/eign pairs.  None of the
# six is on the tape compiled, but every source is, and so are both compilers
# -- mtab.c turns a ?table into a ?tab, make.c turns a ?sym into a ?ign.  They
# take repairs of their own in ./patch, including the pdp-11 word size their
# byte counts assume; the reader in dr.c is corrected with them.  Neither
# compiler is named by anything on the tape, so each is built under its own
# source's name and run from `.', never through PATH.
$ROOT/usr/bin/cref:Psh $GEN/installed: $PREP
	cd $CMD/cref; cc -O -o cref dr.c acts.c put.c && strip cref && cp cref $ROOT/usr/bin/cref || echo 'cref: FAILED'
	cd $CMD/cref; cc -O -o crpost crpost.c && strip crpost && cp crpost $ROOT/usr/lib/crpost || echo 'crpost: FAILED'
	cd $CMD/cref; cc -O -o upost upost.c && strip upost && cp upost $ROOT/usr/lib/upost || echo 'upost: FAILED'
	cd $CMD/cref; cc -O -o mtab mtab.c && ./mtab atable atab && ./mtab ctable ctab && ./mtab etable etab || echo 'cref tab: FAILED'
	cd $CMD/cref; cc -O -o make make.c && ./make asym aign && ./make csym cign && ./make esym eign || echo 'cref ign: FAILED'
	cd $CMD/cref; cp atab ctab etab aign cign eign $ROOT/usr/lib || echo 'cref tables: FAILED'
	cd $CMD/cref; rm -f cref crpost upost mtab make atab ctab etab aign cign eign *.o || :

# lfactor's read-me IS the build, both lines of it:
#	cc lfactor.o search.o dgcd.o util.o mp.a -lm
#	: /usr/lib/ptab must be in place.
# mp.a is the directory's OWN multiple-precision library, not /usr/lib/libmp.a:
# madd.c, mdiv.c, mout.c and mult.c all differ from libmp's copies, and min.c
# and mulmod.c have no counterpart there at all.  So it is built from the six
# local sources in the order the read-me implies, and lfactor.o search.o
# dgcd.o util.o are linked against it.  -lm is the stub.
#
# /usr/lib/ptab is a table of primes and is on none of the six tapes, so this
# builds and then wants a file that has to come from somewhere else.
$ROOT/usr/bin/lfactor:Psh $GEN/installed: $PREP
	cd $CMD/lfactor; rm -f *.o mp.a lfactor || :
	cd $CMD/lfactor; cc -O -c madd.c mdiv.c min.c mout.c mulmod.c mult.c && ar rc mp.a madd.o mdiv.o min.o mout.o mulmod.o mult.o && ranlib mp.a || echo 'lfactor mp.a: FAILED'
	cd $CMD/lfactor; cc -O -c lfactor.c search.c dgcd.c util.c && cc -O -o lfactor lfactor.o search.o dgcd.o util.o mp.a -lm && strip lfactor && cp lfactor $ROOT/usr/bin/lfactor || echo 'lfactor: FAILED'
	cd $CMD/lfactor; rm -f *.o mp.a lfactor || :

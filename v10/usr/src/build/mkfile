	cd $SRC/libplot/libram; make libram.a && cp libram.a $ROOT/usr/lib/libram.a && ranlib $ROOT/usr/lib/libram.a || echo 'libram.a: FAILED'
	cd $SRC/libplot/libram; rm -rf xplot || :; make clean || :

$ROOT/usr/lib/libtr.a:Psh $GEN/installed: $PREP
	cd $SRC/libplot/libtr; rm -rf xplot || :; make clean || :
	cd $SRC/libplot/libtr; make libtr.a && cp libtr.a $ROOT/usr/lib/libtr.a && ranlib $ROOT/usr/lib/libtr.a || echo 'libtr.a: FAILED'

# 2500 is the 2500-series terminal handler and its mkfile sets CC=lcc itself.
# NO -g, AND THAT IS WHAT THE `CM expected' FAILURES WERE.  lcc's VAX generator
# emits stab debugging records for -g -- gen2/vax/pseudos.c:334-388 print
# `.stabs "name",0x%x,0,0,0', `.stabn 0x%x,0,0,%d' and `.stabd 0x%x,0,%d' -- and
# v10's as reads .stabs with the NAME AS INDIVIDUAL CHARACTER EXPRESSIONS, not
# as a string: asparse.c:569-573 is
#	for (argcnt = 0; argcnt < NCPS; argcnt++){
#		expr(locxp, val);
#		stpt->s_name[argcnt] = locxp->e_xvalue;
#		xp = explist;
#		shiftover(CM);
#	}
# -- NCPS commas, one per character of the symbol name.  Handed a quoted string
# and four fields it runs out of commas and stops, and the message is generated
# rather than written: asexpr.h:14-19 is `#define shiftover(token) if (val !=
# token) { yyerror("token expected") ...', whose parameter is named token and
# appears inside the string, so a pre-ANSI cpp turns shiftover(CM) into
# yyerror("CM expected") -- which is why that text is in the shipped as binary
# and nowhere in its source.  CM is the comma, astoks.h:107.
#
# Every one of the six takes -g from a variable, so it comes off on the command
# line and no makefile is touched.  Debugging records are all that is lost.
P_CMD_2500_2500:V:	$PREP $LCCOK $ROOT/usr/bin/lex
	cd $CMD/2500; mk 2500 CFLAGS= || echo '2500: FAILED'

$CMD/2500/2500: P_CMD_2500_2500
	test -f $CMD/2500/2500 || echo '$CMD/2500/2500: the package did not produce it'

$ROOT/usr/bin/2500: $CMD/2500/2500
	cd $CMD/2500; cp 2500 $ROOT/usr/bin/2500 || echo '2500: FAILED'
	cd $CMD/2500; strip $ROOT/usr/bin/2500 || echo '2500: install FAILED'


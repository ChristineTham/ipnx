# The disk mkimage builds is an RA73 (rq1, v10-launch.sh:26) and its /usr is
# partition 5: mkimage:22 is `mkbitfs /dev/ra15 392528', which mkbitfs.c:45
# documents as 4k blocks -- 392528*8 = 3140224, and ra.c:47 puts partition 5
# at block 780264, leaving 3140226 of RA73_LBN's 3920490.  Booted as unit 0
# that partition is ra05.  This file is only ever written to a disk that has
# no fstab yet (installed is `test -f "$1"'), so it describes that disk.
#
# /proc is the fourth line, and it carries a NUMERIC type: libc/gen/fstab.c:29
# takes field 3 as fs_ftype when it starts with a digit, and fmount(2) lists
# type 2 as "Process file system, proc(4)".  /etc/shutdown needs it -- it does
# `cd /proc' and kills what it finds.  The spec is /dev/null because fmount(2)
# says of type 2 "Fildes is ignored", while mount.c:9 still opens the spec
# before calling it, so the field needs a readable path and means nothing.
# The file cannot say any of this itself: getfsent has no comment syntax and
# would read a # line as a fifth entry.
$ETC/fstab: dirs $GEN/etc/fstab
	cp $GEN/etc/fstab $ETC/fstab

$ETC/motd: $PREP $GEN/etc/motd
	cp $GEN/etc/motd $ETC/motd

# CRON WAS INSTALLED WITH NO TABLE, AND SAID NOTHING ABOUT IT.  cron.c:28 is
# `char crontab[] = "/etc/crontab";' and :6 says "place crontab in
# /etc/crontab", but nothing here installed one -- so every disk this project
# has built runs a cron that forks, then spins at one wake-up a minute forever:
# :61-62 is `if (stat(crontab, &cstat) == -1) continue;', which is a silent
# nothing rather than a complaint.
#
# THE TABLE IS V8's, MINUS FOUR LINES.  v8/etc/crontab has six entries and the
# format is identical -- v8's cron.c:26 and v10's :28 are the same path, and
# both parse a username field before the command (:218 / :258, then getpwnam),
# so it is the same program and the file transfers as it stands.  Dropped: the
# three uudemon lines, because /usr/lib/uucp exists only if the uucp package
# built, and the hourly `date' to /dev/console, which on this machine would
# print into the operator console window once an hour for no reason.
#
# Kept because both halves are real here: $ETC/dmesg is in ETCF and built at
# :810, /usr/adm is made by the dirs run, and atrun is installed to
# /usr/lib/atrun by the at rule at :2607 -- without this line `at' accepts a
# job and never runs it, which is the same silent nothing as cron itself had.
$ETC/crontab: $PREP $GEN/etc/crontab
	cp $GEN/etc/crontab $ETC/crontab

$ETC/passwd: $PREP $GEN/etc/passwd
	cp $GEN/etc/passwd $ETC/passwd

$ETC/services: $PREP $GEN/etc/services
	cp $GEN/etc/services $ETC/services

$ETC/hosts: $PREP $GEN/etc/hosts
	cp $GEN/etc/hosts $ETC/hosts

$ETC/networks: $PREP $GEN/etc/networks
	cp $GEN/etc/networks $ETC/networks

$ETC/rc: dirs $GEN/etc/rc
	cp $GEN/etc/rc $ETC/rc

# nafsmnt is not on any tape and not in any Admin list; /etc/rc calls it as
# /etc/nafsmnt, so that is where it goes.  -lin for tcp_sock, tcp_connect and
# in_address; -lipc because errstr, which tcp_lib.c declares extern, is defined
# in libipc/ipcopen.c:8.
$CMD/nafsmnt: $PREP $CMD/nafsmnt.c $ROOT/usr/lib/libin.a $ROOT/usr/lib/libipc.a
	cd $CMD; cc -O   -o nafsmnt nafsmnt.c -lin -lipc || echo 'nafsmnt: FAILED'

$ETC/nafsmnt: $CMD/nafsmnt
	cd $CMD; cp nafsmnt $ETC/nafsmnt || echo 'nafsmnt: FAILED'
	cd $CMD; strip $ETC/nafsmnt || echo 'nafsmnt: install FAILED'

# The one file this project adds to root.
$ETC/mkimage: $PREP
	cp $GEN/mkimage $ETC/mkimage

$CMD/512restor: $PREP $CMD/512restor.c
	cd $CMD; cc -O   -o 512restor 512restor.c || echo '512restor: FAILED'

$ETC/512restor: $CMD/512restor

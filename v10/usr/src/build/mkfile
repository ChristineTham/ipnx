# ---- verify -----------------------------------------------------------------
# Every installed file, read from the same lists the build uses, so the two
# cannot drift apart.  Silence means everything is where it should be.
#
#	mk verify              checks this machine
#	mk ROOT=/v10 verify    checks the disk being built
# Reinstall the configuration THIS PROJECT OWNS, whatever is already there.
#
# The $ETCF rules cannot do this and must not: their P predicate is ./installed,
# which exits 0 for any existing target, deliberately -- everything else in /etc
# and /bin came off the tape and a time comparison would rebuild the lot.  The
# cost is that editing one of our own config files here could not reach a disk
# that already carried the old copy, and three rounds of "still not working"
# were exactly that: a corrected ttys and rc sitting in /usr/src/build while
# /etc kept the originals.
#
# mtab and utmp are left out: they are runtime state that rc and init rewrite,
# not configuration.  Works against either root -- `mk ROOT=/v10 config'.
# /etc/mkimage is here too: it is not under $GEN/etc, so the loop misses it,
# and its own rule carries ./installed, which never replaces an existing one.
#
# Both targets end in sync.  mk does not, and machdep.c:439-446's boot() calls
# death() without syncing either, so a disk written here and then left by ^E
# keeps the old file and the run reads as though the copy never happened.
config:V:
	for f in down fstab group hosts mklost+found motd networks passwd rc services shutdown ttys whoami
	do
		cp $GEN/etc/$f $ETC/$f
	done
	chmod +x $ETC/down $ETC/mklost+found $ETC/rc $ETC/shutdown
	cp $GEN/mkimage $ETC/mkimage
	cp $GEN/etc/profile $ROOT/.profile
	chmod 644 $ROOT/.profile
	sync

verify:V:
	for f in $TOOLS $LIB $LIBS $USRBIN $BIN $ETCF $ROOT/unix $ROOT/.profile $ULIB $CMDS $PKG
	do
		test -f $f || echo "MISSING  $f"
	done
	for d in $ROOT/bin $ROOT/etc $ROOT/lib $ROOT/n $ROOT/n/home $ROOT/n/macos $ROOT/proc $ROOT/tmp $ROOT/usr/adm $ROOT/usr/bin $ROOT/usr/lib $ROOT/usr/tmp
	do
		test -d $d || echo "MISSING DIR  $d"
	done

# ---- second products --------------------------------------------------------
# Each of these is installed by a rule whose other product is the one the P
# attribute keys on, so on a root that already has that one the whole recipe is
# skipped and these never appear.  They get targets of their own.
P_LIBC_mcrt0_o:V:	$SRCOK
	cd $LIBC; mk mcrt0.o || echo 'mcrt0.o: FAILED'

$LIBC/mcrt0.o: P_LIBC_mcrt0_o
	test -f $LIBC/mcrt0.o || echo '$LIBC/mcrt0.o: the package did not produce it'

$ROOT/lib/mcrt0.o: $LIBC/mcrt0.o
	cd $LIBC; cp mcrt0.o $ROOT/lib/mcrt0.o || :

# libln.a is libl.a's, installed by the rule above from the same five objects.
P_SRC_libl_libl_a:V:	$PREP
	cd $SRC/libl; mk libl.a || echo 'libln.a: FAILED'

$SRC/libl/libl.a: P_SRC_libl_libl_a
	test -f $SRC/libl/libl.a || echo '$SRC/libl/libl.a: the package did not produce it'

$ROOT/usr/lib/libln.a: $SRC/libl/libl.a
	cd $SRC/libl; cp libl.a $ROOT/usr/lib/libln.a && ranlib $ROOT/usr/lib/libln.a || echo 'libln.a: FAILED'

# diff's mkfile builds and installs diff and diffh together; DIFF and DIFFH name
# where each goes, and diffh's own place is /usr/lib (diff/mkfile:2).
$ROOT/usr/lib/diffh: $PREP
	cd $CMD/diff; mk install DIFF=$DEST/diff DIFFH=$ROOT/usr/lib/diffh || echo 'diffh: FAILED'

# mk(1)'s NAME line is `mk, mkconv, membername'; both are sh scripts in mk's
# export directory.
$ROOT/usr/bin/membername: $SRCOK
	cp $CMD/mk/export/membername $ROOT/usr/bin/membername && chmod +x $ROOT/usr/bin/membername

$ROOT/usr/bin/mkconv: $SRCOK
	cp $CMD/mk/export/mkconv $ROOT/usr/bin/mkconv && chmod +x $ROOT/usr/bin/mkconv

# stab is strip's other binary; no Admin list names it, so dest gives /usr/bin.
$ROOT/usr/bin/stab: $CMD/strip/stab
	cd $CMD/strip; cp stab $ROOT/usr/bin/stab || echo 'stab: FAILED'
	cd $CMD/strip; strip $ROOT/usr/bin/stab || echo 'stab: install FAILED'

# bprint is lcc/etc's other target, and has its own bprint.1.  Built CC=lcc
# because it is ANSI C: profio.c:38-40 is `#ifdef BPRINT' then
#     #define dclproto(func,args) func args
# -- the prototype form -- and bprint.c defines BPRINT before including it, then
# declares `int main(int argc, char *argv[])' and a function pointer with a
# prototyped type.  It also wants <stdlib.h>, which v10's /usr/include has not
# got and /usr/include/lcc has; lcc passes -I/usr/include/lcc itself.
# install.tex says the same of gen3's gen.c.
#
# Not stripped here: etc/makefile:2 is LDFLAGS=-s and line 9 is
# `$(CC) -o bprint $(LDFLAGS) bprint.c', so lcc has already passed -s to ld.
# strip would print "bprint already stripped" and do nothing.
P_LCC_etc_bprint:V:	$PREP $ROOT/usr/bin/lcc
	cd $LCC/etc; mk bprint CC=lcc || echo 'bprint: FAILED'

$LCC/etc/bprint: P_LCC_etc_bprint
	test -f $LCC/etc/bprint || echo '$LCC/etc/bprint: the package did not produce it'

$ROOT/usr/bin/bprint: $LCC/etc/bprint
	cd $LCC/etc; cp bprint $ROOT/usr/bin/bprint || echo 'bprint: FAILED'

# ---- the kernel -------------------------------------------------------------
# BUILT THE TAPE'S OWN WAY.  lsys/lib/mk.star is the recipe and lsys/mkall is
# the loop over the directories that fill lib/; nothing below invents a step.
# mk.star's four rules, in the order they fire for `ipnx-v10.u':
#
#	%.c.c: $MKDEP %.m	mkconf -t tab -l low.star -d devs -s $stem.s.s
#				-c $stem.c.c conf.star $stem.m
#	%.s.s:N: %.c.c		mkconf wrote both; N updates the time
#	%.l.o: $LOW %.s.s	as -o $target ml/param.s ml/logen.s $stem.s.s
#	%.u: %.l.o %.c.o $LIBS	ld -n -X -o $target -T 80000000 -e start ...
#
# and $LIBS is `$LD/asstar.o $LD/fs.a $LD/io.a $LD/star.a $LD/bvax.a $LD/os.a
# $LD/vm.a $LD/inet.a', which is what $KERN lists.  %.c.o has no recipe of its
# own and takes mk's builtin `%.o: %.c -> $CC $CFLAGS -c $stem.c' (mk.1:386-389)
# with CFLAGS=-DKERNEL -I.. from mk.star:5.
#
# STAR IS THE 780.  DEC's codename, and the tree agrees with itself: lib/star.a
# holds ubastar, nexstar, mcrstar and cdiskstar, and boot/star/uda.s is the ROM
# this project already loads at FA00.  astro/o.mkfile puts alice -- the one 780
# in astro -- under $STARS with `mk -f ../lib/mk.star', which is where the
# recipe name comes from; our config is built the same way from its own site
# directory, /usr/sys/ipnx.
#
# EACH ARCHIVE ARRIVES HERE AS A DIRECTORY, not a file.  v10-tree.py unpacks
# every ar member as a file, which keeps every byte and destroys the order, so
# /usr/sys/lib/os.a is 23 files and an ORDER.  ./installed is `test -f "$1"' and
# a directory does not satisfy it, so the rule fires; `ar r' will not write into
# a directory, so it is removed first.  After the build each is a real archive
# and the P predicate skips it -- which is also what happens on a machine that
# has one already.
#
# WHICH IS WHY mkconf HAS A RULE AT ALL.  lib/mkconf is a prebuilt a.out on the
# tape (37932 bytes, Feb 8 1990) so this rule is normally skipped; it exists so
# that a tree without one still builds, from lsys/mkconf, which mk.star never
# does for itself.  sys/mkconf/mkconf is a SECOND prebuilt binary, six months
# newer, and is not the one mk.star runs.
$KLIB/mkconf: $PREP
	cd $SYS/mkconf; mk mkconf && cp mkconf $KLIB/mkconf || echo 'mkconf: FAILED'
	cd $SYS/mkconf; rm -f *.[oO] || :

# ml/mkfile builds one .o per cpu type and `all' builds six; only the 780's is
# wanted.  traplist.s and clockparm.s are generated from sys/trap.h and
# sys/clock.h by that mkfile's own grep-and-sed rules.
$KLIB/asstar.o: $PREP
	cd $SYS/ml; mk ../lib/asstar.o || echo 'asstar.o: FAILED'

$KLIB/os.a: $PREP
	rm -rf $KLIB/os.a || :
	cd $SYS/os; mk ../lib/os.a || echo 'os.a: FAILED'

$KLIB/vm.a: $PREP
	rm -rf $KLIB/vm.a || :
	cd $SYS/vm; mk ../lib/vm.a || echo 'vm.a: FAILED'

$KLIB/fs.a: $PREP
	rm -rf $KLIB/fs.a || :
	cd $SYS/fs; mk ../lib/fs.a || echo 'fs.a: FAILED'

# inet.a takes two members from assembler rather than C -- goo.z and vecadd.z,
# through inet/mkfile's own `%.z: %.s' -- so it is not all one rule.
$KLIB/inet.a: $PREP
	rm -rf $KLIB/inet.a || :
	cd $SYS/inet; mk ../lib/inet.a || echo 'inet.a: FAILED'

# io.a's own FILES list ends `$M(camac.x)', a member of ioicarus.a, and
# membername reduces it to camac.x like any other -- so camac lands in io.a and
# ioicarus.a is not built.  The tape's line, left as it is.
$KLIB/io.a: $PREP
	rm -rf $KLIB/io.a || :
	cd $SYS/io; mk ../lib/io.a || echo 'io.a: FAILED'

# md/ holds every machine type; `all' builds seven archives and this kernel
# links two of them -- bvax.a, the VAX-common half (machdep, mba, ubamap), and
# star.a, the 780's own.  Asked for by name so the other five are not compiled.
$KLIB/bvax.a: $PREP
	rm -rf $KLIB/bvax.a || :
	cd $SYS/md; mk ../lib/bvax.a || echo 'bvax.a: FAILED'

$KLIB/star.a: $PREP
	rm -rf $KLIB/star.a || :
	cd $SYS/md; mk ../lib/star.a || echo 'star.a: FAILED'

# THE KERNEL.  Named $ROOT/unix and not by its config, because that is where
# the boot ROM looks and what mkimage used to copy from the builder.
#
# ON A MACHINE THAT IS ALREADY RUNNING ONE, THIS IS SKIPPED, and that is the
# point: ./installed is `test -f "$1"', so `mk world' with ROOT empty finds
# /unix present and never overwrites the kernel out from under the machine
# executing the recipe.  With ROOT=/v10 the disk is new and has none, so it is
# built.
#
# ipnx-v10.m NEEDS THE PATCHED TAB.  It declares `pt 64' and lib/tab:34 leaves
# `# cdev 18 pt' commented, and readconf.c:73 makes a name absent from the tab a
# hard error -- not a warning -- so mkconf would refuse the config outright.
# ./patch adds that one line, derived from the tape's own file.
# ONE CHAIN, AND THE .u IS NOT KEPT.  v10's ld writes its output even with
# symbols undefined -- it reports them and clears the execute bits -- so an
# `|| echo' on the link and a cp on the next line installs a kernel that did
# not link, and ./installed being `test -f' then calls /v10/unix done and
# never reaches $KERN again.  That is exactly what a missing _spcdev did
# here.  mk's exit status is ld's verdict, so && carries it; and the .u is
# removed either way, because a broken one left in ipnx/ is newer than its
# prerequisites and the next run would call THAT up to date too.
# /usr/sys/ipnx, NOT astro.  mk.star binds only `LD=../lib' (lib/mk.star:1), so
# any directory one level under /usr/sys serves; astro/mkfile opens
# `# 1127 systems' and is the Computing Science Research Center's own machine
# roster, which ipnx is no part of.  toronto/ is the tape's precedent for a
# second site.  ./patch creates the directory and puts the config and the site
# mkfile in it.
#
# AND THE SITE mkfile IS WHAT IS INVOKED, not mk.star directly.  That is how
# both tape sites do it: astro/mkfile and toronto/mkfile each hold the machine
# list and dispatch it to a class recipe in ../lib, and reaching past them to
# `mk -f ../lib/mk.star' was this driver naming a detail that belongs to the
# site.  ipnx/mkfile is `STARS=ipnx-v10.u' and one recipe, so `mk ipnx-v10.u'
# there resolves the class itself -- and a second machine would be a line in
# that file rather than another rule in this one.
P_SYS_ipnx_ipnx_v10_u:V:	$PREP $KERN
	cd $SYS/ipnx; mk ipnx-v10.u || echo 'unix: FAILED'

$SYS/ipnx/ipnx-v10.u: P_SYS_ipnx_ipnx_v10_u
	test -f $SYS/ipnx/ipnx-v10.u || echo '$SYS/ipnx/ipnx-v10.u: the package did not produce it'

$ROOT/unix: $SYS/ipnx/ipnx-v10.u
	cd $SYS/ipnx; cp ipnx-v10.u $ROOT/unix || echo 'unix: FAILED'

# ============================================================================
# THE REST OF THE DISTRIBUTION
#
# Everything above is what a v10 disk needs to boot, shut down cleanly and
# rebuild itself.  Everything below is the rest of what the tapes carry: the
# libraries under /usr/src, and every entry in /usr/src/cmd that Admin/Mk
# knows how to build.
#
# ADMIN/Mk IS THE SPEC, and it is thirty lines long.  Its loop takes names on
# the command line, asks Admin/lookline whether the name is in Admin/large
# (CFLAGS=-O) or not (CFLAGS=-Od2), asks Admin/dest where it goes, and then
# dispatches on the suffix:
#
#	*.y	yacc $B.y && cc $CFLAGS -o $B y.tab.c -ly
#	*.l	lex  $B.l && cc $CFLAGS -o $B lex.yy.c -ll
#	*.c	           cc $CFLAGS -o $B $B.c
#	*.s	as -o $B.o $B.s && cc -o $B $B.o
#	*.sh	cp $B.sh $DESTDIR$D/$B
#	dir	cd $i; make clean && make && make install && make clean
#
# and install() is `strip $1 && cp $1 $2'.  Admin/dest ends `else echo
# /usr/bin', so anything in none of the four lists goes there.
#
# WHY THE RULES BELOW ARE NOT `sh Admin/Mk name'.  Admin/dest prints an
# ABSOLUTE path -- /bin, /etc, /lib, /usr/lib, /usr/bin -- and Mk's install()
# passes it to cp with no DESTDIR (only the *.sh branch has one).  Running Mk
# under ROOT=/v10 would therefore install into the BUILDER's own /bin.  The
# dispatch is reproduced here instead, one rule per target, so the destination
# is $ROOT's.
#
# A NAME THAT COLLIDES WITH AN ENTRY IN cmd/ IS BUILT UNDER A `bin' SUFFIX.
# Sixteen of the flat sources have an output name that already exists in
# /usr/src/cmd: ed and sort are DIRECTORIES, and byteyears, cpio, cron,
# dcheck, dis, dmesg, last, logtty, ls, pr, ranlib, setpart, test and wall are
# the norman tape's own prebuilt binaries.  `cc -o ls ls.c' in that directory
# either fails with `ld: ls: Is a directory' or silently overwrites a tape
# artefact, so each is compiled as lsbin, disbin and so on and copied from
# there -- which is what ed, sort and ranlib above already do.
#
# FIVE FLAT SOURCES ARE ANSI C AND ARE COMPILED WITH lcc, not cc.  checkeq.c,
# idiff.c, strings.c, tail.c and zero.c all define main with a prototype --
# `main(int argc, char **argv)' -- and ccom/common/cgram.y:377-381 has
# `name_list: NAME | name_list CM NAME', an identifier list with no types in
# it at all; line 360 is `uerror("arg list in declaration")'.  So this
# compiler cannot parse them.  idiff.c and zero.c also want <stdlib.h>, which
# only /usr/include/lcc has and which lcc reaches by passing -I itself.
#
# NOT BUILT, and each for a header the corpus does not contain anywhere:
#   charge.c    <sys/share.h> and <sys/charges.h>, the Share Scheduler's own
#               headers -- charge.1 is `.TH CHARGE 1 SHARE'.  Neither is in
#               /usr/include, in /usr/sys/sys (which has a hundred others), or
#               anywhere in either tape tree.  THE KERNEL CANNOT COMPILE
#               EITHER: lsys/os/share.C:5-8 includes sys/param.h, sys/lnode.h,
#               sys/share.h and sys/charges.h, and lsys/os/limits.C:10-12 the
#               same, so the gap is in the tapes and not in cmd/.  sys/lnode.h
#               is the third of that set and the one ./patch already
#               reconstructs, from lnode(5) and Bell Labs' object code; the
#               other two would each need the same treatment.  charge.c also
#               wants <trace.h>, which exists only as cmd/trace/trace.h and
#               which cmd/trace's install does not copy anywhere
#   dumpcatch.c <sys/dumpl.h>, and there is nothing to reconstruct it from.
#               dumpcatch.c:5 says "the dump buffers in the dumpld line
#               discipline (see /usr/sys/dev/dumpld.c)" and no file called
#               dumpld exists in v10/ or in either tape tree -- no driver, no
#               header.  It reads the kernel by nlist for _dumpld and
#               _ndumpbuf, which this kernel does not export either
#   iostat.c    <sys/ubavar.h>, <sys/mbavar.h>; it also reads ubdinit, mbdinit
#               and the dk_* counters, which no v10 config has
#   agh.c       WAS not on the machine -- norman's alone, not in secombe/cmd,
#   ofsck.c     and mkv10's thirteen named directories never carried loose
#               files, so its rule answered `0: No source file agh.c'.  agh.c
#               now rides build/mkfiles (`files the tree must have') and is
#               built again.  ofsck.c stays out: it is the parked old fsck
# and wc.s, because wc.c is the same program eight days newer -- Aug 26 1987
# against Aug 18 1987 -- and both would install /usr/bin/wc.
# ============================================================================

# ---- the libraries ---------------------------------------------------------
# Admin/ulibfiles is /usr/lib's own list; the trees that build its archives sit
# beside libc under /usr/src, not under cmd, so Admin/Mk never reaches them --
# its loop runs `cd /usr/src/cmd' first.  Each rule below is that tree's own
# build file with the install step done here, because almost every one of them
# writes to an absolute /usr/lib and would fill the BUILDER's.
#
# THE MATH LIBRARY IS A STUB, AND THAT IS THE TAPE'S OWN DOING.  libm/makefile
# opens "libm is now a dummy for those who still want to say -lm", and libc's
# mkfile:10-56 carries asin.o atan.o exp.o log.o pow.o sin.o sinh.o sqrt.o
# besjn.o and the rest: the math moved into libc.  So -lm resolves and adds
# nothing, which is the point of shipping it.
#
# NOT BUILT:
#   asm.libm  the older assembler math library.  It builds a libm.a of its own
#             from the same names and installs it to the same path, so it would
#             put the superseded copy over the stub.

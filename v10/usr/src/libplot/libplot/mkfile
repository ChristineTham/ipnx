# HAND-REWIRED for the archive dissolution: plot/ holds the two members the
# tape shipped in plot.c.a; the staging shape matches the seven siblings, and
# clean no longer deletes sources (the old form's `rm *.c' removed the
# extracted copies, which are the source directory now).
libplot.a: plot/*.c
	rm -rf xplot; mkdir xplot
	(cd xplot;cp ../plot/* .)
	(cd xplot;cc -c -O *.c)
	(cd xplot;ar rc ../libplot.a *.o)
	rm -r xplot
	ranlib libplot.a

install:	libplot.a
	cp iplot.h /usr/include
	cp pplot.h /usr/include
	cp plot.h /usr/include
	cp libplot.a /usr/lib
	ranlib /usr/lib/libplot.a

clean:
	rm -f *.[oO] libplot.a

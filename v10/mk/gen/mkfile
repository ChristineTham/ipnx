	cd $CMD/adb/vax; make adb && strip adb && cp adb $DEST/adb || echo 'adb: FAILED'

$DEST/ar:Psh $GEN/installed: $PREP
	cd $CMD; cc -Od2 -o ar ar.c && strip ar && cp ar $DEST/ar || echo 'ar: FAILED'
	cd $CMD; rm -f ar ar.o

$DEST/arff:Psh $GEN/installed: $PREP
	cd $CMD; cc -O   -o arff arff.c && strip arff && cp arff $DEST/arff || echo 'arff: FAILED'
	cd $CMD; rm -f arff arff.o

$DEST/as:Psh $GEN/installed: $PREP
	cd $CMD/as; make clean; make as || echo 'as: FAILED'
	cd $CMD/as; strip as && cp as $DEST/as; make clean


# Build a v10 userland: the toolchain, the libraries it needs, and the /bin
# commands Admin/binfiles names.
#
#   mk               /bin only, on this machine
#   mk ROOT=/v10     /v10/bin, from the running toolchain
#   mk world         the lot, in bootstrap order
#   mk ROOT=/v10 world   populate /v10 from nothing
#
# Every target is an installed file carrying mk(1)'s P attribute, which points at
# ./installed and exits 0 -- not out of date -- when the target exists.  Times
# are never compared: everything already installed came off the tape and a time
# comparison would rebuild all of it.  Prerequisites are still built, so a
# missing stage is filled in whichever target asked for it.
#
# Bootstrap order, and why:
#
# Every target that compiles anything takes $SRCOK, so ./patch has run and
# libc.a has a current __.SYMDEF before any of them starts.  Without that the
# tools stage reaches gcc and lcc with their sources unrepaired.
#
# mk(1):263 -- "Files may be made in any order that respects the preceding
# restrictions" -- so the order of a target's prerequisite list buys nothing.
# The sequence below is enforced by real dependencies, not by the order of
# world's list: lcc depends on rcc and gcc-cpp, and libc.a and libdmalloc.a
# depend on lcc.  Nothing else crosses a stage, because every recipe runs the
# builder's cc, mk and make, not the ones being installed into ROOT.
#
#   tools   mk, gcc-cpp, rcc, lcc.  libc cannot be built without lcc -- libc's
#           own mkfile compiles memmove, qsort, fgets, fputs, rdwr, scanf,
#           sprintf, vfprintf, vfscanf and malloc with it, not with cc.  lcc in
#           turn needs gcc-cpp: etc/bowell.c:5 names /usr/lib/gcc-cpp, and the
#           whole of GNU CC 1.x is in cmd/gcc, where cccp.c is that program.
#           lcc's own gen3 sets CC=lcc -A, so the compiler proper is bootstrapped
#           from gen0, which uses plain cc.
#   lib     cpp, ccom, c2, libc.a, crt0.o.  cc.c:7-12 hardcodes all five paths.
#   libs    libipc.a for track, libjobs.a for csh.
#   bin     the commands.
#
# Admin/libfiles holds one name, dknames, and nothing in the corpus is a source
# for it or a reader of it, so /lib has no Mk-built content -- everything there
# is a by-product of the toolchain build.
#
# Not built: iostat reads ubdinit, mbdinit and the dk_* counters and v10's kernel
# has none of them under any config; mail is Berkeley Mail, installed by its own
# Makefile as /usr/bin/Mail; rmail hard-links to a /bin/mail the tapes carry no
# source for; rsh hard-links to rx (ipc/bin/mkfile:78).

ROOT=
DEST=$ROOT/bin
SRC=/v10/usr/src
CMD=$SRC/cmd
CSH=$SRC/lbin/csh
JOBS=$SRC/lbin/libjobs
LCC=$CMD/lcc
LIBC=$SRC/libc
IPC=$SRC/ipc
GEN=/n/v10/mk/gen

TOOLS=$ROOT/usr/bin/mk $ROOT/usr/lib/gcc-cpp $ROOT/usr/lib/rcc $ROOT/usr/bin/lcc
LIB=$ROOT/lib/cpp $ROOT/lib/ccom $ROOT/lib/c2 $ROOT/lib/libc.a $ROOT/lib/crt0.o
LIBS=$ROOT/usr/lib/libipc.a $ROOT/usr/lib/libjobs.a $ROOT/usr/lib/libdmalloc.a
SRCOK=$CMD/.ranlib $CMD/.patched
# lcc is not usable on its own: its driver execs /usr/lib/rcc and
# /usr/lib/gcc-cpp.  Depending on the driver alone is not enough -- it is
# already installed, so its P predicate reports it up to date and the two
# programs it needs are never reached.
LCCOK=$ROOT/usr/bin/lcc $ROOT/usr/lib/rcc $ROOT/usr/lib/gcc-cpp
PREP=$ROOT/usr/bin/strip $SRCOK
all:V:  world
world:V: tools lib libs bin
tools:V: $TOOLS
lib:V:  $LIB
libs:V: $LIBS
bin:V:  $DEST/adb $DEST/ar $DEST/arff $DEST/as $DEST/cat $DEST/cc $DEST/chmod $DEST/cmp $DEST/cp $DEST/csh $DEST/date $DEST/dd $DEST/df $DEST/diff $DEST/du $DEST/e $DEST/echo $DEST/ed $DEST/false $DEST/grep $DEST/kill $DEST/ld $DEST/ln $DEST/login $DEST/ls $DEST/make $DEST/mkdir $DEST/mt $DEST/mv $DEST/newgrp $DEST/nice $DEST/nm $DEST/nohup $DEST/od $DEST/passwd $DEST/pr $DEST/ps $DEST/pstat $DEST/pwd $DEST/rm $DEST/rmdir $DEST/sh $DEST/size $DEST/stty $DEST/sync $DEST/tar $DEST/test $DEST/time $DEST/track $DEST/true $DEST/vmstat $DEST/who $DEST/write

# ---- stamps ----------------------------------------------------------------
# A copied .a has a stale __.SYMDEF and v10's ld then makes one sequential pass,
# reporting undefined symbols that are all present.
$CMD/.ranlib:
	ranlib /lib/libc.a
	echo done > $CMD/.ranlib

# Source repairs, run once.  They are nothing's prerequisite, so re-patching
# never forces a rebuild.  mkimage re-extracts the tapes over /v10/usr/src and
# takes the stamps with the repairs, which is right: both must happen again.
$CMD/.patched:
	sh $GEN/patch
	echo done > $CMD/.patched

# ---- tools -----------------------------------------------------------------
# mk's own src/mkfile needs mk, so the modules from its NAMES are compiled
# directly with CFLAGS=-DV9 as that mkfile sets, linked as nmk, and installed
# where its install target puts it.  membername goes with it: mk(1) documents
# the two together and libc's mkfile:84 calls it to turn libc.a(read.o) into
# read.o.  mkconv goes too: mk(1)'s NAME line is `mk, mkconv, membername'.
# Both are sh scripts in mk's export directory.
$ROOT/usr/bin/mk:Psh $GEN/installed: $SRCOK
	cd $CMD/mk/src; cc -DV9 -o nmk alloc.c arc.c bquote.c builtins.c dir.c expand.c gen.c glob.c graph.c job.c lex.c main.c makefile.c match.c mk.c parse.c quote.c recipe.c regexp.c rule.c run.c shprint.c sig.c symtab.c t_ar.c t_driver.c t_file.c var.c word.c || echo 'mk: FAILED'
	cd $CMD/mk/src; cp nmk $ROOT/usr/bin/mk && strip $ROOT/usr/bin/mk; rm -f nmk *.o
	cp $CMD/mk/export/membername $ROOT/usr/bin/membername && chmod +x $ROOT/usr/bin/membername
	cp $CMD/mk/export/mkconv $ROOT/usr/bin/mkconv && chmod +x $ROOT/usr/bin/mkconv

# cmd/gcc is GNU CC 1.x entire, but only its preprocessor is wanted: lcc's
# driver execs /usr/lib/gcc-cpp and /usr/lib/rcc and nothing else from gcc, and
# gcc-cpp is cccp under a second name --
#     cpp: cccp
#     	ln cccp cpp
#     cccp: cccp.o cexp.o version.o $CLIB
# So the cpp target is built rather than all or install.  That also steps around
# the two files v10src damaged: jump.c, whose block 3 duplicates block 2, and
# local-alloc.c, whose block 0 is Makefile text plus 1405 NUL bytes and whose
# block 6 is a foreign block (the same one that overwrote limits.h entirely).
# All three are reachable only through cc1, which nothing here uses.  cccp.c,
# cexp.y, cexp.c, version.c and alloca.c are structurally clean -- no NULs, no
# duplicate blocks, no stray comment terminators, balanced #if -- and none of
# them includes limits.h.
#
# CC=cc because mkfile:25 is `CC = gcc' -- it expects to build GNU CC with GNU
# CC.  Line 26 says "OLDCC should not be the GNU C compiler" and line 27 sets
# OLDCC = cc, so cc is what the bootstrap is meant to use.  The install target
# is not used either, so its `strip -g target' bug does not arise.
$ROOT/usr/lib/gcc-cpp:Psh $GEN/installed: $SRCOK
	cd $CMD/gcc; mk cpp CC=cc || echo 'gcc-cpp: FAILED'
	cd $CMD/gcc; cp cpp $ROOT/usr/lib/gcc-cpp && chmod 775 $ROOT/usr/lib/gcc-cpp && strip $ROOT/usr/lib/gcc-cpp

# gen2, not gen0.  lcc's doc/install.tex:42-43 names gen0 the ``symbolic'' code
# generator and gen3 the demonstration one; :387, "Installing a Production
# Compiler", is gen2, whose gen2/vax is the VAX generator.  gen0's rcc emits a
# symbolic dump -- progbeg, segment, function, node -- which /bin/as rejects
# character by character.
#
# HOST and HOSTOS, because gen2/makefile:5 is D=$(HOST)-$(HOSTOS); the tape
# ships a gen2/vax-v9 directory, and install.tex:435 lists vax/v9 among the
# supported target-system pairs.
$ROOT/usr/lib/rcc:Psh $GEN/installed: $SRCOK
	cd $LCC/gen2; make HOST=vax HOSTOS=v9 || echo 'rcc: FAILED'
	cd $LCC/gen2; cp vax-v9/rcc $ROOT/usr/lib/rcc && strip $ROOT/usr/lib/rcc

# The driver is one host file plus lcc.c, linked to a.out.  HOST=coma, not
# guessed: the lcc already on the image reports
#     /usr/lib/gcc-cpp -undef -Dvax -DV9 ... -I/usr/include/libc -I/usr/include/lcc
#     | /usr/lib/rcc -v -
# under -v, and rcc is invoked with no -g1.  bowell.c:7 adds -g1 and coma.c:7
# does not, so the installed driver was built from coma; every other path in the
# trace matches both.
$ROOT/usr/bin/lcc:Psh $GEN/installed: $SRCOK $ROOT/usr/lib/rcc $ROOT/usr/lib/gcc-cpp
	cd $LCC/etc; make a.out HOST=coma || echo 'lcc: FAILED'
	cd $LCC/etc; cp a.out $ROOT/usr/bin/lcc && strip $ROOT/usr/bin/lcc; rm -f a.out
	cd $LCC/etc; make bprint && strip bprint && cp bprint $ROOT/usr/bin/bprint || echo 'bprint: FAILED'

# ---- lib -------------------------------------------------------------------
# cmd/cpp's mkfile runs yacc over cpy.y, then :yyfix and :rofix.
$ROOT/lib/cpp:Psh $GEN/installed: $SRCOK
	cd $CMD/cpp; mk cpp && cp cpp $ROOT/lib/cpp && strip $ROOT/lib/cpp || echo 'cpp: FAILED'

# ccom's makefile calls its binary comp and its build target build.  Its install
# target is not used: it begins `cp /lib/ccom comp.sv', which cannot work when
# there is no /lib/ccom yet, and it hardcodes /lib.
$ROOT/lib/ccom:Psh $GEN/installed: $SRCOK
	cd $CMD/ccom/vax; make build || echo 'ccom: FAILED'
	cd $CMD/ccom/vax; cp comp $ROOT/lib/ccom && strip $ROOT/lib/ccom

$ROOT/lib/c2:Psh $GEN/installed: $SRCOK
	cd $CMD/c2; make c2 && make install DESTDIR=$ROOT || echo 'c2: FAILED'

# libc's own install target starts `cp $target liboc.a', saving the libc.a it is
# about to replace, which cannot work when there is none; the archive is built
# with its mkfile and installed here.  ranlib at the destination, because cp
# updates the mtime and that alone makes __.SYMDEF stale.
$ROOT/lib/libc.a:Psh $GEN/installed: $SRCOK $LCCOK
	cd $LIBC; mk libc.a || echo 'libc.a: FAILED'
	cd $LIBC; cp libc.a $ROOT/lib/libc.a && ranlib $ROOT/lib/libc.a

$ROOT/lib/crt0.o:Psh $GEN/installed: $SRCOK
	cd $LIBC; mk crt0.o mcrt0.o || echo 'crt0.o: FAILED'
	cd $LIBC; cp crt0.o mcrt0.o $ROOT/lib

# ---- libraries the commands need -------------------------------------------
# track links -lipc; ld searches /lib, /usr/lib and /usr/local/lib and has no -L.
$ROOT/usr/lib/libipc.a:Psh $GEN/installed: $SRCOK
	cd $IPC/libipc; mk libipc.a || echo 'libipc.a: FAILED'
	cd $IPC/libipc; cp libipc.a $ROOT/usr/lib/libipc.a && ranlib $ROOT/usr/lib/libipc.a

# csh links ../libjobs/libjobs.a by path, so it is built and ranlibbed where it
# stands; its makefile's libjobs.a target is a bare `ar cr' and only its install
# target ranlibs.
$JOBS/libjobs.a: $SRCOK
	cd $JOBS; make libjobs.a && ranlib libjobs.a || echo 'libjobs.a: FAILED'

# ... and installed as well, which its own install target does:
#     cp libjobs.a $(DESTDIR)/usr/lib
#     ranlib $(DESTDIR)/usr/lib/libjobs.a
$ROOT/usr/lib/libjobs.a:Psh $GEN/installed: $SRCOK $JOBS/libjobs.a
	cp $JOBS/libjobs.a $ROOT/usr/lib/libjobs.a && ranlib $ROOT/usr/lib/libjobs.a || echo 'libjobs.a install: FAILED'

# libc's install target names libdmalloc.a alongside libc.a, crt0.o and mcrt0.o.
# Its own rule compiles gen/malloc.c with lcc, not cc.
$ROOT/usr/lib/libdmalloc.a:Psh $GEN/installed: $SRCOK $LCCOK
	cd $LIBC; mk libdmalloc.a || echo 'libdmalloc.a: FAILED'
	cd $LIBC; cp libdmalloc.a $ROOT/usr/lib/libdmalloc.a && ranlib $ROOT/usr/lib/libdmalloc.a

# ---- strip -----------------------------------------------------------------
# strip is in no Admin list, so dest puts it in /usr/bin and its own Makefile's
# install target agrees.  Every install below calls it.  That install runs
# `strip strip.out' through PATH, which cannot work before strip exists, so the
# fresh binary is invoked as ./strip -- on a scratch copy, since strip.out is the
# tape's own prebuilt binary and make clean does not remove it.
$ROOT/usr/bin/strip:Psh $GEN/installed: $SRCOK
	cd $CMD/strip; make clean; make strip && cp strip strip.new && ./strip strip.new && cp strip.new $ROOT/usr/bin/strip || echo 'strip: FAILED'
	cd $CMD/strip; make stab && strip stab && cp stab $ROOT/usr/bin/stab || echo 'stab: FAILED'
	cd $CMD/strip; rm -f strip.new; make clean

# ---- commands --------------------------------------------------------------


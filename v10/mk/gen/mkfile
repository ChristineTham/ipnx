# There are two track.c.  dk/cmd/track.c (1984) calls tdkexec and is linked -ldk
# into /usr/bin by dk/cmd/Makefile; cmd/track.c (1987) was ported off Datakit and
# calls ipcexec, which is libipc's -- libdk.a holds tdkexec, not ipcexec.
# binfiles routes the cmd/ copy to /bin, so this is the 1987 one.
#
# -O is a DEVIATION.  track.c is not in Admin/large, so the tape's rule is Mk's
# default -Od2, and that cannot link it: as -d[124] sets the displacement size
# (asmain.c:241) and cc.c:262 hands dflag straight to as, so -Od2 means word
# displacements, which track.o overflows against libipc.
$DEST/track:Psh $GEN/installed: $PREP $ROOT/usr/lib/libipc.a

# Build the V10 image on ra10 (root) and ra15 (/usr), mounted at /v10.
# Silent on success; only errors are printed.
#
# ONE TAPE OWNS EACH TOP-LEVEL FOLDER.  No tape is extracted over another:
# mixing two tapes inside one directory would put binaries from both in the
# same tree.  secombe goes first and keeps everything it carries; the others
# only add folders it does not have.
#
#	secombe   -> /usr/src   everything it has; sys then moved to /usr/sys
#	sellers   -> /usr       man vol2
#	milligan  -> /usr       jerq
#	v10blit   -> /usr/blit  the whole tape
#	v10src    -> /usr       630 maps
#	          -> /usr/src   doc
#
# NOT TAKEN from v10src: dist dregs facedl history lsys nbstests, and the
# loose files makefile and srctotape.  lsys is a machine's LOCAL sys;
# history holds IX, a different operating system.
#
# EACH TAPE IS COPIED TO /usr FIRST, and that is not caution -- tar cannot
# read an archive off a netafs mount at all.  tar.c:990 issues an MTIOCTOP
# and tolerates exactly one errno, ENOTTY: "not a tape, carry on".  netafs
# answers ENODEV, because neta.c:35 passes `nodev' as its t_ioctl (the 9th
# argument of fsinit, conf.h:60) and subr.c:199 sets ENODEV.  The regular
# filesystem answers ENOTTY (fs.c:535).  So tar takes its fatal branch,
# prints "tape backspace error" and exits 4 -- after extracting everything,
# which makes it look like a late failure rather than an ioctl mismatch.
TAPE=/v10/usr/.tape
test -d /v10/usr && /etc/umount /v10/usr
test -d /v10 && /etc/umount /v10
dd if=/dev/ra00 of=/dev/ra10 bs=512 count=1 || exit 1
/etc/mkbitfs /dev/ra10 1280 || exit 1
/etc/mkbitfs /dev/ra15 392528 || exit 1
test -d /v10 || mkdir /v10 || exit 1
/etc/mount /dev/ra10 /v10 || exit 1
test -d /v10/usr || mkdir /v10/usr || exit 1
/etc/mount /dev/ra15 /v10/usr || exit 1
cp /unix /v10/unix || exit 1
sh /n/v10/mk/gen/mkdev /v10/dev || exit 1
mkdir /v10/usr/src || exit 1
mkdir /v10/usr/blit || exit 1

cp /n/tapes/secombe.tar $TAPE || exit 1
cd /v10/usr/src && tar xf $TAPE || exit 1
cp /n/tapes/sellers.tar $TAPE || exit 1
cd /v10/usr && tar xf $TAPE || exit 1
cp /n/tapes/milligan.tar $TAPE || exit 1
cd /v10/usr && tar xf $TAPE || exit 1
cp /n/tapes/v10blit.tar $TAPE || exit 1
cd /v10/usr/blit && tar xf $TAPE || exit 1
cp /n/tapes/v10src.tar $TAPE || exit 1
cd /v10/usr && tar xf $TAPE 630 maps || exit 1
cd /v10/usr/src && tar xf $TAPE doc || exit 1
# The source directories v10src has that secombe does not, read from tar tvf.
# Only directories: everything else v10src adds at this level is a file, and
# nearly all of them are compiled binaries left in the source tree -- cmd/ls
# 29816 bytes mode 775, cmd/pr, cmd/test, cmd/ranlib, cmd/cpio, cmd/dmesg and
# the rest -- or objects, archives, a core and a nohup.out.  None supersedes a
# secombe source.
#
# cmd/gcc and cmd/cp are required by the build: cccp.c under gcc is the gcc-cpp
# lcc's driver calls for, and cmd/cp is the only source for /bin/cp in the
# corpus.  The others are programs secombe simply does not carry.
#
# Left out: cmd/oasd++, cmd/omovie, cmd/osh and cmd/oworm are superseded copies;
# cmd/lost+found is a filesystem artefact; dist and nbstests hold one and three
# members and nobody has looked at them; sys/mercury, mhd, misc, phone and t are
# other sites' generated kernel configs and ours is sys/astro/ipnx-v10.m;
# history, dregs and lsys are excluded by decision; 630, maps and doc are taken
# above; man and vol2 come from sellers.
cd /v10/usr/src && tar xf $TAPE \
	cmd/bison cmd/cp cmd/cyntax cmd/flex cmd/gcc cmd/icon \
	cmd/library cmd/m4 cmd/matlab cmd/pascal cmd/post cmd/wwb \
	lbin/kermit || exit 1
rm -f $TAPE

mv /v10/usr/src/sys /v10/usr/sys || exit 1
cd /
sync

.EQ
define F /"\fHF\fP"/
define Fim /{ F sub > }/
define Fpre /{ F sup < }/
define Finv /{ F sup <- }/
define ej /{ e sub j }/
define sej /"{" ej "}"/
define fj /{ f sub j }/
define bC /{ partial C }/
define bD /{ partial D }/
define bP /{ partial P }/
define scrC /"\fHC\fP"/
define scrR /bold "I" back 20 bold "R"/
define QED /"\(bx"/
define mod /{roman "mod"}/
define LO /{ L sub O }/
define scrl /"\(Sl"/
define ejk /{ e sub j sub k }/
define sejk /SIGMA/
define evar /E/
define p1 /{ p sub 1 }/
define p2 /{ p sub 2 }/
define op2 /{ op sub 2 }/
define begin /"\f(CWbegin\fP"/
define end /"\f(CWend\fP"/

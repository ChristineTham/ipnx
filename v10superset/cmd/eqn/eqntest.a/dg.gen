cat <<\!
.nf
.sp .5i
.sy date >/tmp/foo
.so /tmp/foo
.nf
.vs 16p
.sp
!

awk '
function pad(s,	n,	i, j) {
	if (s ~ /^[a-zA-Z]$/)
		s = "\\f2" s "\\fP"
	printf("%s%s", s, shim(n))
}
function shim(n) {
	return substr("\\^\\^\\^\\^\\^\\^\\^\\^\\^\\^\\^", 1, 2*n)
}

{	for (n = 0; n <= 3; n++) {
		for (i = 1; i <= NF; i++)
			pad($i, n)
		printf("\n");
	}
	printf("\n")
}
' <<\!

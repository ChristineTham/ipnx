.PS
# When the next line is in, a 60000 X 60000 picture shrunk to 7 X 7
# problem is that size of B: [ O: 0,0 ] is zero, but it's set internally
# to -60000
# NOW FIXED

B: [ Origin: (0,0) ]
	#A: [ Origin: "" at (0,0) ] # This one works fine

A: [ Origin: 
	line from 0,0 to 1,1
] with .Origin at B
.PE
.PS

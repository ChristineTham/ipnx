#		}
#	it seems to work
#	also if use ; or else {}
# CAN'T SEE ANYTHING WRONG NOW

define nibble {	# nibble(len, "label", offset, any)
Nib:	box $2 $4
	{ if $3 >= 0 then { "\s-4 $3\s0" at Nib.w + (0,boxht/3) ljust } ; }
}
right
nibble(8, "label", 0000)
nibble(8, "word 0", -1)

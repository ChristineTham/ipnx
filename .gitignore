# macOS
.DS_Store

# Xcode / Swift
DerivedData/
build/
.build/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Rust (dmd_core builds)
target/

# Local work areas (spike outputs, emulator checkouts, scratch)
work/
libsimh/dist/
libdmd/dist/
libdmd/build-smoke
libdmd/build-idle-scope
libdmd/build-resize-scope
tools/vendor/
tools/dmdbridge/.cargo/

# Big historical artifacts — never commit; rebuild locally per docs/spike-a0.md
# The committed disks are image/*.tar.bz2 -- un-ignored below, because the
# *.tar.bz2 rule would otherwise take them.  tar because it is the only
# standard format that restores a hole: `tar -xSjf' writes the zero runs as
# holes rather than allocated blocks, so a 1.9 GB disk costs its non-zero
# bytes on disk and not 1.9 GB.  zip cannot do this and neither can xz.
*.disk
*.dsk
*.tap
*.tape
*.tar.bz2
*.tar.gz
*.tgz
*.cpio
*.iso
*.img
!image/*.tar.bz2
app/*.log
libdmd/build-*.log
libdmd/*.pgm
libdmd/*.png
__pycache__/

# THE DISTRIBUTION IS SOURCE, WHATEVER ITS SUFFIX.  v10/ is the machine's own
# /usr, and some of its files are named *.tar or *.cpio -- source packages under
# cmd/, the same shape as the .c.a archives.  The rules above exist to keep
# BUILT artefacts (disk images, tapes) out of git; they are not about the tape's
# own contents, and without this exception the tree silently loses those files.
!v10/**

# THE TAPES ARE NOT COMMITTED, AND NEITHER IS ANY TREE MADE FROM THEM.
#
# work/tapes/ holds the six archives as plain tar, written by
# tools/v10-tapes.sh -- the host half of the bootstrap, and the only part of it
# that is not on the machine.  v10/usr/src/build/mkv10 reads them and writes
# v10.tar; docs/v10-build.md is the whole procedure.
#
# v10tapes/ and v10superset/ were a host-side reconstruction: a pristine extract
# per tape, merged into a corpus, shaped into v10/.  The machine does all of
# that now, so both trees were deleted; git history still has them (751594dd
# and later).  Six tools that read them are still in tools/ awaiting deletion --
# v10-tree.py, v10-dist.py, v10-check.py, v10-read.py, v10-files.py and
# v10-plan.py -- and none of them is part of the build docs/v10-build.md
# describes.
#
# What IS committed is v10/ -- byte for byte the machine's own ipnx.tar, which
# is what `taripnx' writes and what mkimage extracts -- so a question about what
# we build from is a git grep.  A question about what a particular TAPE says is
# answered by fetching the six again and running mkv10.
v10tapes/
v10superset/

# images/ is the working set the launcher boots -- a disk and the boot ROM,
# copied there so tools/v10-launch.sh has one place to point at.  Both are
# reproducible: the ROM is v10/usr/sys/boot/star/uda byte for byte, and the
# disk is a build output.  Note this is images/, PLURAL, and is nothing to do
# with image/, which holds the two committed .xz goldens named above.
images/

# THE TAPE ARCHIVES THEMSELVES ARE NOT COMMITTED EITHER.  tapes/ is 505 MB of
# raw tar -- the six V10 archives plus V8 and batterpudding -- decompressed
# from the copies in work/, which is what tools/v10-tapes.sh actually reads.
# Committing them would put half a gigabyte of tape into every clone to say
# what v10superset/ already says, checked, in a form git can diff.
tapes/

# ipnx.tar never enters git (github is correct): v10/ holds the extracted tree.
*.tar

# macOS
.DS_Store

# Xcode / Swift
DerivedData/
build/
.build/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Rust (dmd_core builds)
target/

# Local work areas (spike outputs, emulator checkouts, scratch)
work/
libsimh/dist/
libdmd/dist/
libdmd/build-smoke
libdmd/build-idle-scope
libdmd/build-resize-scope
tools/vendor/
tools/dmdbridge/.cargo/

# Big historical artifacts — never commit; rebuild locally per docs/spike-a0.md
# Two exceptions are un-ignored below.  image/ipnx-v8-rp07.img.xz is the
# disk WE build, and the next build reads it (docs/golden-disk.md).
*.disk
*.dsk
*.tap
*.tape
*.tar.bz2
*.tar.gz
*.tgz
*.cpio
*.iso
*.img
!image/ipnx-v8-rp07.img.xz
!image/ipnx-v10-ra81.img.xz
app/*.log
libdmd/build-*.log
libdmd/*.pgm
libdmd/*.png
__pycache__/

# THE RECONSTRUCTED TREE IS SOURCE, WHATEVER ITS SUFFIX.  v10/ is the superset
# of the six tapes built by tools/v10-tree.py, and some of its files are named
# *.tar or *.cpio -- source packages under cmd/, the same shape as the .c.a
# archives.  The rules above exist to keep BUILT artefacts (disk images, tapes)
# out of git; they are not about the tape's own contents, and without this
# exception the tree silently loses those files.
!v10superset/**
!v10/**
v10superset/READ.jsonl

# THE PRISTINE EXTRACTS ARE NOT COMMITTED, and that is a deliberate trade.
# v10tapes/ is 514 MB and is reproducible byte for byte by tools/v10-tapes.sh
# from the six archives in work/, which its MANIFEST records with a hash per
# file.  What IS committed is v10/ -- the tree the build reads -- so a question
# about what we build from is a git grep, while a question about what a
# particular TAPE says is one extract away and provable against the manifest.
v10tapes/

# macOS
.DS_Store

# Xcode / Swift
DerivedData/
build/
.build/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Rust (dmd_core builds)
target/

# Local work areas (spike outputs, emulator checkouts, scratch)
work/
libsimh/dist/
libdmd/dist/
libdmd/build-smoke
libdmd/build-idle-scope
libdmd/build-resize-scope
tools/vendor/
tools/dmdbridge/.cargo/

# Big historical artifacts — never commit; rebuild locally per docs/spike-a0.md
# The committed disks are image/*.tar.bz2 -- un-ignored below, because the
# *.tar.bz2 rule would otherwise take them.  tar because it is the only
# standard format that restores a hole: `tar -xSjf' writes the zero runs as
# holes rather than allocated blocks, so a 1.9 GB disk costs its non-zero
# bytes on disk and not 1.9 GB.  zip cannot do this and neither can xz.
*.disk
*.dsk
*.tap
*.tape
*.tar.bz2
*.tar.gz
*.tgz
*.cpio
*.iso
*.img
!image/*.tar.bz2
app/*.log
libdmd/build-*.log
libdmd/*.pgm
libdmd/*.png
__pycache__/

# THE DISTRIBUTION IS SOURCE, WHATEVER ITS SUFFIX.  v10/ is the machine's own
# /usr, and some of its files are named *.tar or *.cpio -- source packages under
# cmd/, the same shape as the .c.a archives.  The rules above exist to keep
# BUILT artefacts (disk images, tapes) out of git; they are not about the tape's
# own contents, and without this exception the tree silently loses those files.
!v10/**

# THE TAPES ARE NOT COMMITTED.  v10tapes/ holds the six archives as plain tar,
# written by tools/v10-tapes.sh -- the host half of the bootstrap, and the only
# part of it that is not on the machine.  430 MB that says nothing git can
# diff, and nothing here unpacks one: v10/usr/src/build/mkv10 extracts them on
# the machine and writes v10.tar.  docs/v10-build.md is the whole procedure.
#
# What IS committed is v10/ -- byte for byte the machine's own ipnx.tar, which
# is what `taripnx' writes and what mkimage extracts -- so a question about what
# we build from is a git grep.  A question about what a particular TAPE says is
# answered by fetching the six again and running mkv10.
v10tapes/

# run/ IS THE WORKING SET AND NONE OF IT IS COMMITTED: the uncompressed disks
# tools/v10-reset.sh writes there, the boot ROM beside them, the simh configs
# the launchers generate, a throwaway copy of the golden.  Every one of them is
# reproducible -- the disks from the archives in image/, the ROM from
# v10/usr/sys/boot/star/uda byte for byte.  It was called images/ and was one
# character from image/, which holds the committed archives; that pair cost
# enough confusion to be worth renaming.
run/

# ipnx.tar never enters git (github is correct): v10/ holds the extracted tree.
*.tar

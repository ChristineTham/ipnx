# macOS
.DS_Store

# Xcode / Swift
DerivedData/
build/
.build/
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Rust (dmd_core builds)
target/

# Local work areas (spike outputs, emulator checkouts, scratch)
work/
libsimh/dist/
libdmd/dist/
libdmd/build-smoke
libdmd/build-idle-scope
libdmd/build-resize-scope
tools/vendor/
tools/dmdbridge/.cargo/

# Big historical artifacts — never commit; rebuild locally per docs/spike-a0.md
# Two exceptions are un-ignored below.  image/ipnx-v8-rp07.img.xz is the
# disk WE build, and the next build reads it (docs/golden-disk.md).
*.disk
*.dsk
*.tap
*.tape
*.tar.bz2
*.tar.gz
*.tgz
*.cpio
*.iso
*.img
!image/ipnx-v8-rp07.img.xz
!image/ipnx-v10-ra81.img.xz
app/*.log
libdmd/build-*.log
libdmd/*.pgm
libdmd/*.png
__pycache__/

# THE EXTRACTED TAPE IS SOURCE, WHATEVER ITS SUFFIX.  v10/source holds the
# six V10 archives unpacked file by file, and nine of those files are named
# *.tar or *.cpio -- source packages under cmd/, the same shape as the .c.a
# archives.  The rules above exist to keep BUILT artefacts (disk images,
# tapes) out of git; they are not about the tape's own contents, and without
# this exception the extract silently loses nine files.
!v10/source/**
v10/READ.jsonl
